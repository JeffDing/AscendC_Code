// Generic single-case timing harness. Usage: bench_case <case_index>
// Measures best_us over 8 repeats for one test case (like perf_main but single-case,
// so thermal/cache state is not polluted by the other 14 cases).
#include <acl/acl.h>
#include <cstdint>
#include <cstdio>
#include <fstream>
#include <string>
#include <vector>

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif

#include "kernel.asc"

namespace {
struct Case { int b, m, n, k; bool tx1, tx2; int dtype; };
const Case kCases[] = {
    {1, 1, 1, 32, false, false, 1},
    {1, 3, 5, 40, true, false, 2},
    {2, 7, 13, 48, false, true, 1},
    {4, 8, 16, 128, true, true, 2},
    {8, 16, 32, 128, false, false, 1},
    {13, 23, 73, 192, false, true, 2},
    {16, 32, 128, 256, true, false, 1},
    {1, 1025, 1031, 1032, true, true, 2},
    {1, 2048, 1536, 1280, false, true, 1},
    {1, 4096, 1280, 1152, false, false, 2},
    {1, 1536, 2048, 2048, true, true, 1},
    {1, 1280, 4096, 1536, true, false, 2},
    {1, 8192, 64, 128, false, false, 1},
    {1, 64, 8192, 128, false, true, 2},
    {1, 64, 64, 8192, true, true, 1},
};

bool Load(const std::string& path, std::vector<uint8_t>& data)
{
    std::ifstream file(path, std::ios::binary);
    if (!file) return false;
    file.read(reinterpret_cast<char*>(data.data()), static_cast<std::streamsize>(data.size()));
    return file.gcount() == static_cast<std::streamsize>(data.size());
}
}

int main(int argc, char** argv)
{
    int index = argc > 1 ? std::atoi(argv[1]) : 9;
    if (index < 1 || index > 15) { std::printf("bad case\n"); return 1; }
    const Case& c = kCases[index - 1];
    if (aclInit(nullptr) != ACL_SUCCESS || aclrtSetDevice(0) != ACL_SUCCESS) return 1;
    int64_t cores = 0;
    if (aclrtGetDeviceInfo(0, ACL_DEV_ATTR_CUBE_CORE_NUM, &cores) != ACL_SUCCESS || cores <= 0) return 1;
    aclrtStream stream = nullptr;
    if (aclrtCreateStream(&stream) != ACL_SUCCESS) return 1;

    const uint64_t x1Bytes = (uint64_t)c.b * c.m * c.k * 2;
    const uint64_t x2Bytes = (uint64_t)c.b * c.n * c.k * 2;
    const uint64_t yBytes = 16384;  // engines write bookkeeping slots past y[0]
    std::vector<uint8_t> x1Host(x1Bytes), x2Host(x2Bytes);
    std::string prefix = "input/case" + std::to_string(index) + "/";
    if (!Load(prefix + "x1.bin", x1Host) || !Load(prefix + "x2.bin", x2Host)) {
        std::printf("INPUT_MISSING\n"); return 1;
    }
    uint8_t *x1 = nullptr, *x2 = nullptr, *y = nullptr;
    aclrtMalloc((void**)&x1, x1Bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&x2, x2Bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&y, yBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(x1, x1Bytes, x1Host.data(), x1Bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(x2, x2Bytes, x2Host.data(), x2Bytes, ACL_MEMCPY_HOST_TO_DEVICE);

    int64_t s1[3] = {c.b, c.tx1 ? c.k : c.m, c.tx1 ? c.m : c.k};
    int64_t s2[3] = {c.b, c.tx2 ? c.n : c.k, c.tx2 ? c.k : c.n};
    int64_t sy[1] = {c.b};
    TensorInfo t1[1] = {{s1, 3, c.dtype}};
    TensorInfo t2[1] = {{s2, 3, c.dtype}};
    TensorInfo ty[1] = {{sy, 1, 0}};
    TensorGroupInfo g1 = {t1, 1}, g2 = {t2, 1}, gy = {ty, 1};

    for (int i = 0; i < 3; ++i) {
        run_kernel((GM_ADDR)x1, g1, (GM_ADDR)x2, g2, (GM_ADDR)y, gy, cores, stream, c.tx1, c.tx2);
        aclrtSynchronizeStreamWithTimeout(stream, 120000);
    }
    aclrtEvent start = nullptr, stop = nullptr;
    aclrtCreateEvent(&start); aclrtCreateEvent(&stop);
    constexpr int repeats = 10;
    float elapsed[repeats] = {};
    for (int i = 0; i < repeats; ++i) {
        aclrtRecordEvent(start, stream);
        run_kernel((GM_ADDR)x1, g1, (GM_ADDR)x2, g2, (GM_ADDR)y, gy, cores, stream, c.tx1, c.tx2);
        aclrtRecordEvent(stop, stream);
        aclrtSynchronizeEvent(stop);
        aclrtEventElapsedTime(&elapsed[i], start, stop);
    }
    float best = elapsed[0];
    for (float v : elapsed) best = v < best ? v : best;
    std::printf("case%d best_us=%.3f", index, best * 1000.0F);
    for (float v : elapsed) std::printf(" %.3f", v * 1000.0F);
    std::printf("\n");
    aclrtDestroyEvent(start); aclrtDestroyEvent(stop);
    aclrtFree(x1); aclrtFree(x2); aclrtFree(y);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
