// Local multi-case test driver — run any of the 15 cases by id:
//   ./bmm_multi <caseId>
// Reads ./input/x1.bin, ./input/x2.bin (copy input/case<N>/* into input/ first),
// writes ./output/y.bin.  Never shipped to the OJ harness.

#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <cmath>
#include <chrono>
#include "acl/acl.h"

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
// Dtype enum for TensorInfo.dtype:
// 0=float32 1=float16 2=bfloat16 3=int8 4=int16 5=int32 6=int64
// 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif

#include <vector>
#include "data_utils.h"

#define ACL_CHECK(expr) do { aclError _ret = (expr); if (_ret != 0) { fprintf(stderr, "[ERROR] %s failed at %s:%d, ret=%d\n", #expr, __FILE__, __LINE__, _ret); return 1; } } while(0)
#define FILE_CHECK(expr) do { if (!(expr)) { fprintf(stderr, "[ERROR] File I/O failed at %s:%d\n", __FILE__, __LINE__); return 1; } } while(0)

#include "kernel.asc"

struct CaseDef {
    int64_t b, m, n, k;
    int32_t dtype;      // 1 = fp16, 2 = bf16
    bool tx1, tx2;
};

static const CaseDef kCases[] = {
    {0, 0, 0, 0, 0, false, false}, // unused
    {1, 1, 1, 32, 1, false, false},
    {1, 3, 5, 40, 2, true , false},
    {2, 7, 13, 48, 1, false, true },
    {4, 8, 16, 128, 2, true , true },
    {8, 16, 32, 128, 1, false, false},
    {13, 23, 73, 192, 2, false, true },
    {16, 32, 128, 256, 1, true , false},
    {1, 1025, 1031, 1032, 2, true , true },
    {1, 2048, 1536, 1280, 1, false, true },
    {1, 4096, 1280, 1152, 2, false, false},
    {1, 1536, 2048, 2048, 1, true , true },
    {1, 1280, 4096, 1536, 2, true , false},
    {1, 8192, 64, 128, 1, false, false},
    {1, 64, 8192, 128, 2, false, true },
    {1, 64, 64, 8192, 1, true , true },
};

int main(int argc, char** argv)
{
    if (argc < 2) {
        fprintf(stderr, "usage: %s <caseId 1..15>\n", argv[0]);
        return 2;
    }
    const int caseId = atoi(argv[1]);
    if (caseId < 1 || caseId > 15) {
        fprintf(stderr, "caseId out of range: %d\n", caseId);
        return 2;
    }
    const CaseDef& c = kCases[caseId];

    int32_t deviceId = 0;
    int64_t availableCoreNum = 0;
    aclrtStream stream = nullptr;

    ACL_CHECK(aclInit(nullptr));
    ACL_CHECK(aclrtSetDevice(deviceId));
    ACL_CHECK(aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_CUBE_CORE_NUM, &availableCoreNum));
    if (availableCoreNum <= 0) {
        return 1;
    }
    ACL_CHECK(aclrtCreateStream(&stream));

    // Physical layouts: tx1 -> x1 (B,K,M); tx2 -> x2 (B,N,K); else ND.
    const int64_t x1Rows = c.tx1 ? c.k : c.m;
    const int64_t x1Cols = c.tx1 ? c.m : c.k;
    const int64_t x2Rows = c.tx2 ? c.n : c.k;
    const int64_t x2Cols = c.tx2 ? c.k : c.n;
    const int64_t x1Elems = c.b * x1Rows * x1Cols;
    const int64_t x2Elems = c.b * x2Rows * x2Cols;
    const int64_t elemBytes = 2;

    int64_t x1_shape[] = {c.b, x1Rows, x1Cols};
    TensorInfo x1_tensors[] = {{x1_shape, 3, c.dtype}};
    TensorGroupInfo info_x1 = {x1_tensors, 1};
    int64_t x2_shape[] = {c.b, x2Rows, x2Cols};
    TensorInfo x2_tensors[] = {{x2_shape, 3, c.dtype}};
    TensorGroupInfo info_x2 = {x2_tensors, 1};
    int64_t y_0_shape[] = {c.b};
    TensorInfo y_tensors[] = {{y_0_shape, 1, 0}};
    TensorGroupInfo info_y = {y_tensors, 1};

    const int64_t x1Bytes = x1Elems * elemBytes;
    const int64_t x2Bytes = x2Elems * elemBytes;

    uint8_t *inputHost_x1 = nullptr, *inputDevice_x1 = nullptr;
    uint8_t *inputHost_x2 = nullptr, *inputDevice_x2 = nullptr;
    uint8_t *outputHost_y = nullptr, *outputDevice_y = nullptr;

    ACL_CHECK(aclrtMallocHost((void **)&inputHost_x1, x1Bytes));
    ACL_CHECK(aclrtMalloc((void **)&inputDevice_x1, x1Bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    FILE_CHECK(ReadFile("./input/x1.bin", x1Bytes, inputHost_x1, x1Bytes));
    ACL_CHECK(aclrtMemcpy(inputDevice_x1, x1Bytes, inputHost_x1, x1Bytes, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMallocHost((void **)&inputHost_x2, x2Bytes));
    ACL_CHECK(aclrtMalloc((void **)&inputDevice_x2, x2Bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    FILE_CHECK(ReadFile("./input/x2.bin", x2Bytes, inputHost_x2, x2Bytes));
    ACL_CHECK(aclrtMemcpy(inputDevice_x2, x2Bytes, inputHost_x2, x2Bytes, ACL_MEMCPY_HOST_TO_DEVICE));

    // Kernels declare y as GlobalTensor of 2048 floats and several write
    // bookkeeping slots well past the result (e.g. the launch counter at
    // y[1020], byte 4080). 128B here made every one of those an
    // out-of-bounds GM write over whatever followed the allocation.
    const uint64_t resultBytes = 16384;  // diag: read full y window
    const uint64_t outBytes = 16384;
    ACL_CHECK(aclrtMallocHost((void **)&outputHost_y, outBytes));
    ACL_CHECK(aclrtMalloc((void **)&outputDevice_y, outBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMemset(outputDevice_y, outBytes, 0, outBytes));

    const int reps = std::getenv("REPS") ? std::atoi(std::getenv("REPS")) : 1;
    for (int r = 0; r < reps; ++r) {
        const auto t0 = std::chrono::steady_clock::now();
        run_kernel((GM_ADDR)inputDevice_x1, info_x1, (GM_ADDR)inputDevice_x2, info_x2,
                   (GM_ADDR)outputDevice_y, info_y, availableCoreNum, stream,
                   c.tx1, c.tx2);
        const auto t1 = std::chrono::steady_clock::now();
        const int sync_ret_ = aclrtSynchronizeStreamWithTimeout(stream, 60000);
        const auto t2 = std::chrono::steady_clock::now();
        if (sync_ret_ != 0) {
            fprintf(stderr, "[ERROR] aclrtSynchronizeStreamWithTimeout failed, ret=%d\n", sync_ret_);
            return 1;
        }
        const double launch_us = std::chrono::duration<double, std::micro>(t1 - t0).count();
        const double total_us = std::chrono::duration<double, std::micro>(t2 - t0).count();
        fprintf(stderr, "[timing] case%d rep%d launch=%.1fus total=%.1fus\n",
                caseId, r, launch_us, total_us);
    }

    ACL_CHECK(aclrtMemcpy(outputHost_y, outBytes, outputDevice_y, outBytes, ACL_MEMCPY_DEVICE_TO_HOST));
    FILE_CHECK(WriteFile("./output/y.bin", outputHost_y, resultBytes));

    if (inputDevice_x1) aclrtFree(inputDevice_x1);
    if (inputHost_x1) aclrtFreeHost(inputHost_x1);
    if (inputDevice_x2) aclrtFree(inputDevice_x2);
    if (inputHost_x2) aclrtFreeHost(inputHost_x2);
    if (outputDevice_y) aclrtFree(outputDevice_y);
    if (outputHost_y) aclrtFreeHost(outputHost_y);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
