namespace batch_matmul_max_sum_v3 {
constexpr float NEG_INF = -3.402823466e+38F;
constexpr uint64_t UB_RESERVE = 32 * 1024;
constexpr uint32_t ACCURATE_SUM_LANES = 256;
constexpr uint32_t ACCURATE_SUM_BYTES = 6 * ACCURATE_SUM_LANES * sizeof(float);
constexpr float SPLIT_READY = 1.5e38F;
constexpr int64_t SPLIT_MAX = 32;
constexpr uint32_t SPLIT_SLOT_BYTES = 128;
constexpr uint32_t SPLIT_SLOT_FLOATS = SPLIT_SLOT_BYTES / sizeof(float);
constexpr uint32_t SPLIT_UB_SLOT_FLOATS = 8;
constexpr uint32_t FLAG_BUF_BYTES = static_cast<uint32_t>(SPLIT_MAX * 32);
constexpr uint32_t SHORT_REDUCE_TMP_BYTES = 256 * sizeof(float);
constexpr int32_t REDUCE_N = 128;
constexpr int32_t SPLIT_POLL_LIMIT = 200000;
using DeviceTiling = AscendC::tiling::TCubeTiling;
inline uint64_t Align32(uint64_t bytes) { return (bytes + 31) / 32 * 32; }
inline uint64_t Align512(uint64_t bytes) { return (bytes + 511) / 512 * 512; }
struct MemoryLimits {
  uint64_t l1 = 0, l0a = 0, l0b = 0, l0c = 0, ub = 0;
};
inline MemoryLimits ReadLimits(const platform_ascendc::PlatformAscendC& platform)
{
  MemoryLimits mem;
  platform.GetCoreMemSize(platform_ascendc::CoreMemType::L1, mem.l1);
  platform.GetCoreMemSize(platform_ascendc::CoreMemType::L0_A, mem.l0a);
  platform.GetCoreMemSize(platform_ascendc::CoreMemType::L0_B, mem.l0b);
  platform.GetCoreMemSize(platform_ascendc::CoreMemType::L0_C, mem.l0c);
  platform.GetCoreMemSize(platform_ascendc::CoreMemType::UB, mem.ub);
  return mem;
}
inline int64_t BufferLimit(uint64_t capacity)
{
  return capacity == 0 ? -1 : static_cast<int64_t>(capacity);
}
inline bool Fits(uint64_t bytes, uint64_t capacity)
{
  return capacity == 0 || bytes <= capacity;
}
inline bool DirectWideGeometryFits(optiling::TCubeTiling& t, const MemoryLimits& mem,
                 int32_t localM, int32_t localN, int32_t k,
                 int32_t tasks, int32_t cm, uint64_t cdBytes = 4)
{
  const int64_t bm = t.get_baseM(), bn = t.get_baseN(), bk = t.get_baseK();
  if (bm <= 0 || bn <= 0 || bk <= 0 || bm % 16 || bn % 16 || bk % 16)
    return false;
  if (t.get_singleCoreM() < localM || t.get_singleCoreN() < localN ||
    t.get_singleCoreK() < k || t.get_usedCoreNum() != 1)
    return false;
  if (t.get_iterateOrder() != 0 && t.get_iterateOrder() != 1)
    return false;
  if (t.get_dbL0A() < 1 || t.get_dbL0B() < 1 || t.get_dbL0C() < 1)
    return false;
  const uint64_t tile = static_cast<uint64_t>(bm) * bn * sizeof(float);
  const uint64_t row = static_cast<uint64_t>(cm) * sizeof(float);
  const uint64_t frags = static_cast<uint64_t>(bm) * (bn / 16);
  const uint64_t local = Align32(static_cast<uint64_t>(bm) * bn * cdBytes) +
    Align32(frags * 4) + Align32(frags * cdBytes) + Align32(frags * 4) +
    Align32(row) + Align32(tasks * SPLIT_UB_SLOT_FLOATS * sizeof(float)) +
    Align32(row) +
    Align32(static_cast<uint64_t>(tasks) * 8 * sizeof(float)) + 32 +
    SHORT_REDUCE_TMP_BYTES;
  const uint64_t internal = t.get_transLength() > 0
    ? static_cast<uint64_t>(t.get_transLength()) : 0;
  const uint64_t reserve = internal > UB_RESERVE ? internal : UB_RESERVE;
  const uint64_t l1a = static_cast<uint64_t>(bm) * bk * 2ULL * t.get_dbL0A();
  const uint64_t l1b = static_cast<uint64_t>(bn) * bk * 2ULL * t.get_dbL0B();
  return Fits(static_cast<uint64_t>(bm) * bk * 2ULL * t.get_dbL0A(), mem.l0a) &&
     Fits(static_cast<uint64_t>(bn) * bk * 2ULL * t.get_dbL0B(), mem.l0b) &&
     Fits(tile * t.get_dbL0C(), mem.l0c) &&
     Fits(l1a + l1b, mem.l1) && Fits(local + reserve, mem.ub);
}
inline bool DirectWideGeometryFitsA2(optiling::TCubeTiling& t, const MemoryLimits& mem,
                  int32_t localM, int32_t localN, int32_t k,
                  int32_t tasks, int32_t cm)
{
  const int64_t bm = t.get_baseM(), bn = t.get_baseN(), bk = t.get_baseK();
  if (bm <= 0 || bn <= 0 || bk <= 0 || bm % 16 || bn % 16 || bk % 16)
    return false;
  if (t.get_singleCoreM() < localM || t.get_singleCoreN() < localN ||
    t.get_singleCoreK() < k || t.get_usedCoreNum() != 1)
    return false;
  if (t.get_iterateOrder() != 0 && t.get_iterateOrder() != 1)
    return false;
  if (t.get_dbL0A() < 1 || t.get_dbL0B() < 1 || t.get_dbL0C() < 1)
    return false;
  constexpr uint64_t slotBytes = 128;
  const uint64_t tile = static_cast<uint64_t>(bm) * bn * sizeof(float);
  const uint64_t row = static_cast<uint64_t>(cm) * sizeof(float);
  const uint64_t gathered = static_cast<uint64_t>(tasks) * row;
  const uint64_t local = Align32(tile) + Align32(16 * sizeof(float)) +
    Align32(16 * 16 * sizeof(float)) + Align32(16 * 16 * sizeof(float)) +
    Align32(row) + Align32(tasks * SPLIT_UB_SLOT_FLOATS * sizeof(float)) +
    Align32(gathered) + Align32(row) + 32 + SHORT_REDUCE_TMP_BYTES;
  const uint64_t internal = t.get_transLength() > 0
    ? static_cast<uint64_t>(t.get_transLength()) : 0;
  const uint64_t reserve = internal > UB_RESERVE ? internal : UB_RESERVE;
  const uint64_t l1a = static_cast<uint64_t>(bm) * bk * 2ULL * t.get_dbL0A();
  const uint64_t l1b = static_cast<uint64_t>(bn) * bk * 2ULL * t.get_dbL0B();
  return Fits(static_cast<uint64_t>(bm) * bk * 2ULL * t.get_dbL0A(), mem.l0a) &&
     Fits(static_cast<uint64_t>(bn) * bk * 2ULL * t.get_dbL0B(), mem.l0b) &&
     Fits(tile * t.get_dbL0C(), mem.l0c) &&
     Fits(l1a + l1b, mem.l1) && Fits(local + reserve, mem.ub);
}
inline DeviceTiling BuildDirectWideTilingUncachedA2(int32_t orgM, int32_t orgN, int32_t orgK,
                          int32_t localM, int32_t localN,
                          int32_t dtype, bool tx1, bool tx2,
                          int32_t tasks, int32_t cm,
                          int32_t bmOv = 0, int32_t bnOv = 0,
                          int32_t bkOv = 0, bool bNZ = false)
{
  auto* platform = platform_ascendc::PlatformAscendCManager::GetInstance();
  if (platform == nullptr) throw std::runtime_error("BMM: runtime platform unavailable");
  const MemoryLimits mem = ReadLimits(*platform);
  const auto inputType = dtype == 1 ? matmul_tiling::DataType::DT_FLOAT16
                   : matmul_tiling::DataType::DT_BF16;
#if defined(BMM_WIDE_BASE_BM) && defined(BMM_WIDE_BASE_BN)
  const int32_t bases[][2] = {{BMM_WIDE_BASE_BM, BMM_WIDE_BASE_BN},
                {128, 256}, {128, 128}, {64, 256}, {64, 128},
                {32, 128}, {16, 64}};
#else
  const int32_t bases[][2] = {{128, 256}, {128, 128}, {64, 256}, {64, 128},
                {32, 128}, {16, 64}};
#endif
  const auto tryCompact = [&](optiling::TCubeTiling& host) -> bool {
#ifndef BMM_KCOMPACT
#define BMM_KCOMPACT 1
#endif
    if (!BMM_KCOMPACT && bkOv <= 0) return false;
    if (host.get_baseK() > 64 || orgK <= 64) {
      if (bkOv <= 0) return false;
      if (host.get_baseK() == bkOv) return false;
    }
#ifndef BMM_KCOMPACT_MTILE
#define BMM_KCOMPACT_MTILE 0
#endif
#ifndef BMM_KCOMPACT_ORG
#define BMM_KCOMPACT_ORG 1
#endif
    if (bkOv <= 0 && !BMM_KCOMPACT_MTILE &&
      host.get_singleCoreM() > host.get_baseM())
      return false;
    const bool kWideOrgA2 = (orgK > 1200 || orgM > 1200);
#ifndef BMM_KCOMPACT_WIDE
#define BMM_KCOMPACT_WIDE 1
#endif
    if (bkOv <= 0 && BMM_KCOMPACT_ORG &&
      (orgK < 768 || (kWideOrgA2 && !BMM_KCOMPACT_WIDE)))
      return false;
    if (bkOv <= 0 && kWideOrgA2 && orgK > 1200) return false;
    for (int32_t bkTry = (bkOv > 0 ? bkOv : 256); bkTry >= 128; bkTry -= 128) {
      if (bkTry > orgK) continue;
      const int64_t bm = host.get_baseM();
      int64_t bn = host.get_baseN();
      int64_t aSingle = bm * bkTry * 2;
      int64_t dbA = aSingle * 2 <= (int64_t)mem.l0a ? 2
            : aSingle <= (int64_t)mem.l0a ? 1 : 0;
      if (bn * bkTry * 2 > (int64_t)mem.l0b) {
        const int64_t bnFit = (int64_t)mem.l0b / (bkTry * 2) / 16 * 16;
        if (bnFit < 32) continue;
        if (kWideOrgA2 && bnFit < bn) continue;
        bn = bnFit;
      }
      const int64_t bSingle = bn * bkTry * 2;
      const int64_t dbB = bSingle * 2 <= (int64_t)mem.l0b ? 2
               : bSingle <= (int64_t)mem.l0b ? 1 : 0;
      if (dbA == 0 || dbB == 0) continue;
      const int32_t steps = (orgK + bkTry - 1) / bkTry;
      const int32_t svBK = host.get_baseK(), svBN = host.get_baseN();
      const int32_t svKa = host.get_stepKa(), svKb = host.get_stepKb();
      const int32_t svDbA = host.get_dbL0A(), svDbB = host.get_dbL0B();
      const int32_t svDepth = host.get_depthA1();
      host.set_baseK(bkTry);
      host.set_baseN(static_cast<int32_t>(bn));
      host.set_stepKa(steps);
      host.set_stepKb(1);
      host.set_dbL0A(static_cast<int32_t>(dbA));
      host.set_dbL0B(static_cast<int32_t>(dbB));
      const int64_t b1Cap = (int64_t)mem.l1 / 2 / bSingle;
      if (host.get_depthB1() > b1Cap)
        host.set_depthB1(static_cast<int32_t>(b1Cap < 1 ? 1 : b1Cap));
      const int64_t b1Bytes = bn * bkTry * 2 * host.get_depthB1();
      const int64_t a1Room = (int64_t)mem.l1 - b1Bytes;
      const int64_t a1Max = a1Room / (bm * bkTry * 2);
      host.set_depthA1(static_cast<int32_t>(steps < a1Max ? steps : (a1Max < 1 ? 1 : a1Max)));
      if (!DirectWideGeometryFitsA2(host, mem, localM, localN, orgK, tasks, cm)) {
        host.set_baseK(svBK);
        host.set_baseN(svBN);
        host.set_stepKa(svKa);
        host.set_stepKb(svKb);
        host.set_dbL0A(svDbA);
        host.set_dbL0B(svDbB);
        host.set_depthA1(svDepth);
        continue;
      }
      return true;
    }
    return false;
  };
  DeviceTiling fallback{};
  bool haveFallback = false;
  for (const auto& base : bases) {
    matmul_tiling::MultiCoreMatmulTiling api(*platform);
    api.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
          inputType, tx1);
    api.SetBType(matmul_tiling::TPosition::GM,
          bNZ ? matmul_tiling::CubeFormat::NZ : matmul_tiling::CubeFormat::ND,
          inputType, tx2);
    api.SetCType(matmul_tiling::TPosition::VECIN, matmul_tiling::CubeFormat::NZ,
          matmul_tiling::DataType::DT_FLOAT);
    api.SetBiasType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
            matmul_tiling::DataType::DT_FLOAT);
    api.SetBias(false);
    api.SetDim(1);
    api.SetOrgShape(orgM, orgN, orgK);
    api.SetShape(localM, localN, orgK);
    api.SetSingleShape(localM, localN, orgK);
    api.SetFixSplit(base[0], base[1], -1);
    api.SetBufferSpace(BufferLimit(mem.l1), BufferLimit(mem.l0c), BufferLimit(mem.ub));
    optiling::TCubeTiling host;
    if (api.GetTiling(host) < 0)
      continue;
#if defined(BMM_WIDE_ORDER) && BMM_WIDE_ORDER >= 0
    host.set_iterateOrder(BMM_WIDE_ORDER);
#endif
    if (!DirectWideGeometryFitsA2(host, mem, localM, localN, orgK, tasks, cm))
      continue;
    DeviceTiling device{};
    if (host.GetDataSize() != sizeof(device)) continue;
    if (!haveFallback) {
      host.SaveToBuffer(&fallback, sizeof(fallback));
      haveFallback = true;
    }
    if (tryCompact(host)) {
      host.SaveToBuffer(&device, sizeof(device));
      return device;
    }
  }
  if (haveFallback) return fallback;
  throw std::runtime_error("BMM: direct wide tiling failed");
}
inline DeviceTiling BuildDirectWideTilingA2(int32_t orgM, int32_t orgN, int32_t orgK,
                      int32_t localM, int32_t localN,
                      int32_t dtype, bool tx1, bool tx2,
                      int32_t tasks, int32_t cm,
                      int32_t bmOv = 0, int32_t bnOv = 0,
                      int32_t bkOv = 0, bool bNZ = false)
{
  return BuildDirectWideTilingUncachedA2(orgM, orgN, orgK, localM, localN,
                     dtype, tx1, tx2, tasks, cm, bmOv, bnOv,
                     bkOv, bNZ);
}
inline DeviceTiling BuildDirectWideTilingUncached(int32_t orgM, int32_t orgN, int32_t orgK,
                         int32_t localM, int32_t localN,
                         int32_t dtype, bool tx1, bool tx2,
                         int32_t tasks, int32_t cm,
                         uint64_t cdBytes = 4,
                         bool wide256 = false,
                         int32_t bkMax = 256,
                         int32_t bmOv = 0, int32_t bnOv = 0,
                         int32_t bkOv = 0)
{
  auto* platform = platform_ascendc::PlatformAscendCManager::GetInstance();
  if (platform == nullptr) throw std::runtime_error("BMM: runtime platform unavailable");
  const MemoryLimits mem = ReadLimits(*platform);
  const auto inputType = dtype == 1 ? matmul_tiling::DataType::DT_FLOAT16
                   : matmul_tiling::DataType::DT_BF16;
#if defined(BMM_BASEN512) && BMM_BASEN512
  const int32_t bases[][2] = {{128, 512}, {64, 512},
                {128, 256}, {128, 128}, {64, 256}, {64, 128},
                {32, 128}, {16, 64}};
#elif defined(BMM_WIDE_BASE_BM) && defined(BMM_WIDE_BASE_BN)
  const int32_t bases[][2] = {{BMM_WIDE_BASE_BM, BMM_WIDE_BASE_BN},
                {128, 256}, {128, 128}, {64, 256}, {64, 128},
                {32, 128}, {16, 64}};
#else
  const int32_t bases[][2] = {{128, 256}, {128, 128}, {64, 256}, {64, 128},
                {32, 128}, {16, 64}};
#endif
  const int32_t baseCount = static_cast<int32_t>(sizeof(bases) / sizeof(bases[0]));
  const int32_t baseBegin = wide256 ? 0 : 1;
  int32_t basesOv[9][2];
  const int32_t (*useBases)[2] = bases;
  int32_t useCount = baseCount;
  int32_t useBegin = baseBegin;
  if (bmOv > 0) {
    basesOv[0][0] = bmOv;
    basesOv[0][1] = bnOv > 0 ? bnOv : 128;
    for (int32_t i = 0; i < baseCount; ++i) {
      basesOv[i + 1][0] = bases[i][0];
      basesOv[i + 1][1] = bases[i][1];
    }
    useBases = basesOv;
    useCount = baseCount + 1;
    useBegin = 0;
  }
  const auto tryCompact = [&](optiling::TCubeTiling& host) -> bool {
#ifndef BMM_KCOMPACT
#define BMM_KCOMPACT 1
#endif
    if (!BMM_KCOMPACT && bkOv <= 0) return false;
    if (host.get_baseK() > 64 || orgK <= 64) {
      if (bkOv <= 0) return false;
      if (host.get_baseK() == bkOv) return false;
    }
#ifndef BMM_KCOMPACT_MTILE
#define BMM_KCOMPACT_MTILE 0
#endif
#ifndef BMM_KCOMPACT_ORG
#define BMM_KCOMPACT_ORG 1
#endif
    if (bkOv <= 0 && !BMM_KCOMPACT_MTILE &&
      host.get_singleCoreM() > host.get_baseM())
      return false;
    const bool kWideOrg = (orgK > 1200 || orgM > 1200);
#ifndef BMM_KCOMPACT_WIDE
#define BMM_KCOMPACT_WIDE 1
#endif
    if (bkOv <= 0 && BMM_KCOMPACT_ORG && (orgK < 768 || (kWideOrg && !BMM_KCOMPACT_WIDE)))
      return false;
    if (bkOv <= 0 && kWideOrg && orgK > 1200) return false;
    for (int32_t bkTry = (bkOv > 0 ? bkOv : bkMax); bkTry >= 128; bkTry -= 128) {
      if (bkTry > orgK) continue;
      const int64_t bm = host.get_baseM();
      int64_t bn = host.get_baseN();
      int64_t aSingle = bm * bkTry * 2;
      int64_t dbA = aSingle * 2 <= (int64_t)mem.l0a ? 2
            : aSingle <= (int64_t)mem.l0a ? 1 : 0;
      if (bn * bkTry * 2 > (int64_t)mem.l0b) {
        const int64_t bnFit = (int64_t)mem.l0b / (bkTry * 2) / 16 * 16;
        if (bnFit < 32) continue;
        if (kWideOrg && bnFit < bn) continue;
        bn = bnFit;
      }
      const int64_t bSingle = bn * bkTry * 2;
      const int64_t dbB = bSingle * 2 <= (int64_t)mem.l0b ? 2
               : bSingle <= (int64_t)mem.l0b ? 1 : 0;
      if (dbA == 0 || dbB == 0) continue;
      const int32_t steps = (orgK + bkTry - 1) / bkTry;
      const int32_t svBK = host.get_baseK(), svBN = host.get_baseN();
      const int32_t svKa = host.get_stepKa(), svKb = host.get_stepKb();
      const int32_t svDbA = host.get_dbL0A(), svDbB = host.get_dbL0B();
      const int32_t svDepth = host.get_depthA1();
      host.set_baseK(bkTry);
      host.set_baseN(static_cast<int32_t>(bn));
      host.set_stepKa(steps);
      host.set_stepKb(1);
      host.set_dbL0A(static_cast<int32_t>(dbA));
      host.set_dbL0B(static_cast<int32_t>(dbB));
      const int64_t b1Cap = (int64_t)mem.l1 / 2 / bSingle;
      if (host.get_depthB1() > b1Cap)
        host.set_depthB1(static_cast<int32_t>(b1Cap < 1 ? 1 : b1Cap));
      const int64_t b1Bytes = bn * bkTry * 2 * host.get_depthB1();
      const int64_t a1Room = (int64_t)mem.l1 - b1Bytes;
      const int64_t a1Max = a1Room / (bm * bkTry * 2);
      host.set_depthA1(static_cast<int32_t>(steps < a1Max ? steps : (a1Max < 1 ? 1 : a1Max)));
      if (!DirectWideGeometryFits(host, mem, localM, localN, orgK, tasks, cm, cdBytes)) {
        host.set_baseK(svBK);
        host.set_baseN(svBN);
        host.set_stepKa(svKa);
        host.set_stepKb(svKb);
        host.set_dbL0A(svDbA);
        host.set_dbL0B(svDbB);
        host.set_depthA1(svDepth);
        continue;
      }
      return true;
    }
    return false;
  };
  DeviceTiling fallback{};
  bool haveFallback = false;
  for (int32_t bi = useBegin; bi < useCount; ++bi) {
    const int32_t* base = useBases[bi];
    matmul_tiling::MultiCoreMatmulTiling api(*platform);
    api.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
          inputType, tx1);
    api.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
          inputType, tx2);
    api.SetCType(matmul_tiling::TPosition::VECIN, matmul_tiling::CubeFormat::NZ,
          matmul_tiling::DataType::DT_FLOAT);
    api.SetBiasType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
            matmul_tiling::DataType::DT_FLOAT);
    api.SetBias(false);
    api.SetDim(1);
    api.SetOrgShape(orgM, orgN, orgK);
    api.SetShape(localM, localN, orgK);
    api.SetSingleShape(localM, localN, orgK);
    api.SetFixSplit(base[0], base[1], -1);
    api.SetBufferSpace(BufferLimit(mem.l1), BufferLimit(mem.l0c), BufferLimit(mem.ub));
    optiling::TCubeTiling host;
    if (api.GetTiling(host) < 0)
      continue;
#if defined(BMM_WIDE_ORDER) && BMM_WIDE_ORDER >= 0
    host.set_iterateOrder(BMM_WIDE_ORDER);
#endif
    if (!DirectWideGeometryFits(host, mem, localM, localN, orgK, tasks, cm, cdBytes))
      continue;
    DeviceTiling device{};
    if (host.GetDataSize() != sizeof(device)) continue;
    if (!haveFallback) {
      host.SaveToBuffer(&fallback, sizeof(fallback));
      haveFallback = true;
      if (tryCompact(host)) {
        host.SaveToBuffer(&device, sizeof(device));
        return device;
      }
      return fallback;
    }
  }
  if (haveFallback) return fallback;
  throw std::runtime_error("BMM: direct wide tiling failed");
}
inline DeviceTiling BuildDirectWideTiling(int32_t orgM, int32_t orgN, int32_t orgK,
                     int32_t localM, int32_t localN,
                     int32_t dtype, bool tx1, bool tx2,
                     int32_t tasks, int32_t cm,
                     uint64_t cdBytes = 4,
                     bool wide256 = false,
                     int32_t bkMax = 256,
                     int32_t bmOv = 0, int32_t bnOv = 0,
                     int32_t bkOv = 0)
{
  struct Entry {
    int32_t device, orgM, orgN, orgK, localM, localN, dtype, tasks, cm;
    bool tx1, tx2, wide256;
    uint64_t cdBytes;
    int32_t bkMax, bmOv, bnOv, bkOv;
    DeviceTiling tiling;
  };
  static thread_local std::vector<Entry> cache;
  int32_t device = -1;
  if (aclrtGetDevice(&device) != ACL_SUCCESS)
    throw std::runtime_error("BMM: cannot query current device for direct wide tiling");
  for (const auto& e : cache) {
    if (e.device == device && e.orgM == orgM && e.orgN == orgN && e.orgK == orgK &&
      e.localM == localM && e.localN == localN && e.dtype == dtype &&
      e.tx1 == tx1 && e.tx2 == tx2 && e.tasks == tasks && e.cm == cm &&
      e.cdBytes == cdBytes && e.wide256 == wide256 && e.bkMax == bkMax &&
      e.bmOv == bmOv && e.bnOv == bnOv && e.bkOv == bkOv)
      return e.tiling;
  }
  const auto t = BuildDirectWideTilingUncached(orgM, orgN, orgK, localM, localN,
                        dtype, tx1, tx2, tasks, cm, cdBytes,
                        wide256, bkMax, bmOv, bnOv, bkOv);
  cache.push_back({device, orgM, orgN, orgK, localM, localN, dtype, tasks, cm,
          tx1, tx2, wide256, cdBytes, bkMax, bmOv, bnOv, bkOv, t});
  return t;
}
__aicore__ constexpr ::MatmulConfig ApplyWideTweak(::MatmulConfig c, int tweak)
{
  if (tweak & 1) c.enableSetTail = false;
  if (tweak & 2) c.enableSetBias = false;
  if (tweak & 4) c.enUnitFlag = true;
  if (tweak & 8) c.iterateOrder = IterateOrder::ORDER_N;
  if (tweak & 16) c.iterateOrder = IterateOrder::ORDER_M;
  if (tweak & 32) {
    c.iterateMode = IterateMode::ITERATE_MODE_NORMAL;
    c.enableQuantVector = false;
    c.enableSetDefineData = false;
  }
  return c;
}
template <class A, class B, class C, class D, int CM_, int CN_, int OK_, int MODE,
     int SBM = 128, int SBN = 128, int SBK = 128, int TWEAK = 0, int L1SZ = 0,
     int DB1 = 0, int DA1 = 0>
struct WideStaticMmCfg {
  __aicore__ static constexpr auto Make()
  {
    auto t = AscendC::GetMatmulApiTiling<A, B, C, D>(
      ApplyWideTweak(GetMMConfig<static_cast<MatmulConfigMode>(MODE)>(
               MatmulShapeParams{CM_, CN_, OK_, SBM, SBN, SBK}),
             TWEAK),
      L1SZ > 0 ? L1SZ : AscendC::Impl::L1_SIZE);
    if (DB1 > 0) t.depthB1 = DB1;
    if (DA1 > 0) t.depthA1 = DA1;
    return t;
  }
  static constexpr auto value = Make();
};
template <class A, class B, class C, class D, const ::MatmulConfig* P>
struct WideDynMmCfg {
  static constexpr ::MatmulConfig value = (P != nullptr) ? *P : ::CFG_NORM;
};
struct C10RtPlan {
  int32_t cores;
  int32_t wOff[65];
  int32_t nOff[65];
};
template <typename T, bool TX1, bool TX2,
     int OM, int ON, int OK, int MS, int NS, int CM, int CN,
     bool ASYNC = false, typename CD = float,
     const ::MatmulConfig* MMCFG = nullptr, bool USE_STATIC_TILING = false,
     int STATIC_MODE = 0, bool B_NZ = false,
     int SBM = 128, int SBN = 128, int SBK = 128, int TWEAK = 0, int L1SZ = 0,
     int PREFETCH = 0, int CQD = 0, int FOLD_STREAM = 0,
     int DB1 = 0, int DA1 = 0, int ORD = -1, int MIXCN = 0,
     int RTMAP = 0>
class CubeWideNDirect {
  static constexpr int MIX_CN0 = CN;
  static constexpr int MIX_CN1 = MIXCN ? (ON - CN) : CN;
  static constexpr int TASKS = MIXCN ? MS * 2 : MS * NS;
  using AType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, T, TX1>;
  using BTypeNZ = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::NZ, T, TX2>;
  using BTypeND = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, T, TX2>;
  using BType = typename std::conditional<B_NZ, BTypeNZ, BTypeND>::type;
  using CType = AscendC::MatmulType<AscendC::TPosition::VECIN, CubeFormat::NZ, CD>;
  using BiasType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float>;
  static constexpr int SLOT_FLOATS = ((CM + 1 + 31) / 32) * 32;
  static constexpr int SLOT_BYTES = SLOT_FLOATS * sizeof(float);
  static constexpr int FLAG_OFF = CM;
  static constexpr int CACHE_CM = (CM + 127) / 128 * 128;
  static constexpr int CACHE_CN =
    ((MIX_CN0 >= MIX_CN1 ? MIX_CN0 : MIX_CN1) + 15) / 16 * 16;
  static constexpr int CACHE_ELEMS = CACHE_CM * CACHE_CN;
public:
  using StaticCfg = WideStaticMmCfg<AType, BType, CType, BiasType, CM, CN, OK,
                   STATIC_MODE, SBM, SBN, SBK, TWEAK, L1SZ,
                   DB1, DA1>;
  static constexpr auto STATIC_TILING_VAL = StaticCfg::value;
  static_assert(!USE_STATIC_TILING || (STATIC_TILING_VAL.singleCoreM != -1 &&
         STATIC_TILING_VAL.singleCoreN != -1 && STATIC_TILING_VAL.singleCoreK != -1 &&
         STATIC_TILING_VAL.stepKa != -1 && STATIC_TILING_VAL.stepKb != -1 &&
         STATIC_TILING_VAL.depthA1 != -1 && STATIC_TILING_VAL.depthB1 != -1 &&
         STATIC_TILING_VAL.iterateOrder != -1),
         "constant tiling only partially filled (singleCore*==0 early return)");
#ifdef BMM_PROBE_TILING
  template <int BM_, int BN_, int BK_, int SCM, int SCN, int SCK, int KA,
       int PA1, int PB1, int DB0B, int PORD, int S1, int S2, int S3, bool FIRE>
  struct BmmTilingProbe { };
  template <int BM_, int BN_, int BK_, int SCM, int SCN, int SCK, int KA,
       int PA1, int PB1, int DB0B, int PORD, int S1, int S2, int S3>
  struct BmmTilingProbe<BM_, BN_, BK_, SCM, SCN, SCK, KA, PA1, PB1, DB0B, PORD, S1, S2, S3, true>;
  BmmTilingProbe<STATIC_TILING_VAL.baseM, STATIC_TILING_VAL.baseN,
         STATIC_TILING_VAL.baseK, STATIC_TILING_VAL.singleCoreM,
         STATIC_TILING_VAL.singleCoreN, STATIC_TILING_VAL.singleCoreK,
         STATIC_TILING_VAL.stepKa, STATIC_TILING_VAL.depthA1,
         STATIC_TILING_VAL.depthB1, STATIC_TILING_VAL.dbL0B,
         STATIC_TILING_VAL.iterateOrder, SBM, SBN, SBK,
         (OM == 1536 && ON == 2048 && OK == 2048)> bmmTilingProbe_;
#endif
  static_assert(!(USE_STATIC_TILING && (TWEAK & 1)) ||
         (CM % STATIC_TILING_VAL.baseM == 0 && CN % STATIC_TILING_VAL.baseN == 0 &&
         OK % STATIC_TILING_VAL.baseK == 0),
         "TWEAK bit 1 (enableSetTail=false) needs singleCore % base == 0 on M, N and K");
  static_assert(!USE_STATIC_TILING ||
         (static_cast<long long>(STATIC_TILING_VAL.depthA1) * STATIC_TILING_VAL.baseM *
           STATIC_TILING_VAL.baseK +
         static_cast<long long>(STATIC_TILING_VAL.depthB1) * STATIC_TILING_VAL.baseK *
           STATIC_TILING_VAL.baseN) * static_cast<long long>(sizeof(T)) <= 524288LL,
         "A1 + B1 L1 residency exceeds the 512KB the constant tiler budgets");
private:
  using MmSel = std::conditional_t<USE_STATIC_TILING, StaticCfg,
    WideDynMmCfg<AType, BType, CType, BiasType, MMCFG>>;
public:
  __aicore__ inline AscendC::TPipe* Pipe() { return &pipe_; }
  __aicore__ static inline DeviceTiling* TilingFor(DeviceTiling& t)
  {
    if constexpr (USE_STATIC_TILING) { (void)t; return nullptr; }
    else { return &t; }
  }
  __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR asyncCache,
                GM_ADDR tiles, int32_t blocks, DeviceTiling& tiling,
                float nonce = 1.0F, int32_t padSplit = 0,
                const C10RtPlan* rtPlan = nullptr)
  {
    blocks_ = blocks;
    rtPlan_ = rtPlan;
    if (padSplit) {
      pipe_.InitBuffer(padA2Buf_, 32768);
      pipe_.InitBuffer(padB2Buf_, 32768);
      pipe_.InitBuffer(padC1Buf_, 65536);
    }
    block_ = static_cast<int32_t>(AscendC::GetBlockIdx());
    nonce_ = nonce;
    tilt_ = &tiling;
    if constexpr (USE_STATIC_TILING) {
      bm_ = STATIC_TILING_VAL.baseM;
      bn_ = STATIC_TILING_VAL.baseN;
      iterateOrder_ = ORD >= 0 ? ORD : tiling.iterateOrder;
    } else {
      bm_ = tiling.baseM;
      bn_ = tiling.baseN;
      bk_ = tiling.baseK;
      iterateOrder_ = tiling.iterateOrder;
    }
    x1_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1), static_cast<int64_t>(OM) * OK);
    x2_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2), static_cast<int64_t>(ON) * OK);
    y_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y), 2048);
    slots_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(tiles),
                static_cast<int64_t>(TASKS) * SLOT_FLOATS);
    if constexpr (ASYNC) {
      asyncCachePool_.SetGlobalBuffer(
        reinterpret_cast<__gm__ CD*>(asyncCache),
        static_cast<int64_t>(TASKS) * CACHE_ELEMS);
    }
#ifndef BMM_CQUEUE_DEPTH
#define BMM_CQUEUE_DEPTH 1
#endif
    pipe_.InitBuffer(cQueue_, CQD > 0 ? CQD : BMM_CQUEUE_DEPTH,
            static_cast<uint32_t>(bm_ * bn_ * sizeof(CD)));
    pipe_.InitBuffer(tileMaxBuf_, static_cast<uint32_t>(bm_ * (bn_ / 16) * sizeof(float)));
    pipe_.InitBuffer(fragMaxBuf_, static_cast<uint32_t>(bm_ * (bn_ / 16) * sizeof(CD)));
    pipe_.InitBuffer(scratchBuf_, static_cast<uint32_t>(bm_ * (bn_ / 16) * sizeof(float)));
    pipe_.InitBuffer(rowMaxBuf_, (CM + 8) * sizeof(float));
    pipe_.InitBuffer(flagBuf_, TASKS * SPLIT_UB_SLOT_FLOATS * sizeof(float));
    pipe_.InitBuffer(gatherBuf_,
            (FOLD_STREAM ? (MS + TASKS) : TASKS) * CM * sizeof(float));
    pipe_.InitBuffer(foldBuf_, CM * sizeof(float));
    pipe_.InitBuffer(sumBuf_, MS * 8 * sizeof(float));
    pipe_.InitBuffer(reduceTmpBuf_, SHORT_REDUCE_TMP_BYTES);
    pipe_.InitBuffer(outBuf_, 32);
    if constexpr (PREFETCH) pipe_.InitBuffer(pfBuf_, PF_BYTES);
  }
  __aicore__ inline void Process()
  {
    if (block_ >= blocks_) return;
    if constexpr (USE_STATIC_TILING) {
      mm_.SetOrgShape(OM, ON, OK, OK, ON);
    }
    if constexpr (PF_ENTRY != 0) {
      Prefetch(PF_ENTRY);
      if constexpr (PF_ENTRY_FENCE) {
        const auto ev = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(ev);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(ev);
      }
    }
    if constexpr (RTMAP) {
      const C10RtPlan& rp = *rtPlan_;
      if (block_ < rp.cores) {
        for (int32_t k = rp.wOff[block_]; k < rp.wOff[block_ + 1]; ++k)
          ComputeTask(2 * k);
        for (int32_t k = rp.nOff[block_]; k < rp.nOff[block_ + 1]; ++k)
          ComputeTask(2 * k + 1);
      }
    } else if constexpr (MIXCN) {
      if (blocks_ == 20 && MS == 32) {
        if (block_ < 16) {
          ComputeTask(4 * block_);
          ComputeTask(4 * block_ + 2);
          ComputeTask(2 * block_ + 1);
        } else {
          const int32_t d = block_ - 16;
          for (int32_t k = 0; k < 4; ++k)
            ComputeTask(2 * (16 + 4 * d + k) + 1);
        }
      } else {
        for (int32_t task = block_; task < TASKS; task += blocks_)
          ComputeTask(task);
      }
    } else {
      for (int32_t task = block_; task < TASKS; task += blocks_)
        ComputeTask(task);
    }
    if constexpr (PF_DEFER != 0 || (PF_ENTRY != 0 && !PF_ENTRY_FENCE)) {
      const auto pfEv = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
      AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(pfEv);
      AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(pfEv);
    }
    AscendC::SyncAll();  // 所有 block 的 Publish rowMax 写全局可见后才 Fold
    if (block_ == 0) Fold();
  }
private:
  __aicore__ inline void ComputeTask(int32_t task)
  {
    const int32_t mi = MIXCN ? (task >> 1) : task / NS;
    const int32_t ni = MIXCN ? (task & 1) : task % NS;
    const int32_t mStart = mi * CM;
    const int32_t nStart = MIXCN ? (ni ? MIX_CN0 : 0) : ni * CN;
    const int32_t taskCN = MIXCN ? (ni ? MIX_CN1 : MIX_CN0) : CN;
    const int32_t validM = OM - mStart < CM ? OM - mStart : CM;
    const int32_t validN = ON - nStart < taskCN ? ON - nStart : taskCN;
    if (validM <= 0 || validN <= 0) return;
    if constexpr (MIXCN) {
      tilt_->N = validN;
      tilt_->singleCoreN = validN;
    }
    const int64_t aOff = TX1 ? mStart : static_cast<int64_t>(mStart) * OK;
    const int64_t bOff = TX2
      ? static_cast<int64_t>(nStart) * OK
      : (B_NZ ? static_cast<int64_t>(nStart) * ((OK + 15) / 16 * 16)
          : nStart);
    if constexpr (ASYNC) {
      asyncCache_.SetGlobalBuffer(asyncCachePool_.GetPhyAddr(
        static_cast<uint64_t>(task) * CACHE_ELEMS), CACHE_ELEMS);
      mm_.SetWorkspace(asyncCache_);
    }
    mm_.SetTensorA(x1_[aOff], TX1);
    mm_.SetTensorB(x2_[bOff], TX2);
    mm_.SetTail(validM, validN, OK);
    auto rowMax = rowMaxBuf_.Get<float>();
    AscendC::Duplicate(rowMax, -3.402823466e+38F, CM);
    AscendC::PipeBarrier<PIPE_V>();
    const int32_t tilesM = (validM + bm_ - 1) / bm_;
    const int32_t tilesN = (validN + bn_ - 1) / bn_;
    int32_t iter = 0;
    while (mm_.template Iterate<ASYNC ? false : true>()) {
      int32_t mt = 0, nt = 0;
      if (iterateOrder_ == 0) {
        mt = iter % tilesM;
        nt = iter / tilesM;
      } else {
        nt = iter % tilesN;
        mt = iter / tilesN;
      }
      const int32_t m0 = mt * bm_;
      const int32_t n0 = nt * bn_;
      const int32_t mv = validM - m0 < bm_ ? validM - m0 : bm_;
      const int32_t nv = validN - n0 < bn_ ? validN - n0 : bn_;
      auto c = cQueue_.AllocTensor<CD>();
      if constexpr (ASYNC) {
        mm_.template GetTensorC<false>(c, 0, true);
      } else {
        mm_.template GetTensorC<true>(c, 0, true);
      }
      cQueue_.EnQue<CD>(c);
      c = cQueue_.DeQue<CD>();
      ReduceNzTile(c, mv, nv, m0);
      cQueue_.FreeTensor(c);
      ++iter;
      if constexpr (MIXCN) {
        const int32_t totalTiles =
          tilesM * tilesN * ((OK + bk_ - 1) / bk_);
        if (iter >= totalTiles) break;
      }
      if constexpr (PF_DEFER != 0) {
        if (!pfDone_) { pfDone_ = true; Prefetch(PF_DEFER); }
      }
    }
    mm_.End();
    Publish(task);
  }
  __aicore__ inline void ReduceNzTile(const AscendC::LocalTensor<CD>& tile,
                    int32_t mv, int32_t nv, int32_t mRow)
  {
    auto rowMax = rowMaxBuf_.Get<float>();
    auto fragMax = tileMaxBuf_.Get<float>();
    auto fragMaxH = fragMaxBuf_.Get<CD>();
    auto scratch = scratchBuf_.Get<uint8_t>();
    const int32_t validNFrags = (nv + 15) / 16;
    const int32_t mStride = (mv + 15) / 16 * 16;
    const uint32_t rows = static_cast<uint32_t>(mStride) * validNFrags;
    uint32_t shape[2] = {rows, 16u};
    if constexpr (std::is_same_v<CD, half>) {
      AscendC::ReduceMax<half, AscendC::Pattern::Reduce::AR, true>(
        fragMaxH, tile, scratch, shape, true);
      AscendC::PipeBarrier<PIPE_V>();
      AscendC::Cast<float, half>(fragMax, fragMaxH, AscendC::RoundMode::CAST_NONE, rows);
      AscendC::PipeBarrier<PIPE_V>();
    } else {
      AscendC::ReduceMax<float, AscendC::Pattern::Reduce::AR, true>(
        fragMax, tile, scratch, shape, true);
      AscendC::PipeBarrier<PIPE_V>();
    }
    AscendC::Max(rowMax[mRow], rowMax[mRow], fragMax[0], mv);
    AscendC::PipeBarrier<PIPE_V>();
    for (int32_t nf = 1; nf < validNFrags; ++nf) {
      AscendC::Max(rowMax[mRow], rowMax[mRow], fragMax[nf * mStride], mv);
      AscendC::PipeBarrier<PIPE_V>();
    }
  }
  __aicore__ inline void Prefetch(int which)
  {
    auto pf = pfBuf_.Get<T>();
    constexpr int64_t chunk = PF_BYTES / static_cast<int64_t>(sizeof(T));
    AscendC::DataCopyParams ip{static_cast<uint16_t>(PF_BYTES / 4096), 128, 0, 0};
    AscendC::DataCopyEnhancedParams ep;
    ep.blockMode = AscendC::BlockMode::BLOCK_MODE_VECTOR;
    constexpr int64_t x1C = static_cast<int64_t>(OM) * OK / chunk;
    constexpr int64_t x2C = static_cast<int64_t>(ON) * OK / chunk;
    if (which & 1)
      for (int64_t c = block_; c < x1C; c += blocks_)
        AscendC::DataCopy(pf, x1_[c * chunk], ip, ep);
    if (which & 2)
      for (int64_t c = block_; c < x2C; c += blocks_)
        AscendC::DataCopy(pf, x2_[c * chunk], ip, ep);
  }
  __aicore__ inline void Publish(int32_t task)
  {
    // FIX: rowMax 与 flag 合并为一次 MTE3 突发（flag 紧跟 rowMax 之后），
    // 避免 4B flag 写先于 512B rowMax 突发写对 Fold 可见导致的竞态。
    const int64_t slot = static_cast<int64_t>(task) * SLOT_FLOATS;
    auto rmax = rowMaxBuf_.Get<float>();
    AscendC::Duplicate(rmax[CM], nonce_, 8);
    const auto ready = pipe_.FetchEventID(AscendC::HardEvent::V_MTE3);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(ready);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(ready);
    AscendC::DataCopyExtParams rows{1, (CM + 1) * sizeof(float), 0, 0, 0};
    AscendC::DataCopyPad(slots_[slot], rmax, rows);
    const auto done = pipe_.FetchEventID(AscendC::HardEvent::MTE3_V);
    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(done);
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(done);
  }
  __aicore__ inline void Fold()
  {
    auto flags = flagBuf_.Get<float>();
    AscendC::DataCopyPadExtParams<float> pad{};
    AscendC::DataCopyExtParams fg{TASKS, sizeof(float), SLOT_BYTES - sizeof(float), 0, 0};
    auto sums = sumBuf_.Get<float>();
    auto tmp = reduceTmpBuf_.Get<float>();
    if constexpr (FOLD_STREAM) {
      auto acc = gatherBuf_.Get<float>();
      AscendC::Duplicate(acc, -3.402823466e+38F, MS * CM);
      AscendC::PipeBarrier<PIPE_V>();
      AscendC::DataCopyExtParams rg1{1, CM * sizeof(float), 0, 0, 0};
      int32_t foldedIdx[TASKS];
      uint64_t doneMask = 0;
      const uint64_t allMask =
        TASKS >= 64 ? ~uint64_t(0)
              : (uint64_t(1) << TASKS) - uint64_t(1);
      for (int32_t attempt = 0; attempt < SPLIT_POLL_LIMIT; ++attempt) {
        AscendC::DataCopyPad(flags, slots_[FLAG_OFF], fg, pad);
        const auto m2v = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(m2v);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(m2v);
        const auto v2s = pipe_.FetchEventID(AscendC::HardEvent::V_S);
        AscendC::SetFlag<AscendC::HardEvent::V_S>(v2s);
        AscendC::WaitFlag<AscendC::HardEvent::V_S>(v2s);
        int32_t folded = 0;
        for (int32_t t = 0; t < TASKS; ++t) {
          if (((doneMask >> t) & 1ull) == 0 && flags.GetValue(t) == nonce_) {
            doneMask |= (uint64_t(1) << t);
            AscendC::DataCopyPad(
              acc[static_cast<int64_t>(MS) * CM + static_cast<int64_t>(folded) * CM],
              slots_[static_cast<int64_t>(t) * SLOT_FLOATS], rg1, pad);
            foldedIdx[folded] = t;
            ++folded;
          }
        }
        if (folded > 0) {
          const auto m2r = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
          AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(m2r);
          AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(m2r);
          for (int32_t k = 0; k < folded; ++k) {
            const int32_t mi = foldedIdx[k] / NS;
            AscendC::Max(acc[static_cast<int64_t>(mi) * CM],
                  acc[static_cast<int64_t>(mi) * CM],
                  acc[static_cast<int64_t>(MS) * CM +
                    static_cast<int64_t>(k) * CM], CM);
            AscendC::PipeBarrier<PIPE_V>();
          }
        }
        if (doneMask == allMask) break;
      }
      for (int mi = 0; mi < MS; ++mi) {
        const int mStart = mi * CM;
        const int valid = OM - mStart < CM ? OM - mStart : CM;
        AscendC::ReduceSum<float>(sums[mi * 8],
                     acc[static_cast<int64_t>(mi) * CM], tmp, valid);
        AscendC::PipeBarrier<PIPE_V>();
      }
    } else {
    [[maybe_unused]] bool readyPrev = false;
    for (int32_t attempt = 0; attempt < SPLIT_POLL_LIMIT; ++attempt) {
      AscendC::DataCopyPad(flags, slots_[FLAG_OFF], fg, pad);
      const auto m2v = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
      AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(m2v);
      AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(m2v);
      const auto v2s = pipe_.FetchEventID(AscendC::HardEvent::V_S);
      AscendC::SetFlag<AscendC::HardEvent::V_S>(v2s);
      AscendC::WaitFlag<AscendC::HardEvent::V_S>(v2s);
      bool ready = true;
      for (int i = 0; i < TASKS; ++i) {
        if (flags.GetValue(i) != nonce_) {
          ready = false; break;
        }
      }
      if (ready) {
        if (!readyPrev) {
          readyPrev = true;
          continue;
        }
        break;
      }
      readyPrev = false;
    }
    auto gathered = gatherBuf_.Get<float>();
    AscendC::DataCopyExtParams rg{TASKS, CM * sizeof(float),
                   SLOT_BYTES - CM * sizeof(float), 0, 0};
    AscendC::DataCopyPad(gathered, slots_[0], rg, pad);
    const auto m2v = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(m2v);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(m2v);
    auto fold = foldBuf_.Get<float>();
    for (int mi = 0; mi < MS; ++mi) {
      const int first = (mi * NS) * CM;
      AscendC::Adds(fold, gathered[first], 0.0F, CM);
      AscendC::PipeBarrier<PIPE_V>();
      for (int ni = 1; ni < NS; ++ni) {
        const int off = (mi * NS + ni) * CM;
        AscendC::Max(fold, fold, gathered[off], CM);
        AscendC::PipeBarrier<PIPE_V>();
      }
      const int mStart = mi * CM;
      const int valid = OM - mStart < CM ? OM - mStart : CM;
      AscendC::ReduceSum<float>(sums[mi * 8], fold, tmp, valid);
      AscendC::PipeBarrier<PIPE_V>();
    }
    }
    const auto v2s = pipe_.FetchEventID(AscendC::HardEvent::V_S);
    AscendC::SetFlag<AscendC::HardEvent::V_S>(v2s);
    AscendC::WaitFlag<AscendC::HardEvent::V_S>(v2s);
    float total = 0.0F;
    for (int mi = 0; mi < MS; ++mi) total += sums[mi * 8].GetValue(0);
    const auto s2v = pipe_.FetchEventID(AscendC::HardEvent::S_V);
    AscendC::SetFlag<AscendC::HardEvent::S_V>(s2v);
    AscendC::WaitFlag<AscendC::HardEvent::S_V>(s2v);
    auto out = outBuf_.Get<float>();
    AscendC::Duplicate(out, total, 8);
    out.SetValue(1, sums[0 * 8].GetValue(0));
    out.SetValue(2, sums[1 * 8].GetValue(0));
    const auto v2m3 = pipe_.FetchEventID(AscendC::HardEvent::V_MTE3);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(v2m3);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(v2m3);
    AscendC::DataCopyExtParams one{1, 3 * sizeof(float), 0, 0, 0};
    AscendC::DataCopyPad(y_[0], out, one);
  }
  static constexpr int PF_BYTES = 16384;
  static constexpr int PF_ENTRY =
    PREFETCH == 2 ? 3 : PREFETCH == 3 ? 1 : PREFETCH == 4 ? 2 :
    PREFETCH == 5 ? 1 : PREFETCH == 6 ? 2 :
    PREFETCH == 7 ? 3 : PREFETCH == 8 ? 2 : PREFETCH == 9 ? 1 :
    PREFETCH == 10 ? 1 : 0;
  static constexpr int PF_DEFER =
    PREFETCH == 1 ? 3 : PREFETCH == 3 ? 2 : PREFETCH == 4 ? 1 :
    PREFETCH == 10 ? 2 : 0;
  static constexpr bool PF_ENTRY_FENCE = (PREFETCH < 7 || PREFETCH == 10);
  DeviceTiling* tilt_ = nullptr;
  const C10RtPlan* rtPlan_ = nullptr;
  int32_t blocks_ = 1, block_ = 0, bm_ = 0, bn_ = 0, bk_ = 128, iterateOrder_ = 0;
  bool pfDone_ = false;
  float nonce_ = 1.0F;
  AscendC::TPipe pipe_;
  AscendC::TQueBind<AscendC::TPosition::CO2, AscendC::TPosition::VECIN, 2> cQueue_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> tileMaxBuf_, fragMaxBuf_, scratchBuf_, nzAccumBuf_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> rowMaxBuf_, flagBuf_, gatherBuf_, foldBuf_, sumBuf_, reduceTmpBuf_;
  AscendC::TBuf<AscendC::TPosition::VECOUT> outBuf_;
  AscendC::TBuf<AscendC::TPosition::VECIN> pfBuf_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> nonceOut_;
  AscendC::TBuf<AscendC::TPosition::A1> padL1Buf_;
  AscendC::TBuf<AscendC::TPosition::A2> padA2Buf_;
  AscendC::TBuf<AscendC::TPosition::B2> padB2Buf_;
  AscendC::TBuf<AscendC::TPosition::CO1> padC1Buf_;
public:
  AscendC::Matmul<AType, BType, CType, BiasType, MmSel::value> mm_;
private:
  AscendC::GlobalTensor<T> x1_, x2_;
  AscendC::GlobalTensor<CD> asyncCache_, asyncCachePool_;
  AscendC::GlobalTensor<float> y_, slots_;
};
#define DECLARE_WIDE_ASYNC_KERNEL_V(NAME, TYPE, TX1, TX2, OM, ON, OK, MS, NS, CM, CN, \
                  CFGPTR, ST, MODE) \
extern "C" __global__ __mix__(1, 1) void NAME( \
  GM_ADDR x1, GM_ADDR x2, GM_ADDR y, __kfc_workspace__ GM_ADDR workspace, \
  GM_ADDR asyncCache, GM_ADDR tiles, int32_t blocks, \
  batch_matmul_max_sum_v3::DeviceTiling tiling, float nonce) \
{ \
  if ASCEND_IS_AIV { \
    if (AscendC::GetSubBlockIdx() == 0) { \
      AscendC::TPipe pfPipe; \
      AscendC::TBuf<AscendC::TPosition::VECIN> pfBuf; \
      pfPipe.InitBuffer(pfBuf, 32 * 1024); \
      auto pf = pfBuf.Get<TYPE>(); \
      const int64_t chunk = 16384; \
      const int32_t bid = static_cast<int32_t>(AscendC::GetBlockIdx()); \
      AscendC::DataCopyParams ip{8, 128, 0, 0}; \
      AscendC::DataCopyEnhancedParams ep; \
      ep.blockMode = AscendC::BlockMode::BLOCK_MODE_VECTOR; \
      AscendC::GlobalTensor<TYPE> g1; \
      g1.SetGlobalBuffer(reinterpret_cast<__gm__ TYPE*>(x1), static_cast<int64_t>(OM) * OK); \
      AscendC::GlobalTensor<TYPE> g2; \
      g2.SetGlobalBuffer(reinterpret_cast<__gm__ TYPE*>(x2), static_cast<int64_t>(ON) * OK); \
      const int64_t x1C = static_cast<int64_t>(OM) * OK / chunk; \
      const int64_t x2C = static_cast<int64_t>(ON) * OK / chunk; \
      for (int64_t c = bid; c < x1C; c += blocks) \
        AscendC::DataCopy(pf, g1[c * chunk], ip, ep); \
      for (int64_t c = bid; c < x2C; c += blocks) \
        AscendC::DataCopy(pf, g2[c * chunk], ip, ep); \
      const auto pfEv = pfPipe.FetchEventID(AscendC::HardEvent::MTE2_MTE3); \
      AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE3>(pfEv); \
      AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE3>(pfEv); \
    } \
  } \
  batch_matmul_max_sum_v3::CubeWideNDirect< \
    TYPE, TX1, TX2, OM, ON, OK, MS, NS, CM, CN, true, half, CFGPTR, ST, MODE> op; \
  op.Init(x1, x2, y, asyncCache, tiles, blocks, tiling, nonce); \
  REGIST_MATMUL_OBJ(op.Pipe(), GetSysWorkSpacePtr(), op.mm_, op.TilingFor(tiling)); \
  op.Process(); \
}
#define DECLARE_WIDE_ASYNC_KERNEL_VDP(NAME, TYPE, CDT, TX1, TX2, OM, ON, OK, MS, NS, \
                   CM, CN, CFGPTR, ST, MODE, SBM, SBN, SBK, TWEAK, CQD, PF, ...) \
extern "C" __global__ __mix__(1, 1) void NAME( \
  GM_ADDR x1, GM_ADDR x2, GM_ADDR y, __kfc_workspace__ GM_ADDR workspace, \
