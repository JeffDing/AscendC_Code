    auto a32f = calc[0].ReinterpretCast<float>();
    auto b32f = calc[512].ReinterpretCast<float>();
    auto zf   = calc[2048].ReinterpretCast<float>();
    auto btT  = calc[2368].ReinterpretCast<float>();
