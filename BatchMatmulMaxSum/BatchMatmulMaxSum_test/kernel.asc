inline bool BuildC10RtPlan(int32_t wb, C10RtPlan& plan, bool anyLevel = false)
{
  if (wb < 1) return false;
  if (wb > 64) wb = 64;
  static int32_t memoWb = -1;
  static bool memoOk = false;
  static bool memoAny = false;
  static C10RtPlan memoPlan{};
  if (memoWb == wb && memoAny == anyLevel) {
    if (memoOk) plan = memoPlan;
    return memoOk;
  }
  memoWb = wb;
  memoAny = anyLevel;
  memoOk = false;
  const int32_t stockUnits = ((32 + wb - 1) / wb) * 5;
  for (int32_t T = (160 + wb - 1) / wb;
    T < stockUnits + (anyLevel ? 1 : 0); ++T) {
    static bool reach[2][33][33];
    static int16_t pick[65][33][33];
    bool (*cur)[33] = reach[0];
    bool (*nxt)[33] = reach[1];
    for (int32_t a = 0; a <= 32; ++a)
      for (int32_t b = 0; b <= 32; ++b) cur[a][b] = false;
    cur[0][0] = true;
    for (int32_t k = 1; k <= wb; ++k)
      for (int32_t a = 0; a <= 32; ++a)
        for (int32_t b = 0; b <= 32; ++b) pick[k][a][b] = -1;
    for (int32_t k = 1; k <= wb; ++k) {
      for (int32_t a = 0; a <= 32; ++a)
        for (int32_t b = 0; b <= 32; ++b) nxt[a][b] = false;
      for (int32_t a = 0; a <= 32; ++a) {
        for (int32_t b = 0; b <= 32; ++b) {
          if (!cur[a][b]) continue;
          const int32_t iMax = (32 - a) < (T / 3) ? (32 - a) : (T / 3);
          for (int32_t i = 0; i <= iMax; ++i) {
            const int32_t rem = T - 3 * i;
            if (rem < 0) break;
            const int32_t jMax = (32 - b) < (rem / 2) ? (32 - b) : (rem / 2);
            for (int32_t j = 0; j <= jMax; ++j) {
              if (i >= 1 && j == 0) continue;
              if (nxt[a + i][b + j]) continue;
              nxt[a + i][b + j] = true;
              pick[k][a + i][b + j] = static_cast<int16_t>(i * 33 + j);
            }
          }
        }
      }
      bool (*sw)[33] = cur; cur = nxt; nxt = sw;
    }
    if (!cur[32][32]) continue;
    plan.cores = wb;
    int32_t a = 32, b = 32;
    for (int32_t k = wb; k >= 1; --k) {
      const int32_t code = pick[k][a][b];
      const int32_t i = code / 33, j = code % 33;
      a -= i; b -= j;
      plan.wOff[k - 1] = a;
      plan.nOff[k - 1] = b;
    }
    plan.wOff[wb] = 32;
    plan.nOff[wb] = 32;
    if (plan.wOff[1] == plan.wOff[0] && plan.nOff[1] == plan.nOff[0]) {
      for (int32_t c = 1; c < wb; ++c) {
        if (plan.wOff[c + 1] > plan.wOff[c] || plan.nOff[c + 1] > plan.nOff[c]) {
          const int32_t a0 = plan.wOff[1], b0 = plan.nOff[1];
          const int32_t ac = plan.wOff[c + 1] - plan.wOff[c];
          const int32_t bc = plan.nOff[c + 1] - plan.nOff[c];
          int32_t wPref[65], nPref[65];
          wPref[0] = nPref[0] = 0;
          for (int32_t k = 1; k <= wb; ++k) {
            int32_t ak = plan.wOff[k] - plan.wOff[k - 1];
            int32_t bk = plan.nOff[k] - plan.nOff[k - 1];
            if (k - 1 == 0) { ak = ac; bk = bc; }
            else if (k - 1 == c) { ak = a0; bk = b0; }
            wPref[k] = wPref[k - 1] + ak;
            nPref[k] = nPref[k - 1] + bk;
          }
          for (int32_t k = 0; k <= wb; ++k) {
            plan.wOff[k] = wPref[k];
            plan.nOff[k] = nPref[k];
          }
          break;
        }
      }
    }
    memoPlan = plan;
    memoOk = true;
    return true;
  }
  return false;
}
