template <typename T, int32_t M, int32_t N, int32_t K>
class VectorCase4PackNT {
  static_assert(M == 8, "m must be one fp32 datablock");
  static_assert(N == 16, "n must be one b16 datablock");
  static_assert(K % 16 == 0, "b16 16x16 transpose needs K%16==0");
  static constexpr uint32_t UB_RAW = 0;
  static constexpr uint32_t UB_BT = (K * M + N * K) * sizeof(T);
  static constexpr uint32_t UB_A32 = UB_BT + K * N * sizeof(T);
  static constexpr uint32_t UB_BT32 = UB_A32 + K * M * sizeof(float);
  static constexpr uint32_t UB_BIG = UB_BT32 + K * N * sizeof(float);
  static constexpr uint32_t UB_FOLD = UB_BIG + K * N * M * sizeof(float);
  static constexpr uint32_t UB_OUT = UB_FOLD + K * N * M / 2 * sizeof(float);
public:
  __aicore__ inline void Process(GM_ADDR x1, GM_ADDR x2, GM_ADDR y)
  {
    const int32_t batch = static_cast<int32_t>(AscendC::GetBlockIdx());
    AscendC::GlobalTensor<T> x1g, x2g;
    AscendC::GlobalTensor<float> yg;
    x1g.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1), 4 * K * M);
    x2g.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2), 4 * N * K);
    yg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y), 4);
    AscendC::LocalTensor<T> raw(AscendC::TPosition::VECCALC, UB_RAW,
                  K * M + N * K);
    AscendC::LocalTensor<T> bt(AscendC::TPosition::VECCALC, UB_BT, K * N);
    AscendC::LocalTensor<float> a32(AscendC::TPosition::VECCALC, UB_A32,
                    K * M);
    AscendC::LocalTensor<float> bt32(AscendC::TPosition::VECCALC, UB_BT32,
                    K * N);
    AscendC::LocalTensor<float> big(AscendC::TPosition::VECCALC, UB_BIG,
                    K * N * M);
    AscendC::LocalTensor<float> fold(AscendC::TPosition::VECCALC, UB_FOLD,
                    K * N * M / 2);
    AscendC::LocalTensor<float> out(AscendC::TPosition::VECCALC, UB_OUT, 8);
    AscendC::DataCopy(raw, x1g[batch * K * M], K * M);
    AscendC::DataCopy(raw[K * M], x2g[batch * N * K], N * K);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::Cast(a32, raw, AscendC::RoundMode::CAST_NONE, K * M);
    {
      auto srcU = raw[K * M].template ReinterpretCast<uint16_t>();
      auto dstU = bt.template ReinterpretCast<uint16_t>();
      uint64_t srcList[16];
      uint64_t dstList[16];
      const uint64_t sBase = reinterpret_cast<uint64_t>(srcU.GetPhyAddr());
      const uint64_t dBase = reinterpret_cast<uint64_t>(dstU.GetPhyAddr());
#pragma unroll
      for (int32_t i = 0; i < 16; ++i) {
        srcList[i] = sBase + static_cast<uint64_t>(i) * K * sizeof(uint16_t);
        dstList[i] = dBase + static_cast<uint64_t>(i) * N * sizeof(uint16_t);
      }
      AscendC::TransDataTo5HDParams tp;
      tp.dstHighHalf = false;
      tp.srcHighHalf = false;
      tp.repeatTimes = static_cast<uint8_t>(K / 16);
      tp.dstRepStride = static_cast<uint16_t>(16);
      tp.srcRepStride = static_cast<uint16_t>(1);
      AscendC::TransDataTo5HD<uint16_t>(dstList, srcList, tp);
    }
    AscendC::PipeBarrier<PIPE_V>();
    AscendC::Cast(bt32, bt, AscendC::RoundMode::CAST_NONE, K * N);
    AscendC::BrcbRepeatParams brp;
    brp.dstBlkStride = 1;
    brp.dstRepStride = 8;
    AscendC::Brcb(big, bt32, static_cast<uint8_t>(K * N / 16), brp);
    AscendC::Brcb(big[K * N * M / 2], bt32[K * N / 2],
           static_cast<uint8_t>(K * N / 16), brp);
    AscendC::BinaryRepeatParams mp;
    mp.dstBlkStride = 1;
    mp.src0BlkStride = 1;
    mp.src1BlkStride = 0;
    mp.dstRepStride = 16;
    mp.src0RepStride = 16;
    mp.src1RepStride = 1;
    AscendC::Mul(big, big, a32, static_cast<uint64_t>(64),
          static_cast<uint8_t>(K), mp);
    AscendC::Mul(big[64], big[64], a32, static_cast<uint64_t>(64),
          static_cast<uint8_t>(K), mp);
    AscendC::Add(fold, big, big[8192], 8192);
    AscendC::Add(fold, fold, fold[4096], 4096);
    AscendC::Add(fold, fold, fold[2048], 2048);
    AscendC::Add(fold, fold, fold[1024], 1024);
    AscendC::Add(fold, fold, fold[512], 512);
    AscendC::Add(fold, fold, fold[256], 256);
    AscendC::Add(fold, fold, fold[128], 128);
    AscendC::Max(fold, fold, fold[64], 64);
    AscendC::Max(fold, fold, fold[32], 32);
    AscendC::Max(fold, fold, fold[16], 16);
    AscendC::Max(fold, fold, fold[8], 8);
    AscendC::WholeReduceSum<float>(out, fold, M, 1, 1, 1, 8);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    const AscendC::DataCopyExtParams one{1, sizeof(float), 0, 0, 0};
    AscendC::DataCopyPad(yg[batch], out, one);
  }
};
