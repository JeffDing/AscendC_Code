template <typename IN>
__global__ __mix__(1, 1) void batch_matmul_case1_gemv(GM_ADDR x1, GM_ADDR x2,
                        GM_ADDR y, GM_ADDR scratch)
{
  if ASCEND_IS_AIV { return; }
  constexpr int32_t K = 32;
  AscendC::TPipe pipe;
  AscendC::TQue<AscendC::TPosition::A1, 1> a1Q;
  AscendC::TQue<AscendC::TPosition::B1, 1> b1Q;
  AscendC::TQue<AscendC::TPosition::A2, 2> a2Q;
  AscendC::TQue<AscendC::TPosition::B2, 2> b2Q;
  AscendC::TQue<AscendC::TPosition::CO1, 2> c1Q;
  AscendC::TBuf<AscendC::TPosition::VECCALC> calc;
  pipe.InitBuffer(a1Q, 1, 512);
  pipe.InitBuffer(b1Q, 1, 1024);
  pipe.InitBuffer(a2Q, 2, 512);
  pipe.InitBuffer(b2Q, 2, 512);
  pipe.InitBuffer(c1Q, 2, 1024);
  pipe.InitBuffer(calc, 64);
  AscendC::GlobalTensor<IN> ag;
#if defined(BMM_C1G_DBG) && BMM_C1G_DBG == 7
  ag.SetGlobalBuffer(reinterpret_cast<__gm__ IN*>(x2), K);
#else
  ag.SetGlobalBuffer(reinterpret_cast<__gm__ IN*>(x1), K);
#endif
  AscendC::GlobalTensor<IN> bg;
  bg.SetGlobalBuffer(reinterpret_cast<__gm__ IN*>(x2), K);
  auto a1 = a1Q.AllocTensor<IN>();
#if defined(BMM_C1G_DBG) && BMM_C1G_DBG == 8
  {
    AscendC::Nd2NzParams p;
    p.ndNum = 1;
    p.nValue = 16;
    p.dValue = 32;
    p.srcNdMatrixStride = 0;
    p.srcDValue = 32;
    p.dstNzC0Stride = 16;
    p.dstNzNStride = 1;
    p.dstNzMatrixStride = 0;
    AscendC::DataCopy(a1, ag, p);
  }
#else
  {
    const AscendC::DataCopyExtParams cp{1, 64, 0, 0, 0};
    AscendC::DataCopyPadExtParams<IN> pad{};
    AscendC::DataCopyPad(a1, ag, cp, pad);
  }
#endif
  a1Q.EnQue(a1);
  a1 = a1Q.DeQue<IN>();
  auto b1 = b1Q.AllocTensor<IN>();
  {
    AscendC::Nd2NzParams p;
    p.ndNum = 1;
    p.nValue = 32;
    p.dValue = 1;
    p.srcNdMatrixStride = 0;
    p.srcDValue = 1;
    p.dstNzC0Stride = 32;
    p.dstNzNStride = 1;
    p.dstNzMatrixStride = 0;
    AscendC::DataCopy(b1, bg, p);
  }
  b1Q.EnQue(b1);
  b1 = b1Q.DeQue<IN>();
  auto a2 = a2Q.AllocTensor<IN>();
#if defined(BMM_C1G_DBG) && BMM_C1G_DBG == 8
  {
    AscendC::LoadData3DParamsV2<IN> p;
    p.l1H = 1;
    p.l1W = 16;
    p.channelSize = 32;
    p.kExtension = 32;
    p.mExtension = 16;
    p.kStartPt = 0;
    p.mStartPt = 0;
    p.strideW = 1; p.strideH = 1; p.filterW = 1; p.filterH = 1;
    p.dilationFilterW = 1; p.dilationFilterH = 1;
    p.enTranspose = false;
    p.enSmallK = false;
    p.padValue = static_cast<IN>(0.0F);
    p.filterSizeW = false; p.filterSizeH = false;
    p.fMatrixCtrl = false;
    AscendC::LoadData(a2, a1, p);
  }
#else
  {
    AscendC::LoadData2DParams p;
    p.startIndex = 0;
    p.repeatTimes = 1;
    p.srcStride = 1;
    p.dstGap = 0;
    p.ifTranspose = false;
    AscendC::LoadData(a2, a1, p);
  }
#endif
#if 0
  {
    AscendC::LoadData3DParamsV2<IN> p;
    p.l1H = 1;
    p.l1W = 1;
    p.channelSize = 32;
    p.kExtension = 32;
    p.mExtension = 1;
    p.kStartPt = 0;
    p.mStartPt = 0;
    p.strideW = 1; p.strideH = 1; p.filterW = 1; p.filterH = 1;
    p.dilationFilterW = 1; p.dilationFilterH = 1;
    p.enTranspose = false;
    p.enSmallK = false;
    p.padValue = static_cast<IN>(0.0F);
    p.filterSizeW = false; p.filterSizeH = false;
    p.fMatrixCtrl = false;
    AscendC::LoadData(a2, a1, p);
  }
#endif
  a2Q.EnQue(a2);
  auto b2 = b2Q.AllocTensor<IN>();
#if defined(BMM_C1G_DBG) && BMM_C1G_DBG == 9
  {
    const uint8_t padList[4] = {0, 0, 0, 0};
    AscendC::SetFmatrix(1, 32, padList,
              AscendC::FmatrixMode::FMATRIX_RIGHT);
    AscendC::LoadData3DParamsV2Pro p;
    p.channelSize = 16;
    p.enTranspose = false;
    p.enSmallK = false;
    p.filterSizeW = false;
    p.filterSizeH = false;
    p.fMatrixCtrl = true;
    p.extConfig = (0ull << 48) | (0ull << 32) | (32ull << 16) | 16ull;
    p.filterConfig = 0X10101010101ull;
    AscendC::LoadData(b2, b1, p);
  }
#else
  for (int kb = 0; kb < 2; ++kb) {
    AscendC::LoadData2DParams p;
    p.repeatTimes = 1;
    p.startIndex = 0;
    p.dstGap = 0;
    p.srcStride = 0;
    p.ifTranspose = true;
    AscendC::LoadData(b2[kb * 256], b1[kb * 256], p);
  }
#endif
  b2Q.EnQue(b2);
  a2 = a2Q.DeQue<IN>();
  b2 = b2Q.DeQue<IN>();
  auto c1 = c1Q.AllocTensor<float>();
  AscendC::MmadParams mp;
#if defined(BMM_C1G_DBG) && BMM_C1G_DBG == 8
  mp.m = 16;
#else
  mp.m = 1;
#endif
  mp.n = 1;
  mp.k = 32;
  mp.cmatrixInitVal = true;
  AscendC::Mmad(c1, a2, b2, mp);
  AscendC::PipeBarrier<PIPE_M>();
  c1Q.EnQue(c1);
  auto cc = c1Q.DeQue<float>();
  AscendC::GlobalTensor<float> sg;
  sg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scratch), 256);
  AscendC::FixpipeParamsV220 fp;
  fp.nSize = 16;
  fp.mSize = 16;
  fp.srcStride = 16;
  fp.dstStride = 16;
  fp.reluEn = false;
  fp.quantPre = QuantMode_t::NoQuant;
  fp.ndNum = 1;
  fp.srcNdStride = 0;
  fp.dstNdStride = 0;
  fp.unitFlag = 0;
  AscendC::Fixpipe(sg, cc, fp);
  c1Q.FreeTensor(cc);
  a2Q.FreeTensor(a2);
  b2Q.FreeTensor(b2);
  a1Q.FreeTensor(a1);
  b1Q.FreeTensor(b1);
  AscendC::PipeBarrier<PIPE_ALL>();
  auto cv = calc.Get<float>();
  AscendC::GlobalTensor<float> ygm;
  ygm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y), 64);
  for (int attempt = 0; attempt < 2; ++attempt) {
    AscendC::DataCopy(cv, sg, 8);
    const auto ld = pipe.FetchEventID(AscendC::HardEvent::MTE2_M);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_M>(ld);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_M>(ld);
    if (attempt == 0) AscendC::PipeBarrier<PIPE_ALL>();
  }
#if defined(BMM_C1G_DBG) && BMM_C1G_DBG == 1
  ygm.SetValue(0, 12345.0F);
#elif defined(BMM_C1G_DBG) && BMM_C1G_DBG == 2
  ygm.SetValue(0, cc.GetValue(0));
#else
  const float out = cv.GetValue(0);
  ygm.SetValue(0, out);
#endif
  AscendC::PipeBarrier<PIPE_ALL>();
}
extern "C" __global__ __cube__ void batch_matmul_case1_scalar_fp16(
  GM_ADDR x1, GM_ADDR x2, GM_ADDR y)
{
  __gm__ half* a = reinterpret_cast<__gm__ half*>(x1);
  __gm__ half* b = reinterpret_cast<__gm__ half*>(x2);
  __gm__ float* yo = reinterpret_cast<__gm__ float*>(y);
  float acc = 0.f;
  for (int k = 0; k < 32; ++k)
    acc += static_cast<float>(a[k]) * static_cast<float>(b[k]);
  *yo = acc;
}
