#define DECLARE_CASE1_NP_KERNEL(NAME, TYPE, KK) \
extern "C" __global__ __vector__ void NAME(GM_ADDR x1, GM_ADDR x2, GM_ADDR y) \
{ \
  AscendC::GlobalTensor<TYPE> x1g, x2g; \
  AscendC::GlobalTensor<float> yg; \
  x1g.SetGlobalBuffer(reinterpret_cast<__gm__ TYPE*>(x1), KK); \
  x2g.SetGlobalBuffer(reinterpret_cast<__gm__ TYPE*>(x2), KK); \
  yg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y), 8); \
  AscendC::LocalTensor<TYPE>  raw (AscendC::TPosition::VECCALC,   0, 2 * (KK)); \
  AscendC::LocalTensor<float> f32 (AscendC::TPosition::VECCALC, 128, 2 * (KK)); \
  AscendC::LocalTensor<float> prod(AscendC::TPosition::VECCALC, 384, (KK)); \
  AscendC::LocalTensor<float> out (AscendC::TPosition::VECCALC, 512, 8); \
  AscendC::DataCopy(raw, x1g, (KK)); \
  AscendC::DataCopy(raw[(KK)], x2g, (KK)); \
  AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0); \
  AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0); \
  AscendC::Cast(f32, raw, AscendC::RoundMode::CAST_NONE, 2 * (KK)); \
  AscendC::Mul(prod, f32, f32[(KK)], (KK)); \
  AscendC::WholeReduceSum<float>(out, prod, (KK), 1, 1, 1, 8); \
  AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0); \
  AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0); \
  const AscendC::DataCopyExtParams one{1, sizeof(float), 0, 0, 0}; \
  AscendC::DataCopyPad(yg[0], out, one); \
}
DECLARE_CASE1_NP_KERNEL(batch_matmul_case1_np_fp16, half, 32)
#undef DECLARE_CASE1_NP_KERNEL
extern "C" __global__ __vector__ void batch_matmul_case1_npgm_fp16(
  GM_ADDR base, GM_ADDR x2, GM_ADDR y, int64_t swap)
{
  (void)x2;
  AscendC::GlobalTensor<half> bg;
  AscendC::GlobalTensor<float> yg;
  bg.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(base), 64);
  yg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y), 8);
  AscendC::LocalTensor<half>  raw (AscendC::TPosition::VECCALC,   0, 64);
  AscendC::LocalTensor<float> f32 (AscendC::TPosition::VECCALC, 128, 64);
  AscendC::LocalTensor<float> prod(AscendC::TPosition::VECCALC, 384, 32);
  AscendC::LocalTensor<float> out (AscendC::TPosition::VECCALC, 512, 8);
  AscendC::DataCopy(raw, bg, 64);
  AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
  AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
  AscendC::Cast(f32, raw, AscendC::RoundMode::CAST_NONE, 64);
  if (swap)
    AscendC::Mul(prod, f32[32], f32, 32);
  else
    AscendC::Mul(prod, f32, f32[32], 32);
  AscendC::WholeReduceSum<float>(out, prod, 32, 1, 1, 1, 8);
  AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
  AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
  const AscendC::DataCopyExtParams one{1, sizeof(float), 0, 0, 0};
  AscendC::DataCopyPad(yg[0], out, one);
}
