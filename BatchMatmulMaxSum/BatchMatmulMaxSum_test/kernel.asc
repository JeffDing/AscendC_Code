namespace batch_matmul_max_sum_v3 {
template <bool TX1, int OM_, int ON_, int OK_, int MS_, int NS_, int CM_, int CN_>
class CubeS5Hand {
public:
  static constexpr int TASKS = MS_ * NS_;
  static constexpr int SLOT_FLOATS = ((CM_ + 1 + 31) / 32) * 32;
  static constexpr int SLOT_BYTES = SLOT_FLOATS * sizeof(float);
  static constexpr int FLAG_OFF = CM_;
  static constexpr int CACHE_CM = (CM_ + 127) / 128 * 128;
  static constexpr int CACHE_CN = (CN_ + 15) / 16 * 16;
  static constexpr int CACHE_ELEMS = CACHE_CM * CACHE_CN;
  static constexpr int BM = 128, BN = 128, BK = 128;
  static constexpr int SLAB_K = 256;
  static constexpr int SLABS = OK_ / SLAB_K;
  static constexpr int MTS = (CM_ + BM - 1) / BM;
  static constexpr int NTS = (CN_ + BN - 1) / BN;
  static constexpr int NF = BN / 16;
  static constexpr int KF_SLAB = SLAB_K / 16;
  static constexpr int A_SLAB_ELEMS = KF_SLAB * BM * 16;
  static constexpr int B_SLAB_ELEMS = KF_SLAB * BN * 16;
  static constexpr int A2_ELEMS = BM * BK;
  static constexpr int B2_ELEMS = BK * BN;
  static constexpr int C1_ELEMS = BM * BN;
  static constexpr int CCHUNK = 64;
  static constexpr uint16_t SYNC_FLAG = 2;
  __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR ac,
                GM_ADDR tiles, int32_t blocks, float nonce,
                int32_t allocMode = 9, int32_t mode = 9)
  {
    blocks_ = blocks;
    mode = BaseMode(mode);
    s5NoQuantMode = (mode == 81);
    s5FixForm = (mode == 82 || mode == 52) ? ((mode == 52) ? 52 : 2) : 0;
    s5SrcStrideBn = (mode == 92);
    s5CompactTail = (mode == 9 || mode == 94 || mode == 96 || mode == 97 ||
            PEngine(mode));
    nonce_ = nonce;
    block_ = static_cast<int32_t>(AscendC::GetBlockIdx());
    x1_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(x1),
              static_cast<int64_t>(OM_) * OK_);
    x2_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(x2),
              static_cast<int64_t>(ON_) * OK_);
    y_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y), 2048);
    slots_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(tiles),
               static_cast<int64_t>(TASKS) * SLOT_FLOATS);
    cachePool_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(ac),
                 static_cast<int64_t>(TASKS) * CACHE_ELEMS);
    if ASCEND_IS_AIC {
      if (allocMode >= 1)
        for (int q = 0; q < SLABS; ++q)
          pipe_.InitBuffer(a1Q_[q], 1, A_SLAB_ELEMS * sizeof(half));
      if (allocMode >= 2) {
        pipe_.InitBuffer(b1Q_[0], 1, B_SLAB_ELEMS * sizeof(half));
        pipe_.InitBuffer(b1Q_[1], 1, B_SLAB_ELEMS * sizeof(half));
        if (PBd3(mode))
          pipe_.InitBuffer(b1Q_[2], 1, B_SLAB_ELEMS * sizeof(half));
      }
      if (allocMode >= 3) pipe_.InitBuffer(a2Q_, 2, A2_ELEMS * sizeof(half));
      if (allocMode >= 4) pipe_.InitBuffer(b2Q_, 2, B2_ELEMS * sizeof(half));
      if (allocMode >= 5) pipe_.InitBuffer(c1Q_, 2, C1_ELEMS * sizeof(float));
      return;
    }
    pipe_.InitBuffer(cacheQ_, 2, CCHUNK * CACHE_CN * sizeof(half));
    pipe_.InitBuffer(fragMaxBuf_, CCHUNK * 2);
    pipe_.InitBuffer(tileMaxBuf_, CCHUNK * sizeof(float));
    pipe_.InitBuffer(scratchBuf_, CCHUNK * 24 * sizeof(float));
    pipe_.InitBuffer(rowMaxBuf_, (CM_ + 8) * sizeof(float));
    pipe_.InitBuffer(flagBuf_, TASKS * SPLIT_UB_SLOT_FLOATS * sizeof(float));
    pipe_.InitBuffer(gatherBuf_, TASKS * CM_ * sizeof(float));
    pipe_.InitBuffer(verifyBuf_, TASKS * CM_ * sizeof(float));
    pipe_.InitBuffer(foldBuf_, CM_ * sizeof(float));
    pipe_.InitBuffer(sumBuf_, MS_ * 8 * sizeof(float));
    pipe_.InitBuffer(reduceTmpBuf_, SHORT_REDUCE_TMP_BYTES);
    pipe_.InitBuffer(outBuf_, 32);
  }
  __aicore__ inline void Process(int32_t mode = 9)
  {
    if (block_ >= blocks_) return;
    const int32_t bm = BaseMode(mode);
    if ASCEND_IS_AIC {
      if (PEngine(bm)) ComputeP(block_, mode);
      else Compute(block_, bm);
      return;
    }
    if (mode >= 58 && mode != 83 && mode != 87 && mode != 84 && mode != 92 &&
      mode != 94 && mode != 96 && mode != 97 && mode != 9 &&
      mode != 116 && mode != 117 && mode != 119 && mode < 120)
      return;
    if (AscendC::GetSubBlockIdx() != 0) return;
    if (mode == 116) {
      ReduceNoWait(block_);
      AscendC::SyncAll();  // Publish 写全局可见后才 Fold
      Publish(block_);
      if (block_ == 0) Fold();
      return;
    }
    if (mode == 119) {
      WaitBands(block_);
      AscendC::SyncAll();  // Publish 写全局可见后才 Fold
      Publish(block_);
      if (block_ == 0) Fold();
      return;
    }
    if (mode == 117) {
      ReduceInc(block_);
      AscendC::SyncAll();  // Publish 写全局可见后才 Fold
      Publish(block_);
      return;
    }
    if (PCoarse(mode)) {
      ReduceCoarse(block_);
      AscendC::SyncAll();  // Publish 写全局可见后才 Fold
      Publish(block_, mode);
      if (block_ == 0) Fold();
      return;
    }
    if (PFine(mode)) {
      ReduceFine(block_);
      AscendC::SyncAll();  // Publish 写全局可见后才 Fold
      Publish(block_, mode);
      if (block_ == 0) Fold();
      return;
    }
    if (FoldInc(mode)) {
      ReduceInc(block_, mode);
      AscendC::SyncAll();  // Publish 写全局可见后才 Fold
      Publish(block_, mode);
      if (block_ == (blocks_ >= TASKS ? TASKS - 1 : 0)) FoldIncremental();
      return;
    }
    if (PInc(bm) || mode >= 120) {
      ReduceInc(block_, mode);
      AscendC::SyncAll();  // Publish 写全局可见后才 Fold
      Publish(block_, mode);
      if (block_ == 0) Fold();
      return;
    }
    AscendC::CrossCoreWaitFlag<2, PIPE_MTE2>(SYNC_FLAG);
    if (mode == 97) {
      for (volatile int i = 0; i < 30000; ++i) { }
    }
    if (mode >= 9) {
      ReduceCache(block_);
    }
    AscendC::SyncAll();  // Publish 写全局可见后才 Fold
    Publish(block_);
    if (block_ == 0) Fold();
  }
private:
  __aicore__ inline void StageA(const AscendC::LocalTensor<half>& dst,
                 int32_t mRow, int32_t mv, int s)
  {
    AscendC::Nd2NzParams p;
    p.ndNum = 1;
    p.nValue = mv;
    p.dValue = SLAB_K;
    p.srcNdMatrixStride = 0;
    p.srcDValue = OK_;
    p.dstNzC0Stride = s5CompactTail ? mv : BM;
    p.dstNzNStride = 1;
    p.dstNzMatrixStride = 0;
    AscendC::DataCopy(dst, x1_[static_cast<int64_t>(mRow) * OK_ + s * SLAB_K], p);
  }
  __aicore__ inline void StageB(const AscendC::LocalTensor<half>& dst,
                 int32_t nRow, int s)
  {
    AscendC::Nd2NzParams p;
    p.ndNum = 1;
    p.nValue = BN;
    p.dValue = SLAB_K;
    p.srcNdMatrixStride = 0;
    p.srcDValue = OK_;
    p.dstNzC0Stride = BN;
    p.dstNzNStride = 1;
    p.dstNzMatrixStride = 0;
    AscendC::DataCopy(dst, x2_[static_cast<int64_t>(nRow) * OK_ + s * SLAB_K], p);
  }
  __aicore__ inline void LoadA(const AscendC::LocalTensor<half>& a2,
                const AscendC::LocalTensor<half>& a1,
                int32_t mv, int kh)
  {
    AscendC::LoadData3DParamsV2<half> p;
    p.l1H = 1;
    p.l1W = static_cast<uint16_t>(mv);
    p.channelSize = SLAB_K;
    p.kExtension = BK;
    p.mExtension = static_cast<uint16_t>(mv);
    p.kStartPt = static_cast<uint16_t>(kh * BK);
    p.mStartPt = 0;
    p.strideW = 1;
    p.strideH = 1;
    p.filterW = 1;
    p.filterH = 1;
    p.dilationFilterW = 1;
    p.dilationFilterH = 1;
    p.enTranspose = TX1;
    p.enSmallK = false;
    p.padValue = static_cast<half>(0.0F);
    p.filterSizeW = false;
    p.filterSizeH = false;
    p.fMatrixCtrl = false;
    AscendC::LoadData(a2, a1, p);
  }
  __aicore__ inline void LoadB(const AscendC::LocalTensor<half>& b2,
                const AscendC::LocalTensor<half>& b1,
                int s, int kh)
  {
    (void)s;
    const int kfg0 = kh * NF;
    AscendC::LoadData2DParams p;
    p.repeatTimes = static_cast<uint8_t>(NF * (BK / 16));
    p.startIndex = 0;
    p.dstGap = 0;
    p.srcStride = 1;
    p.ifTranspose = false;
    AscendC::LoadData(b2, b1[static_cast<int64_t>(kfg0) * B_SLAB_ELEMS / KF_SLAB], p);
  }
  __aicore__ inline void FixpipeTile(int32_t task, int32_t m0, int32_t mv, int32_t n0,
                    const AscendC::LocalTensor<float>& c)
  {
    const bool s5C15Form = s5FixForm;
    const bool s5NoQuant = s5NoQuantMode || s5C15Form;
    AscendC::FixpipeParamsV220 fp;
    fp.nSize = BN;
    fp.mSize = static_cast<uint16_t>(mv);
    fp.srcStride = static_cast<uint16_t>(s5SrcStrideBn ? BN : mv);
    fp.dstStride = CACHE_CN;
    fp.reluEn = false;
    fp.quantPre = s5NoQuant ? QuantMode_t::NoQuant : QuantMode_t::F322F16;
    fp.ndNum = 1;
    fp.srcNdStride = 0;
    fp.dstNdStride = 0;
    fp.unitFlag = 0;
    if (s5C15Form) {
      fp.nSize = 128; fp.mSize = 128; fp.srcStride = 128; fp.dstStride = 128;
    }
    cache_.SetGlobalBuffer(cachePool_.GetPhyAddr(
      static_cast<uint64_t>(task) * CACHE_ELEMS), CACHE_ELEMS);
    AscendC::Fixpipe(cache_[static_cast<int64_t>(m0) * CACHE_CN + n0], c, fp);
  }
  static __aicore__ inline bool PEngine(int32_t m) { return m >= 10 && m <= 20; }
  static __aicore__ inline bool PInc(int32_t m)
  { return m == 11 || m == 13 || m == 14 || m == 17 || m == 18 || m == 20; }
  static __aicore__ inline bool PL0la(int32_t m) { return m == 10 || m == 11; }
  static __aicore__ inline bool PAStag(int32_t m)
  { return m == 14 || m == 15 || m == 18 || m == 19 || m == 20; }
  static __aicore__ inline bool PBd3(int32_t m)
  { return (m >= 16 && m <= 19) || m == 20; }
  static __aicore__ inline int BaseMode(int32_t m)
  { return (m >= 100 && m <= 199) ? 18 : m; }
  static __aicore__ inline bool PubMerge(int32_t m) { return m == 123; }
  static __aicore__ inline bool NoFixM(int32_t m) { return m == 125; }
  static __aicore__ inline bool PFine(int32_t m) { return m == 127; }
  static __aicore__ inline bool PCoarse(int32_t m) { return m == 128; }
  static __aicore__ inline bool AHead3(int32_t m) { return m == 126; }
  static __aicore__ inline bool FoldInc(int32_t m) { return m == 129; }
  static __aicore__ inline bool PXmt(int32_t m) { return m == 20; }
  __aicore__ inline void IssueB(int j, int32_t nStart, int slot)
  {
    const int nt = j / SLABS, sb = j % SLABS;
    auto b1 = b1Q_[slot].template AllocTensor<half>();
    StageB(b1, nStart + nt * BN, sb);
    b1Q_[slot].EnQue(b1);
  }
  __aicore__ inline void IssueA(int q, int32_t mAbs, int32_t mv)
  {
    auto a1 = a1Q_[q].template AllocTensor<half>();
    StageA(a1, mAbs, mv, q);
    a1Q_[q].EnQue(a1);
  }
  __aicore__ inline void ComputeP(int32_t task, int32_t mode)
  {
    const int32_t bm = BaseMode(mode);
    const int32_t mi = task / NS_;
    const int32_t ni = task % NS_;
    const int32_t mStart = mi * CM_;
    const int32_t nStart = ni * CN_;
    const int32_t validM = OM_ - mStart < CM_ ? OM_ - mStart : CM_;
    const int32_t validN = ON_ - nStart < CN_ ? ON_ - nStart : CN_;
    const bool inc = PInc(bm);
    const bool l0la = PL0la(bm);
    const bool aStag = PAStag(bm);
    const int BDEP = PBd3(bm) ? 3 : 2;
    const bool xmt = PXmt(bm);
    const bool noFixM = NoFixM(mode);
    const bool fine = inc && PFine(mode);
    if (validM <= 0 || validN <= 0) {
      AscendC::CrossCoreSetFlag<2, PIPE_FIX>(SYNC_FLAG);
      return;
    }
    const int ntEff = (validN + BN - 1) / BN < NTS ? (validN + BN - 1) / BN : NTS;
    const int NJ = ntEff * SLABS;
    AscendC::LocalTensor<half> aSlab[SLABS];
    AscendC::LocalTensor<half> a2v[2], b2v[2];
    int bslot = 0;
    const int mtEff = (validM + BM - 1) / BM < MTS ? (validM + BM - 1) / BM : MTS;
    for (int mt = 0; mt < mtEff; ++mt) {
      const int32_t m0 = mt * BM;
      const int32_t mv = validM - m0 < BM ? validM - m0 : BM;
      if (!xmt || mt == 0) IssueB(0, nStart, bslot);
      const int aAhead = aStag ? (AHead3(mode) ? 3 : 2) : SLABS;
      for (int q = 0; q < aAhead; ++q) IssueA(q, mStart + m0, mv);
      for (int nt = 0; nt < ntEff; ++nt) {
        const int32_t n0 = nt * BN;
        const int32_t nv = validN - n0 < BN ? validN - n0 : BN;
        auto c1 = c1Q_.template AllocTensor<float>();
        for (int sb = 0; sb < SLABS; ++sb) {
          const int j = nt * SLABS + sb;
          const int cur = bslot;
          const bool haveNext = (j + 1 < NJ) || (xmt && mt + 1 < mtEff);
          if (haveNext) {
            bslot = bslot + 1 == BDEP ? 0 : bslot + 1;
            IssueB(j + 1 < NJ ? j + 1 : 0, nStart, bslot);
          }
          if (nt == 0) {
            if (aStag && sb + aAhead < SLABS)
              IssueA(sb + aAhead, mStart + m0, mv);
            aSlab[sb] = a1Q_[sb].template DeQue<half>();
          }
          auto b1 = b1Q_[cur].template DeQue<half>();
          if (l0la) {
            for (int kh = 0; kh < 2; ++kh) {
              a2v[kh] = a2Q_.template AllocTensor<half>();
              LoadA(a2v[kh], aSlab[sb], mv, kh);
              a2Q_.EnQue(a2v[kh]);
              b2v[kh] = b2Q_.template AllocTensor<half>();
              LoadB(b2v[kh], b1, sb, kh);
              b2Q_.EnQue(b2v[kh]);
            }
            for (int kh = 0; kh < 2; ++kh) {
              auto a2 = a2Q_.template DeQue<half>();
              auto b2 = b2Q_.template DeQue<half>();
              AscendC::MmadParams mp;
              mp.m = static_cast<uint16_t>(mv);
              mp.n = static_cast<uint16_t>(nv);
              mp.k = BK;
              mp.cmatrixInitVal = (sb == 0 && kh == 0);
              AscendC::Mmad(c1, a2, b2, mp);
              a2Q_.FreeTensor(a2);
              b2Q_.FreeTensor(b2);
            }
          } else {
            for (int kh = 0; kh < 2; ++kh) {
              auto a2 = a2Q_.template AllocTensor<half>();
              LoadA(a2, aSlab[sb], mv, kh);
              a2Q_.EnQue(a2);
              auto b2 = b2Q_.template AllocTensor<half>();
              LoadB(b2, b1, sb, kh);
              b2Q_.EnQue(b2);
              a2 = a2Q_.template DeQue<half>();
              b2 = b2Q_.template DeQue<half>();
              AscendC::MmadParams mp;
              mp.m = static_cast<uint16_t>(mv);
              mp.n = static_cast<uint16_t>(nv);
              mp.k = BK;
              mp.cmatrixInitVal = (sb == 0 && kh == 0);
              AscendC::Mmad(c1, a2, b2, mp);
              a2Q_.FreeTensor(a2);
              b2Q_.FreeTensor(b2);
            }
          }
          b1Q_[cur].FreeTensor(b1);
        }
        c1Q_.EnQue(c1);
        auto cc = c1Q_.template DeQue<float>();
        FixpipeTile(task, m0, mv, n0, cc);
        c1Q_.FreeTensor(cc);
        if (fine) {
          const auto fb = static_cast<event_t>(
            pipe_.FetchEventID(AscendC::HardEvent::FIX_M));
          AscendC::SetFlag<AscendC::HardEvent::FIX_M>(fb);
          AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(fb);
          AscendC::CrossCoreSetFlag<2, PIPE_FIX>(SYNC_FLAG);
        }
      }
      for (int q = 0; q < SLABS; ++q) a1Q_[q].FreeTensor(aSlab[q]);
      if (inc && !fine) {
        if (!noFixM) {
          const auto fb = static_cast<event_t>(
            pipe_.FetchEventID(AscendC::HardEvent::FIX_M));
          AscendC::SetFlag<AscendC::HardEvent::FIX_M>(fb);
          AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(fb);
        }
        AscendC::CrossCoreSetFlag<2, PIPE_FIX>(SYNC_FLAG);
      }
    }
    if (inc) return;
    const auto fixed = static_cast<event_t>(
      pipe_.FetchEventID(AscendC::HardEvent::FIX_M));
    AscendC::SetFlag<AscendC::HardEvent::FIX_M>(fixed);
    AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(fixed);
    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::CrossCoreSetFlag<2, PIPE_FIX>(SYNC_FLAG);
  }
  __aicore__ inline void Compute(int32_t task, int32_t mode)
  {
    const int32_t mi = task / NS_;
    const int32_t ni = task % NS_;
    const int32_t mStart = mi * CM_;
    const int32_t nStart = ni * CN_;
    const int32_t validM = OM_ - mStart < CM_ ? OM_ - mStart : CM_;
    const int32_t validN = ON_ - nStart < CN_ ? ON_ - nStart : CN_;
    if (validM <= 0 || validN <= 0 || mode <= 5) {
      AscendC::CrossCoreSetFlag<2, PIPE_FIX>(SYNC_FLAG);
      return;
    }
    AscendC::LocalTensor<half> aSlab[SLABS];
    const int mtLo = (mode == 72) ? (MTS - 1) : 0;
    const int mtHi = (mode >= 51 && mode <= 65) ? mtLo + 1 : MTS;
    for (int mt = mtLo; mt < mtHi && mt * BM < validM; ++mt) {
      const int32_t m0 = mt * BM;
      const int32_t mv = s5CompactTail
        ? (validM - m0 < BM ? validM - m0 : BM) : BM;
      for (int q = 0; q < SLABS; ++q) {
        auto a1 = a1Q_[q].template AllocTensor<half>();
        StageA(a1, mStart + m0, mv, q);
        a1Q_[q].EnQue(a1);
      }
      for (int q = 0; q < SLABS; ++q) aSlab[q] = a1Q_[q].template DeQue<half>();
      if (mode == 6 || mode == 73) {
        for (int q = 0; q < SLABS; ++q) a1Q_[q].FreeTensor(aSlab[q]);
        continue;
      }
      if (mode == 73 || (mode == 76 && mt >= 1)) {
        for (int q = 0; q < SLABS; ++q) a1Q_[q].FreeTensor(aSlab[q]);
        continue;
      }
      const bool s5FullSweep = (mode == 92 || mode == 94 || mode == 96 || mode == 97);
      const int ntEnd = (mode == 51 || mode == 87) ? 2
        : (mode == 7 || (mode >= 66 && !s5FullSweep) || mode == 42) ? 1 : NTS;
      for (int nt = 0; nt < ntEnd; ++nt) {
        const int32_t n0 = nt * BN;
        const int32_t nv = validN - n0 < BN ? validN - n0 : BN;
        if (nv <= 0) break;
        if (mode == 62) {
          auto b1 = b1Q_[0].template AllocTensor<half>();
          StageB(b1, nStart + n0, 0);
          b1Q_[0].EnQue(b1);
          b1 = b1Q_[0].template DeQue<half>();
          b1Q_[0].FreeTensor(b1);
          continue;
        }
        if (mode == 63) {
          auto c1 = c1Q_.template AllocTensor<float>();
          c1Q_.EnQue(c1);
          c1 = c1Q_.template DeQue<float>();
          c1Q_.FreeTensor(c1);
          continue;
        }
        if (mode == 65 || mode == 61) {
          auto c1 = c1Q_.template AllocTensor<float>();
          const int slabEnd2 = (mode == 61) ? 1 : 1;
          for (int sb = 0; sb < slabEnd2; ++sb) {
            const int p = sb & 1;
            auto b1 = b1Q_[p].template AllocTensor<half>();
            StageB(b1, nStart + n0, sb);
            b1Q_[p].EnQue(b1);
            b1 = b1Q_[p].template DeQue<half>();
            b1Q_[p].FreeTensor(b1);
          }
          c1Q_.EnQue(c1);
          c1 = c1Q_.template DeQue<float>();
          c1Q_.FreeTensor(c1);
          continue;
        }
        if (mode == 59) {
          auto c1 = c1Q_.template AllocTensor<float>();
          c1Q_.EnQue(c1);
          c1 = c1Q_.template DeQue<float>();
          c1Q_.FreeTensor(c1);
          continue;
        }
        auto c1 = c1Q_.template AllocTensor<float>();
        const bool noCompute = (mode == 85 && nt >= 1) || (mode == 60);
        const int slabEnd = noCompute ? 0 :
          ((mode == 7 || (mode >= 66 && !s5FullSweep) || mode == 51 || mode == 52 || mode == 53) ? 1
          : (mode == 41) ? 2 : (mode == 31) ? 3 : (mode == 32) ? 4 : SLABS);
        for (int sb = 0; sb < slabEnd; ++sb) {
          const int p = sb & 1;
          auto b1 = b1Q_[p].template AllocTensor<half>();
          StageB(b1, nStart + n0, sb);
          b1Q_[p].EnQue(b1);
          b1 = b1Q_[p].template DeQue<half>();
          if (mode == 66) { b1Q_[p].FreeTensor(b1); break; }
          for (int kh = 0; kh < 2; ++kh) {
            auto a2 = a2Q_.template AllocTensor<half>();
            LoadA(a2, aSlab[sb], mv, kh);
            a2Q_.EnQue(a2);
            auto b2 = b2Q_.template AllocTensor<half>();
            LoadB(b2, b1, sb, kh);
            b2Q_.EnQue(b2);
            a2 = a2Q_.template DeQue<half>();
            b2 = b2Q_.template DeQue<half>();
            if (mode == 75 || mode == 67) { a2Q_.FreeTensor(a2); b2Q_.FreeTensor(b2); continue; }
            AscendC::MmadParams mp;
            mp.m = static_cast<uint16_t>(mv);
            mp.n = static_cast<uint16_t>(nv);
            mp.k = BK;
            mp.cmatrixInitVal = (sb == 0 && kh == 0);
            AscendC::Mmad(c1, a2, b2, mp);
            a2Q_.FreeTensor(a2);
            b2Q_.FreeTensor(b2);
          }
          b1Q_[p].FreeTensor(b1);
        }
        c1Q_.EnQue(c1);
        if (mode >= 8) {
          auto cc = c1Q_.template DeQue<float>();
          if (mode == 52) { s5FixForm = 52; }
          FixpipeTile(task, m0, mv, n0, cc);
          if (mode == 53) {
            const auto fid53 = static_cast<event_t>(
              pipe_.FetchEventID(AscendC::HardEvent::FIX_M));
            AscendC::SetFlag<AscendC::HardEvent::FIX_M>(fid53);
            AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(fid53);
          }
          c1Q_.FreeTensor(cc);
        } else {
          c1 = c1Q_.template DeQue<float>();
          c1Q_.FreeTensor(c1);
        }
      }
      for (int q = 0; q < SLABS; ++q) a1Q_[q].FreeTensor(aSlab[q]);
    }
    if (mode == 74) {
      for (int i = 0; i < 3; ++i) {
        auto d = c1Q_.template AllocTensor<float>();
        c1Q_.EnQue(d);
        d = c1Q_.template DeQue<float>();
        c1Q_.FreeTensor(d);
      }
    }
    const auto fixed = static_cast<event_t>(
      pipe_.FetchEventID(AscendC::HardEvent::FIX_M));
    AscendC::SetFlag<AscendC::HardEvent::FIX_M>(fixed);
    AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(fixed);
    AscendC::PipeBarrier<PIPE_ALL>();
    if (mode == 58) {
      AscendC::CrossCoreSetFlag<2, PIPE_M>(SYNC_FLAG);
    } else if (mode == 96 && block_ != 0) {
    } else {
      AscendC::CrossCoreSetFlag<2, PIPE_FIX>(SYNC_FLAG);
    }
  }
  __aicore__ inline void ReduceBand(int32_t m0, int32_t mv,
                   const AscendC::LocalTensor<float>& rowMax,
                   int32_t mode = 9)
  {
    (void)mode;
    for (int r0 = 0; r0 < mv; r0 += CCHUNK) {
      const int32_t rows = mv - r0 < CCHUNK ? mv - r0 : CCHUNK;
      const int32_t rowsPad = (rows + 15) / 16 * 16;
      auto tile = cacheQ_.template AllocTensor<half>();
      AscendC::DataCopy(tile,
        cache_[static_cast<int64_t>(m0 + r0) * CACHE_CN],
        static_cast<uint32_t>(rows * CACHE_CN));
      cacheQ_.EnQue(tile);
      tile = cacheQ_.template DeQue<half>();
      auto fragMaxH = fragMaxBuf_.Get<half>();
      auto fragMax = tileMaxBuf_.Get<float>();
      uint32_t shape[2] = {static_cast<uint32_t>(rowsPad),
                static_cast<uint32_t>(CACHE_CN)};
      AscendC::ReduceMax<half, AscendC::Pattern::Reduce::AR, true>(
        fragMaxH, tile, scratchBuf_.Get<uint8_t>(), shape, true);
      AscendC::PipeBarrier<PIPE_V>();
      AscendC::Cast<float, half>(fragMax, fragMaxH,
                   AscendC::RoundMode::CAST_NONE, rowsPad);
      AscendC::PipeBarrier<PIPE_V>();
      AscendC::Max(rowMax[m0 + r0], rowMax[m0 + r0], fragMax[0], rows);
      AscendC::PipeBarrier<PIPE_V>();
      cacheQ_.FreeTensor(tile);
    }
  }
  __aicore__ inline void ReduceFine(int32_t task)
  {
    const int32_t mi = task / NS_;
    const int32_t mStart = mi * CM_;
    const int32_t validM = OM_ - mStart < CM_ ? OM_ - mStart : CM_;
    const int32_t validN = ON_ - (task % NS_) * CN_ < CN_
      ? ON_ - (task % NS_) * CN_ : CN_;
    auto rowMax = rowMaxBuf_.Get<float>();
    AscendC::Duplicate(rowMax, NEG_INF, CM_);
    AscendC::PipeBarrier<PIPE_V>();
    if (validM <= 0 || validN <= 0) {
      AscendC::CrossCoreWaitFlag<2, PIPE_MTE2>(SYNC_FLAG);
      return;
    }
    cache_.SetGlobalBuffer(cachePool_.GetPhyAddr(
      static_cast<uint64_t>(task) * CACHE_ELEMS), CACHE_ELEMS);
    const int ntEff = (validN + BN - 1) / BN < NTS
      ? (validN + BN - 1) / BN : NTS;
    for (int mt = 0; mt < MTS && mt * BM < validM; ++mt) {
      const int32_t m0 = mt * BM;
      const int32_t mv = validM - m0 < BM ? validM - m0 : BM;
      for (int nt = 0; nt < ntEff; ++nt) {
        AscendC::CrossCoreWaitFlag<2, PIPE_MTE2>(SYNC_FLAG);
        const int32_t n0 = nt * BN;
        const int32_t nv = validN - n0 < BN ? validN - n0 : BN;
        for (int r0 = 0; r0 < mv; r0 += CCHUNK) {
          const int32_t rows = mv - r0 < CCHUNK ? mv - r0 : CCHUNK;
          const int32_t rowsPad = (rows + 15) / 16 * 16;
          auto tile = cacheQ_.template AllocTensor<half>();
          AscendC::DataCopyParams cp{
            static_cast<uint16_t>(rows),
            static_cast<uint16_t>(nv * sizeof(half) / 32),
            static_cast<uint16_t>(
              (CACHE_CN - nv) * sizeof(half) / 32), 0};
          AscendC::DataCopy(tile,
            cache_[static_cast<int64_t>(m0 + r0) * CACHE_CN + n0],
            cp);
          cacheQ_.EnQue(tile);
          tile = cacheQ_.template DeQue<half>();
          auto fragMaxH = fragMaxBuf_.Get<half>();
          auto fragMax = tileMaxBuf_.Get<float>();
          uint32_t shape[2] = {static_cast<uint32_t>(rowsPad),
                    static_cast<uint32_t>(nv)};
          AscendC::ReduceMax<half, AscendC::Pattern::Reduce::AR, true>(
            fragMaxH, tile, scratchBuf_.Get<uint8_t>(), shape, true);
          AscendC::PipeBarrier<PIPE_V>();
          AscendC::Cast<float, half>(fragMax, fragMaxH,
                       AscendC::RoundMode::CAST_NONE,
                       rowsPad);
          AscendC::PipeBarrier<PIPE_V>();
          AscendC::Max(rowMax[m0 + r0], rowMax[m0 + r0], fragMax[0],
                rows);
          AscendC::PipeBarrier<PIPE_V>();
          cacheQ_.FreeTensor(tile);
        }
      }
    }
  }
  __aicore__ inline void ReduceCoarse(int32_t task)
  {
    const int32_t mi = task / NS_;
    const int32_t mStart = mi * CM_;
    const int32_t validM = OM_ - mStart < CM_ ? OM_ - mStart : CM_;
    auto rowMax = rowMaxBuf_.Get<float>();
    AscendC::Duplicate(rowMax, NEG_INF, CM_);
    AscendC::PipeBarrier<PIPE_V>();
    if (validM <= 0) {
      AscendC::CrossCoreWaitFlag<2, PIPE_MTE2>(SYNC_FLAG);
      return;
    }
    cache_.SetGlobalBuffer(cachePool_.GetPhyAddr(
      static_cast<uint64_t>(task) * CACHE_ELEMS), CACHE_ELEMS);
    const int bands = (validM + BM - 1) / BM < MTS
      ? (validM + BM - 1) / BM : MTS;
    for (int b0 = 0; b0 < bands; b0 += 2) {
      AscendC::CrossCoreWaitFlag<2, PIPE_MTE2>(SYNC_FLAG);
      if (b0 + 1 < bands)
        AscendC::CrossCoreWaitFlag<2, PIPE_MTE2>(SYNC_FLAG);
      const int bend = b0 + 1 < bands ? b0 + 1 : b0;
      for (int mt = b0; mt <= bend; ++mt) {
        const int32_t m0 = mt * BM;
        const int32_t mv = validM - m0 < BM ? validM - m0 : BM;
        ReduceBand(m0, mv, rowMax);
      }
    }
  }
  __aicore__ inline void ReduceInc(int32_t task, int32_t mode = 9)
  {
    const int32_t mi = task / NS_;
    const int32_t mStart = mi * CM_;
    const int32_t validM = OM_ - mStart < CM_ ? OM_ - mStart : CM_;
    auto rowMax = rowMaxBuf_.Get<float>();
    AscendC::Duplicate(rowMax, NEG_INF, CM_);
    AscendC::PipeBarrier<PIPE_V>();
    if (validM <= 0) {
      AscendC::CrossCoreWaitFlag<2, PIPE_MTE2>(SYNC_FLAG);
      return;
    }
    cache_.SetGlobalBuffer(cachePool_.GetPhyAddr(
      static_cast<uint64_t>(task) * CACHE_ELEMS), CACHE_ELEMS);
    for (int mt = 0; mt < MTS && mt * BM < validM; ++mt) {
      AscendC::CrossCoreWaitFlag<2, PIPE_MTE2>(SYNC_FLAG);
      const int32_t m0 = mt * BM;
      const int32_t mv = validM - m0 < BM ? validM - m0 : BM;
      ReduceBand(m0, mv, rowMax, mode);
    }
  }
  __aicore__ inline void WaitBands(int32_t task)
  {
    const int32_t mi = task / NS_;
    const int32_t mStart = mi * CM_;
    const int32_t validM = OM_ - mStart < CM_ ? OM_ - mStart : CM_;
    auto rowMax = rowMaxBuf_.Get<float>();
    AscendC::Duplicate(rowMax, NEG_INF, CM_);
    AscendC::PipeBarrier<PIPE_V>();
    if (validM <= 0) {
      AscendC::CrossCoreWaitFlag<2, PIPE_MTE2>(SYNC_FLAG);
      return;
    }
    for (int mt = 0; mt < MTS && mt * BM < validM; ++mt)
      AscendC::CrossCoreWaitFlag<2, PIPE_MTE2>(SYNC_FLAG);
  }
  __aicore__ inline void ReduceNoWait(int32_t task)
  {
    const int32_t mi = task / NS_;
    const int32_t mStart = mi * CM_;
    const int32_t validM = OM_ - mStart < CM_ ? OM_ - mStart : CM_;
    auto rowMax = rowMaxBuf_.Get<float>();
    AscendC::Duplicate(rowMax, NEG_INF, CM_);
    AscendC::PipeBarrier<PIPE_V>();
    if (validM <= 0) return;
    cache_.SetGlobalBuffer(cachePool_.GetPhyAddr(
      static_cast<uint64_t>(task) * CACHE_ELEMS), CACHE_ELEMS);
    for (int mt = 0; mt < MTS && mt * BM < validM; ++mt) {
      const int32_t m0 = mt * BM;
      const int32_t mv = validM - m0 < BM ? validM - m0 : BM;
      ReduceBand(m0, mv, rowMax);
    }
  }
  __aicore__ inline void ReduceCache(int32_t task)
  {
    const int32_t mi = task / NS_;
    const int32_t mStart = mi * CM_;
    const int32_t validM = OM_ - mStart < CM_ ? OM_ - mStart : CM_;
    auto rowMax = rowMaxBuf_.Get<float>();
    AscendC::Duplicate(rowMax, NEG_INF, CM_);
    AscendC::PipeBarrier<PIPE_V>();
    if (validM > 0) {
      cache_.SetGlobalBuffer(cachePool_.GetPhyAddr(
        static_cast<uint64_t>(task) * CACHE_ELEMS), CACHE_ELEMS);
      for (int mt = 0; mt < MTS && mt * BM < validM; ++mt) {
        const int32_t m0 = mt * BM;
        const int32_t mv = validM - m0 < BM ? validM - m0 : BM;
        for (int r0 = 0; r0 < mv; r0 += CCHUNK) {
          const int32_t rows =
            mv - r0 < CCHUNK ? mv - r0 : CCHUNK;
          const int32_t rowsPad = (rows + 15) / 16 * 16;
          auto tile = cacheQ_.template AllocTensor<half>();
          AscendC::DataCopy(tile,
            cache_[static_cast<int64_t>(m0 + r0) * CACHE_CN],
            static_cast<uint32_t>(rows * CACHE_CN));
          cacheQ_.EnQue(tile);
          tile = cacheQ_.template DeQue<half>();
          auto fragMaxH = fragMaxBuf_.Get<half>();
          auto fragMax = tileMaxBuf_.Get<float>();
          uint32_t shape[2] = {static_cast<uint32_t>(rowsPad),
                    static_cast<uint32_t>(CACHE_CN)};
          AscendC::ReduceMax<half, AscendC::Pattern::Reduce::AR, true>(
            fragMaxH, tile, scratchBuf_.Get<uint8_t>(), shape, true);
          AscendC::PipeBarrier<PIPE_V>();
          AscendC::Cast<float, half>(fragMax, fragMaxH,
                       AscendC::RoundMode::CAST_NONE,
                       rowsPad);
          AscendC::PipeBarrier<PIPE_V>();
          AscendC::Max(rowMax[m0 + r0], rowMax[m0 + r0], fragMax[0], rows);
          AscendC::PipeBarrier<PIPE_V>();
          cacheQ_.FreeTensor(tile);
        }
      }
    }
  }
  __aicore__ inline void Publish(int32_t task, int32_t mode = 9)
  {
    const int64_t slot = static_cast<int64_t>(task) * SLOT_FLOATS;
    auto pub = rowMaxBuf_.Get<float>();
    auto flag = pub[CM_];
    AscendC::Duplicate(flag, nonce_, 8);
    const auto ready = pipe_.FetchEventID(AscendC::HardEvent::V_MTE3);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(ready);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(ready);
    if (PubMerge(mode)) {
      AscendC::DataCopyExtParams both{1, (CM_ + 1) * sizeof(float), 0, 0, 0};
      AscendC::DataCopyPad(slots_[slot], pub, both);
      const auto done = pipe_.FetchEventID(AscendC::HardEvent::MTE3_V);
      AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(done);
      AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(done);
      return;
    }
    AscendC::DataCopyExtParams rows{1, CM_ * sizeof(float), 0, 0, 0};
    AscendC::DataCopyPad(slots_[slot], pub, rows);
    const auto landed = pipe_.FetchEventID(AscendC::HardEvent::MTE3_V);
    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(landed);
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(landed);
    AscendC::DataCopyExtParams one{1, sizeof(float), 0, 0, 0};
    AscendC::DataCopyPad(slots_[slot + FLAG_OFF], flag, one);
    const auto done = pipe_.FetchEventID(AscendC::HardEvent::MTE3_V);
    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(done);
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(done);
  }
  __aicore__ inline void FoldIncremental()
  {
    auto flags = flagBuf_.Get<float>();
    auto gathered = gatherBuf_.Get<float>();
    auto verify = verifyBuf_.Get<float>();
    auto sums = sumBuf_.Get<float>();
    auto tmp = reduceTmpBuf_.Get<float>();
    AscendC::DataCopyPadExtParams<float> pad{};
    AscendC::DataCopyExtParams fg{TASKS, sizeof(float),
                   SLOT_BYTES - sizeof(float), 0, 0};
    AscendC::DataCopyExtParams sg{1, CM_ * sizeof(float), 0, 0, 0};
    int32_t done = 0;
    for (int32_t attempt = 0; attempt < SPLIT_POLL_LIMIT && done < TASKS;
      ++attempt) {
      AscendC::DataCopyPad(flags, slots_[FLAG_OFF], fg, pad);
      const auto m2v = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
      AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(m2v);
      AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(m2v);
      const auto v2s = pipe_.FetchEventID(AscendC::HardEvent::V_S);
      AscendC::SetFlag<AscendC::HardEvent::V_S>(v2s);
      AscendC::WaitFlag<AscendC::HardEvent::V_S>(v2s);
      for (int i = 0; i < TASKS; ++i) {
        if (done & (1 << i)) continue;
        if (flags.GetValue(i) != nonce_) continue;
        AscendC::DataCopyPad(gathered[i * CM_], slots_[i * SLOT_FLOATS],
                  sg, pad);
        const auto g1 = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(g1);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(g1);
        AscendC::DataCopyPad(verify, slots_[i * SLOT_FLOATS], sg, pad);
        const auto g2 = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(g2);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(g2);
        AscendC::Sub(verify, gathered[i * CM_], verify, CM_);
        AscendC::Abs(verify, verify, CM_);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::ReduceSum<float>(sums[0], verify, tmp, CM_);
        AscendC::PipeBarrier<PIPE_V>();
        const auto w2s = pipe_.FetchEventID(AscendC::HardEvent::V_S);
        AscendC::SetFlag<AscendC::HardEvent::V_S>(w2s);
        AscendC::WaitFlag<AscendC::HardEvent::V_S>(w2s);
        if (sums[0].GetValue(0) == 0.0F) done |= (1 << i);
      }
    }
    auto fold = foldBuf_.Get<float>();
    for (int mi = 0; mi < MS_; ++mi) {
      const int first = (mi * NS_) * CM_;
      AscendC::Adds(fold, gathered[first], 0.0F, CM_);
      AscendC::PipeBarrier<PIPE_V>();
      for (int ni = 1; ni < NS_; ++ni) {
        const int off = (mi * NS_ + ni) * CM_;
        AscendC::Max(fold, fold, gathered[off], CM_);
        AscendC::PipeBarrier<PIPE_V>();
      }
      const int mStart = mi * CM_;
      const int valid = OM_ - mStart < CM_ ? OM_ - mStart : CM_;
      AscendC::ReduceSum<float>(sums[mi * 8], fold, tmp, valid);
      AscendC::PipeBarrier<PIPE_V>();
    }
    const auto v2s2 = pipe_.FetchEventID(AscendC::HardEvent::V_S);
    AscendC::SetFlag<AscendC::HardEvent::V_S>(v2s2);
    AscendC::WaitFlag<AscendC::HardEvent::V_S>(v2s2);
    float total = 0.0F;
    for (int mi = 0; mi < MS_; ++mi) total += sums[mi * 8].GetValue(0);
    const auto s2v = pipe_.FetchEventID(AscendC::HardEvent::S_V);
    AscendC::SetFlag<AscendC::HardEvent::S_V>(s2v);
    AscendC::WaitFlag<AscendC::HardEvent::S_V>(s2v);
    auto out = outBuf_.Get<float>();
    AscendC::Duplicate(out, total, 8);
    out.SetValue(1, sums[0 * 8].GetValue(0));
    out.SetValue(2, sums[1 * 8].GetValue(0));
    const auto v2m3 = pipe_.FetchEventID(AscendC::HardEvent::V_MTE3);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(v2m3);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(v2m3);
    AscendC::DataCopyExtParams one{1, 3 * sizeof(float), 0, 0, 0};
    AscendC::DataCopyPad(y_[0], out, one);
  }
  __aicore__ inline void Fold()
  {
    auto flags = flagBuf_.Get<float>();
    AscendC::DataCopyPadExtParams<float> pad{};
    AscendC::DataCopyExtParams fg{TASKS, sizeof(float),
                   SLOT_BYTES - sizeof(float), 0, 0};
    for (int32_t attempt = 0; attempt < SPLIT_POLL_LIMIT; ++attempt) {
      AscendC::DataCopyPad(flags, slots_[FLAG_OFF], fg, pad);
      const auto m2v = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
      AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(m2v);
      AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(m2v);
      const auto v2s = pipe_.FetchEventID(AscendC::HardEvent::V_S);
      AscendC::SetFlag<AscendC::HardEvent::V_S>(v2s);
      AscendC::WaitFlag<AscendC::HardEvent::V_S>(v2s);
      bool ready = true;
      for (int i = 0; i < TASKS; ++i) {
        if (flags.GetValue(i) != nonce_) { ready = false; break; }
      }
      if (ready) break;
    }
    auto gathered = gatherBuf_.Get<float>();
    auto verify = verifyBuf_.Get<float>();
    AscendC::DataCopyExtParams rg{TASKS, CM_ * sizeof(float),
                   SLOT_BYTES - CM_ * sizeof(float), 0, 0};
    for (int32_t retry = 0; retry < 32; ++retry) {
      AscendC::DataCopyPad(gathered, slots_[0], rg, pad);
      const auto g1 = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
      AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(g1);
      AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(g1);
      AscendC::DataCopyPad(verify, slots_[0], rg, pad);
      const auto g2 = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
      AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(g2);
      AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(g2);
      const int total = TASKS * CM_;
      AscendC::Sub(verify, gathered, verify, total);
      AscendC::Abs(verify, verify, total);
      AscendC::PipeBarrier<PIPE_V>();
      AscendC::ReduceSum<float>(sumBuf_.Get<float>(), verify,
                   reduceTmpBuf_.Get<float>(), total);
      AscendC::PipeBarrier<PIPE_V>();
      const auto v2s = pipe_.FetchEventID(AscendC::HardEvent::V_S);
      AscendC::SetFlag<AscendC::HardEvent::V_S>(v2s);
      AscendC::WaitFlag<AscendC::HardEvent::V_S>(v2s);
      if (sumBuf_.Get<float>().GetValue(0) == 0.0F) break;
    }
    auto fold = foldBuf_.Get<float>();
    auto sums = sumBuf_.Get<float>();
    auto tmp = reduceTmpBuf_.Get<float>();
    for (int mi = 0; mi < MS_; ++mi) {
      const int first = (mi * NS_) * CM_;
      AscendC::Adds(fold, gathered[first], 0.0F, CM_);
      AscendC::PipeBarrier<PIPE_V>();
      for (int ni = 1; ni < NS_; ++ni) {
        const int off = (mi * NS_ + ni) * CM_;
        AscendC::Max(fold, fold, gathered[off], CM_);
        AscendC::PipeBarrier<PIPE_V>();
      }
      const int mStart = mi * CM_;
      const int valid = OM_ - mStart < CM_ ? OM_ - mStart : CM_;
      AscendC::ReduceSum<float>(sums[mi * 8], fold, tmp, valid);
      AscendC::PipeBarrier<PIPE_V>();
    }
    const auto v2s = pipe_.FetchEventID(AscendC::HardEvent::V_S);
    AscendC::SetFlag<AscendC::HardEvent::V_S>(v2s);
    AscendC::WaitFlag<AscendC::HardEvent::V_S>(v2s);
    float total = 0.0F;
    for (int mi = 0; mi < MS_; ++mi) total += sums[mi * 8].GetValue(0);
    const auto s2v = pipe_.FetchEventID(AscendC::HardEvent::S_V);
    AscendC::SetFlag<AscendC::HardEvent::S_V>(s2v);
    AscendC::WaitFlag<AscendC::HardEvent::S_V>(s2v);
    auto out = outBuf_.Get<float>();
    AscendC::Duplicate(out, total, 8);
    out.SetValue(1, sums[0 * 8].GetValue(0));
    out.SetValue(2, sums[1 * 8].GetValue(0));
    const auto v2m3 = pipe_.FetchEventID(AscendC::HardEvent::V_MTE3);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(v2m3);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(v2m3);
    AscendC::DataCopyExtParams one{1, 3 * sizeof(float), 0, 0, 0};
    AscendC::DataCopyPad(y_[0], out, one);
  }
  int32_t blocks_ = 1, block_ = 0;
  bool s5NoQuantMode = false;
  bool s5FixForm = false;
  bool s5SrcStrideBn = false;
  bool s5CompactTail = false;
  float nonce_ = 1.0F;
  AscendC::TPipe pipe_;
  AscendC::TQue<AscendC::TPosition::A1, 1> a1Q_[SLABS];
  AscendC::TQue<AscendC::TPosition::A1, 1> b1Q_[3];
  AscendC::TQue<AscendC::TPosition::A2, 2> a2Q_;
  AscendC::TQue<AscendC::TPosition::B2, 2> b2Q_;
  AscendC::TQue<AscendC::TPosition::CO1, 2> c1Q_;
  AscendC::TQue<AscendC::TPosition::VECIN, 2> cacheQ_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> fragMaxBuf_, tileMaxBuf_, scratchBuf_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> rowMaxBuf_, flagBuf_, gatherBuf_, verifyBuf_, foldBuf_, sumBuf_, reduceTmpBuf_;
  AscendC::TBuf<AscendC::TPosition::VECOUT> outBuf_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> nonceOut_;
  AscendC::GlobalTensor<half> x1_, x2_, cachePool_, cache_;
  AscendC::GlobalTensor<float> y_, slots_;
};
}
#define DECLARE_C9S5_KERNEL(NAME, PFW) \
extern "C" __global__ __mix__(1, 1) void NAME( \
  GM_ADDR x1, GM_ADDR x2, GM_ADDR y, __kfc_workspace__ GM_ADDR workspace, \
  GM_ADDR asyncCache, GM_ADDR tiles, int32_t blocks, float nonce, int32_t mode) \
{ \
  if constexpr (PFW != 0) { \
  if ASCEND_IS_AIV { \
    if (AscendC::GetSubBlockIdx() == 0) { \
      const int32_t pwB = static_cast<int32_t>(AscendC::GetBlockIdx()); \
      AscendC::TPipe pfPipe; \
      AscendC::TBuf<AscendC::TPosition::VECIN> pfBuf; \
      pfPipe.InitBuffer(pfBuf, 32 * 1024); \
      auto pf = pfBuf.Get<half>(); \
      const int64_t chunk = 16384; \
      const int64_t x1C = static_cast<int64_t>(2048) * 1280 / chunk; \
      const int64_t x2C = static_cast<int64_t>(1536) * 1280 / chunk; \
      AscendC::GlobalTensor<half> g1, g2; \
      g1.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(x1), \
               static_cast<int64_t>(2048) * 1280); \
      g2.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(x2), \
               static_cast<int64_t>(1536) * 1280); \
      AscendC::DataCopyParams ip{8, 128, 0, 0}; \
      AscendC::DataCopyEnhancedParams ep; \
      ep.blockMode = AscendC::BlockMode::BLOCK_MODE_VECTOR; \
      if constexpr (PFW & 1) \
        for (int64_t c = pwB; c < x1C; c += blocks) \
          AscendC::DataCopy(pf, g1[c * chunk], ip, ep); \
      if constexpr (PFW & 2) \
        for (int64_t c = pwB; c < x2C; c += blocks) \
          AscendC::DataCopy(pf, g2[c * chunk], ip, ep); \
      const auto pfEv = pfPipe.FetchEventID(AscendC::HardEvent::MTE2_MTE3); \
      AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE3>(pfEv); \
      AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE3>(pfEv); \
    } \
  } \
  } \
  batch_matmul_max_sum_v3::CubeS5Hand<false, 2048, 1536, 1280, 5, 4, 416, 384> op; \
  op.Init(x1, x2, y, asyncCache, tiles, blocks, nonce, 9, mode); \
  op.Process(mode); \
}
DECLARE_C9S5_KERNEL(batch_matmul_case9_s5_fp16, 3)
#undef DECLARE_C9S5_KERNEL
#define DECLARE_CUBE_KERNEL(NAME, TYPE, TX1, TX2) \
extern "C" __global__ __mix__(1, 1) void NAME( \
  GM_ADDR x1, GM_ADDR x2, GM_ADDR y, int64_t b, int64_t m, int64_t n, int64_t k, \
  int64_t blocks, __kfc_workspace__ GM_ADDR workspace, GM_ADDR tiles, batch_matmul_max_sum_v3::DeviceTiling tiling) \
{ \
  batch_matmul_max_sum_v3::CubeMaxSum<TYPE, TX1, TX2> op; \
  op.Init(x1, x2, y, b, m, n, k, blocks, tiles, tiling); \
  \
  \
  REGIST_MATMUL_OBJ(op.Pipe(), GetSysWorkSpacePtr(), op.mm_, &tiling); \
  op.Process(); \
}
DECLARE_CUBE_KERNEL(batch_matmul_cube_fp16_nn, half, false, false)
DECLARE_CUBE_KERNEL(batch_matmul_cube_fp16_nt, half, false, true)
DECLARE_CUBE_KERNEL(batch_matmul_cube_fp16_tn, half, true, false)
DECLARE_CUBE_KERNEL(batch_matmul_cube_fp16_tt, half, true, true)
DECLARE_CUBE_KERNEL(batch_matmul_cube_bf16_nn, bfloat16_t, false, false)
DECLARE_CUBE_KERNEL(batch_matmul_cube_bf16_nt, bfloat16_t, false, true)
DECLARE_CUBE_KERNEL(batch_matmul_cube_bf16_tn, bfloat16_t, true, false)
DECLARE_CUBE_KERNEL(batch_matmul_cube_bf16_tt, bfloat16_t, true, true)
#undef DECLARE_CUBE_KERNEL
extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1,
             GM_ADDR x2, const TensorGroupInfo& info_x2,
             GM_ADDR y, const TensorGroupInfo& info_y,
             int64_t availableCoreNum, aclrtStream stream,
             bool transposeX1, bool transposeX2)
{
  if (availableCoreNum <= 0 || info_x1.numTensors != 1 || info_x2.numTensors != 1 ||
    info_y.numTensors != 1 || info_x1.tensors[0].numDims != 3 ||
    info_x2.tensors[0].numDims != 3 || info_y.tensors[0].numDims != 1)
    throw std::runtime_error("BMM: invalid rank or core count");
  const TensorInfo& a = info_x1.tensors[0];
  const TensorInfo& bInfo = info_x2.tensors[0];
  const TensorInfo& out = info_y.tensors[0];
  const int64_t b = a.shape[0];
  const int64_t m = transposeX1 ? a.shape[2] : a.shape[1];
  const int64_t k = transposeX1 ? a.shape[1] : a.shape[2];
  const int64_t n = transposeX2 ? bInfo.shape[1] : bInfo.shape[2];
  const int64_t kb = transposeX2 ? bInfo.shape[2] : bInfo.shape[1];
  const int32_t dtype = a.dtype;
  if (b < 1 || b > 64 || m < 1 || m > 8192 || n < 1 || n > 8192 ||
    k < 32 || k > 8192 || k % 8 || bInfo.shape[0] != b || kb != k ||
    bInfo.dtype != dtype || (dtype != 1 && dtype != 2) || out.shape[0] != b ||
    out.dtype != 0 || b * m * k > (1LL << 26) || b * n * k > (1LL << 26))
    throw std::runtime_error("BMM: invalid shape, layout or dtype");
  const int64_t blocks = b < availableCoreNum ? b : availableCoreNum;
  if (b == 1 && m == 4096 && n == 1280 && k == 1152 &&
    !transposeX1 && !transposeX2 && dtype == 2) {
    constexpr int MS = BMM_CASE10_MS, NS = BMM_CASE10_NS,
           CM = BMM_CASE10_CM, CN = BMM_CASE10_CN;
    constexpr int TASKS = MS * NS;
    constexpr uint64_t SLOT_FLOATS = ((CM + 1 + 31) / 32) * 32;
    int32_t wbFull = static_cast<int32_t>(availableCoreNum < 64 ?
                       availableCoreNum : 64);
    {
      const int32_t wbOv = batch_matmul_max_sum_v3::C10WbOverride();
      if (wbOv >= 1 && wbOv <= wbFull) wbFull = wbOv;
    }
    const int32_t wb = wbFull < TASKS ? wbFull : TASKS;
    try {
      auto tiling = batch_matmul_max_sum_v3::BuildDirectWideTiling(
        m, n, k, CM, CN, dtype, false, false, TASKS, CM,
        BMM_HALFC_ASYNC ? sizeof(half) : sizeof(float), false, 128,
        BMM_CASE10_BM, BMM_CASE10_BN, BMM_CASE10_BK);
#if BMM_CASE10_BN256_PROBE
      if (tiling.baseN >= 256) {
        if (tiling.dbL0B < 2) {
          tiling = batch_matmul_max_sum_v3::BuildDirectWideTiling(
            m, n, k, CM, CN, dtype, false, false, TASKS, CM,
            BMM_HALFC_ASYNC ? sizeof(half) : sizeof(float),
            false, 128, 0, 0, 0);
        }
      } else {
        auto t256 = batch_matmul_max_sum_v3::BuildDirectWideTiling(
          m, n, k, CM, CN, dtype, false, false, TASKS, CM,
          BMM_HALFC_ASYNC ? sizeof(half) : sizeof(float),
          false, 128, 128, 256, 128);
