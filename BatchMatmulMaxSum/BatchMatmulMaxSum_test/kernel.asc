    constexpr uint64_t slabBytes = static_cast<uint64_t>(batch_matmul_max_sum_v3::CASE14_M) *
                   batch_matmul_max_sum_v3::CASE14_CHUNK_N * sizeof(float);
    constexpr uint64_t metaBytes = static_cast<uint64_t>(batch_matmul_max_sum_v3::CASE14_SPLITS) *
                   batch_matmul_max_sum_v3::CASE14_SLOT_BYTES;
    auto* workspace = batch_matmul_max_sum_v3::MatmulWorkspace(
      stream, batch_matmul_max_sum_v3::CASE14_SPLITS * slabBytes + metaBytes);
    auto* tiles = workspace + batch_matmul_max_sum_v3::Align512(
      batch_matmul_max_sum_v3::LibApiWorkspaceBytes());
    batch_matmul_case14_splitn_bf16<<<batch_matmul_max_sum_v3::CASE14_SPLITS, nullptr, stream>>>(
      x1, x2, y, workspace, tiles, tiling);
    return;
  }
#if BMM_CASE15_DIRECT
  if (b == 1 && m == batch_matmul_max_sum_v3::CASE15_M &&
    n == batch_matmul_max_sum_v3::CASE15_N && k == batch_matmul_max_sum_v3::CASE15_K &&
    transposeX1 && transposeX2 && dtype == 1 && availableCoreNum >= batch_matmul_max_sum_v3::CASE15_SPLITS) {
    constexpr uint64_t cBytes = static_cast<uint64_t>(batch_matmul_max_sum_v3::CASE15_C_ELEMS) * sizeof(half);
    constexpr uint64_t flagBytes = static_cast<uint64_t>(batch_matmul_max_sum_v3::CASE15_SPLITS) *
                   batch_matmul_max_sum_v3::CASE15_FLAG_SLOT_BYTES;
    auto* workspace = batch_matmul_max_sum_v3::MatmulWorkspace(
      stream, batch_matmul_max_sum_v3::CASE15_SPLITS * cBytes + flagBytes);
    batch_matmul_case15_direct_fp16<<<batch_matmul_max_sum_v3::CASE15_SPLITS, nullptr, stream>>>(
      x1, x2, y, workspace, workspace, batch_matmul_max_sum_v3::DeviceTiling{},
      batch_matmul_max_sum_v3::NextLaunchNonce());
    return;
  }
#endif
  if (b == 1 && m == batch_matmul_max_sum_v3::CASE15_M &&
    n == batch_matmul_max_sum_v3::CASE15_N && k == batch_matmul_max_sum_v3::CASE15_K &&
    transposeX1 && transposeX2 && dtype == 1 && availableCoreNum >= batch_matmul_max_sum_v3::CASE15_SPLITS) {
    const auto tiling = batch_matmul_max_sum_v3::BuildCase15SplitKTiling(dtype);
    constexpr uint64_t cBytes = static_cast<uint64_t>(batch_matmul_max_sum_v3::CASE15_C_ELEMS) * sizeof(float);
    constexpr uint64_t flagBytes = static_cast<uint64_t>(batch_matmul_max_sum_v3::CASE15_SPLITS) *
                   batch_matmul_max_sum_v3::CASE15_FLAG_SLOT_BYTES;
    auto* workspace = batch_matmul_max_sum_v3::MatmulWorkspace(
      stream, batch_matmul_max_sum_v3::CASE15_SPLITS * cBytes + flagBytes);
    auto* tiles = workspace + batch_matmul_max_sum_v3::Align512(
      batch_matmul_max_sum_v3::LibApiWorkspaceBytes());
    batch_matmul_case15_splitk_fp16<<<batch_matmul_max_sum_v3::CASE15_SPLITS, nullptr, stream>>>(
      x1, x2, y, workspace, tiles, tiling);
    return;
  }
  if (b == 1 && m == 1 && n == 1 && k == 32 && !transposeX1 && !transposeX2) {
#if defined(BMM_CASE1_GEMV) && BMM_CASE1_GEMV
    {
      auto* scratch = batch_matmul_max_sum_v3::VectorScratchWorkspace(
        stream, 1024);
      if (dtype == 1)
        batch_matmul_case1_gemv<half><<<1, nullptr, stream>>>(
          x1, x2, y, scratch);
      else
        batch_matmul_case1_gemv<bfloat16_t><<<1, nullptr, stream>>>(
          x1, x2, y, scratch);
      return;
    }
#endif
    if (dtype == 1) {
      if (batch_matmul_max_sum_v3::Case1Np() == 1) {
        const uintptr_t a1 = reinterpret_cast<uintptr_t>(x1);
        const uintptr_t b1 = reinterpret_cast<uintptr_t>(x2);
        if (b1 == a1 + 64)
          batch_matmul_case1_npgm_fp16<<<1, nullptr, stream>>>(
            x1, x2, y, 0);
        else if (a1 == b1 + 64)
          batch_matmul_case1_npgm_fp16<<<1, nullptr, stream>>>(
            x2, x2, y, 1);
        else
          batch_matmul_case1_np_fp16<<<1, nullptr, stream>>>(
            x1, x2, y);
      }
      else
        batch_matmul_case1_lean_dot_fp16<<<1, nullptr, stream>>>(x1, x2, y);
    }
    else if (batch_matmul_max_sum_v3::Case1Mode() == 1)
      batch_matmul_case1_dot_tuned_bf16<<<1, nullptr, stream>>>(x1, x2, y);
    else
      batch_matmul_case1_lean_dot_bf16<<<1, nullptr, stream>>>(x1, x2, y);
    return;
  }
  if (b == 16 && m == 32 && n == 128 && k == 256 &&
    transposeX1 && !transposeX2 && dtype == 1 &&
    batch_matmul_max_sum_v3::Case7Mode() >= 1) {
    constexpr uint64_t scratchBytes =
      static_cast<uint64_t>(batch_matmul_max_sum_v3::DirectMmadCase7<0>::B) *
      batch_matmul_max_sum_v3::DirectMmadCase7<0>::C_ELEMS * sizeof(float);
    auto* scratch = batch_matmul_max_sum_v3::VectorScratchWorkspace(stream, scratchBytes);
    if (batch_matmul_max_sum_v3::Case7Mode() == 9) {
      static thread_local uint8_t* c7LagScratch = nullptr;
      static thread_local int32_t c7LagDevice = -1;
      int32_t curDevice = -1;
      GM_ADDR mode = nullptr;
      if (aclrtGetDevice(&curDevice) == ACL_SUCCESS &&
        c7LagScratch == scratch && c7LagDevice == curDevice) {
        mode = reinterpret_cast<GM_ADDR>(static_cast<uintptr_t>(1));
      } else if (curDevice != -1) {
        c7LagScratch = scratch;
        c7LagDevice = curDevice;
      }
      batch_matmul_case7_k2_fp16<<<batch_matmul_max_sum_v3::DirectMmadCase7K<2>::B,
                       nullptr, stream>>>(x1, x2, y, scratch, mode);
      return;
    }
#ifndef BMM_C7_LEAN
#endif
    batch_matmul_case7_direct_v2_fp16<<<batch_matmul_max_sum_v3::DirectMmadCase7<0>::B,
                       nullptr, stream>>>(x1, x2, y, scratch);
    return;
  }
  if (b == 13 && m == 23 && n == 73 && k == 192 &&
    !transposeX1 && transposeX2 && dtype == 2) {
    constexpr uint64_t scratchBytes =
      static_cast<uint64_t>(batch_matmul_max_sum_v3::DirectMmadCase6::B) *
      batch_matmul_max_sum_v3::DirectMmadCase6::C_ELEMS * sizeof(float);
    auto* scratch = batch_matmul_max_sum_v3::VectorScratchWorkspace(stream, scratchBytes);
    const int32_t mode6 = batch_matmul_max_sum_v3::Case6Mode();
    int32_t grid6 = batch_matmul_max_sum_v3::Case6Grid();
    if (grid6 == 20) {
      grid6 = static_cast<int32_t>(
        availableCoreNum < 20 ? availableCoreNum : 20);
    }
    if (grid6 != 13 || mode6 >= 100) {
      batch_matmul_case6_guard_bf16<<<grid6, nullptr, stream>>>(
        x1, x2, y, scratch, mode6);
    } else {
      batch_matmul_case6_direct_bf16<<<batch_matmul_max_sum_v3::DirectMmadCase6::B,
                      nullptr, stream>>>(
        x1, x2, y, scratch, mode6);
    }
    return;
  }
  const auto tiling = batch_matmul_max_sum_v3::BuildCubeTiling(
    static_cast<int32_t>(m), static_cast<int32_t>(n), static_cast<int32_t>(k),
    dtype, transposeX1, transposeX2);
  const int64_t sliceM = tiling.singleCoreM;
  int64_t splits = 1;
  const int64_t rowChunks = (m + tiling.baseM - 1) / tiling.baseM;
  if (b < availableCoreNum && rowChunks >= 2) {
    const int64_t limit = availableCoreNum / b;
    int64_t wanted = (m + sliceM - 1) / sliceM;
    const int64_t perRow = rowChunks < limit ? rowChunks : limit;
    if (wanted < perRow) wanted = perRow;
    if (wanted > limit) wanted = limit;
    while (wanted > 1) {
      const int64_t chunk = (m + wanted - 1) / wanted;
      const int64_t aligned = (chunk + tiling.baseM - 1) / tiling.baseM * tiling.baseM;
      if ((wanted - 1) * aligned < m) break;
      --wanted;
    }
    splits = wanted;
    if (splits > batch_matmul_max_sum_v3::SPLIT_MAX)
      splits = batch_matmul_max_sum_v3::SPLIT_MAX;
    const int64_t nTiles = (n + tiling.baseN - 1) / tiling.baseN;
    const int64_t rowsPerBlock = (rowChunks + wanted - 1) / wanted;
    if (wanted > 1 && nTiles * (rowChunks - rowsPerBlock) < 2) splits = 1;
  }
  const int64_t cubeBlocks = splits > 1 ? b * splits : blocks;
  const uint64_t slabBytes = batch_matmul_max_sum_v3::Align512(
    static_cast<uint64_t>(sliceM) * n * sizeof(float));
  const uint64_t splitBytes = static_cast<uint64_t>(cubeBlocks) *
    batch_matmul_max_sum_v3::SPLIT_SLOT_BYTES;
  auto* workspace = batch_matmul_max_sum_v3::MatmulWorkspace(
    stream, static_cast<uint64_t>(cubeBlocks) * slabBytes + splitBytes);
  auto* tiles = workspace + batch_matmul_max_sum_v3::Align512(
    batch_matmul_max_sum_v3::LibApiWorkspaceBytes());
  if (dtype == 1) {
    if (!transposeX1 && !transposeX2) batch_matmul_cube_fp16_nn<<<cubeBlocks, nullptr, stream>>>(x1,x2,y,b,m,n,k,cubeBlocks,workspace,tiles,tiling);
    else if (!transposeX1) batch_matmul_cube_fp16_nt<<<cubeBlocks, nullptr, stream>>>(x1,x2,y,b,m,n,k,cubeBlocks,workspace,tiles,tiling);
    else if (!transposeX2) batch_matmul_cube_fp16_tn<<<cubeBlocks, nullptr, stream>>>(x1,x2,y,b,m,n,k,cubeBlocks,workspace,tiles,tiling);
    else batch_matmul_cube_fp16_tt<<<cubeBlocks, nullptr, stream>>>(x1,x2,y,b,m,n,k,cubeBlocks,workspace,tiles,tiling);
  } else {
    if (!transposeX1 && !transposeX2) batch_matmul_cube_bf16_nn<<<cubeBlocks, nullptr, stream>>>(x1,x2,y,b,m,n,k,cubeBlocks,workspace,tiles,tiling);
    else if (!transposeX1) batch_matmul_cube_bf16_nt<<<cubeBlocks, nullptr, stream>>>(x1,x2,y,b,m,n,k,cubeBlocks,workspace,tiles,tiling);
    else if (!transposeX2) batch_matmul_cube_bf16_tn<<<cubeBlocks, nullptr, stream>>>(x1,x2,y,b,m,n,k,cubeBlocks,workspace,tiles,tiling);
    else batch_matmul_cube_bf16_tt<<<cubeBlocks, nullptr, stream>>>(x1,x2,y,b,m,n,k,cubeBlocks,workspace,tiles,tiling);
  }
}
