class VectorCase2V8 {
public:
  __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y)
  {
    x1u_.SetGlobalBuffer(reinterpret_cast<__gm__ uint16_t*>(x1), 40 * 3);
    x2u_.SetGlobalBuffer(reinterpret_cast<__gm__ uint16_t*>(x2), 40 * 5);
    y_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y), 2048);
    yU16_.SetGlobalBuffer(reinterpret_cast<__gm__ uint16_t*>(y), 4096);
    pipe_.InitBuffer(inBuf_, 672);
    pipe_.InitBuffer(calcBuf_, 12 * 1024);
    pipe_.InitBuffer(outBuf_, 32);
  }
  __aicore__ inline void Process()
  {
    constexpr int32_t M = 3, N = 5, K = 40;
    auto in = inBuf_.Get<uint16_t>();
    auto aRaw = in;
    auto bRaw = in[128];
    auto calc = calcBuf_.Get<uint8_t>();
    auto a32f = calc[0].ReinterpretCast<float>();
    auto b32f = calc[128].ReinterpretCast<float>();
    auto bT32 = calc[1408].ReinterpretCast<float>();
    auto aTm  = calc[2816].ReinterpretCast<float>();
    auto rep  = calc[3072].ReinterpretCast<float>();
    auto prod = calc[4384].ReinterpretCast<float>();
    auto ctRow = calc[5696].ReinterpretCast<float>();
    auto ct   = calc[5760].ReinterpretCast<float>();
    auto tabA = calc[5952].ReinterpretCast<uint32_t>();
    auto tabK = calc[6112].ReinterpretCast<uint32_t>();
    auto redU8 = calc[6272].ReinterpretCast<uint8_t>();
    auto redTmp = calc[6528].ReinterpretCast<float>();
    const AscendC::DataCopyExtParams bulkA{1, 240, 0, 0, 0};
    const AscendC::DataCopyPadExtParams<uint16_t> npA{};
    AscendC::DataCopyPad(aRaw, x1u_[0], bulkA, npA);
    const AscendC::DataCopyExtParams bulkB{1, 400, 0, 0, 0};
    const AscendC::DataCopyPadExtParams<uint16_t> npB{};
    AscendC::DataCopyPad(bRaw, x2u_[0], bulkB, npB);
    const auto loaded = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(loaded);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(loaded);
    AscendC::Cast(a32f, aRaw.ReinterpretCast<bfloat16_t>(),
           AscendC::RoundMode::CAST_NONE, 328);
    AscendC::PipeBarrier<PIPE_V>();
    for (int32_t i = 0; i < 40; ++i)
      tabA.SetValue(i, static_cast<uint32_t>(12 * i));
    for (int32_t i = 0; i < 40; ++i)
      tabK.SetValue(i, static_cast<uint32_t>(20 * i));
    AscendC::PipeBarrier<PIPE_V>();
    for (int32_t j = 0; j < N; ++j)
      AscendC::Gather<float>(bT32[j * 40], b32f, tabK,
                 static_cast<uint32_t>(4 * j), 40);
    AscendC::Duplicate(ct, 0.0F, M * 16);
    const uint32_t ds[2] = {8, 40};
    const uint32_t ss[2] = {1, 40};
    const uint32_t rs[2] = {8, 40};
    for (int32_t m = 0; m < M; ++m) {
      AscendC::Gather<float>(aTm, a32f, tabA,
                 static_cast<uint32_t>(4 * m), 40);
      AscendC::Broadcast<float, 2, 2>(rep, aTm, ds, ss);
      AscendC::PipeBarrier<PIPE_V>();
      AscendC::Mul(prod, rep, bT32, 320);
      AscendC::PipeBarrier<PIPE_V>();
      AscendC::ReduceSum<float, AscendC::Pattern::Reduce::AR, true>(
        ctRow, prod, redU8, rs, true);
      AscendC::PipeBarrier<PIPE_V>();
      AscendC::ReduceMax<float>(ct[m * 16], ctRow, redTmp, N);
    }
    auto out = outBuf_.Get<float>();
    AscendC::ReduceSum<float>(out, ct, redTmp, M * 16);
    const auto v2m3 = pipe_.FetchEventID(AscendC::HardEvent::V_MTE3);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(v2m3);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(v2m3);
    const AscendC::DataCopyExtParams cpo{1, 4, 0, 0, 0};
    AscendC::DataCopyPad(y_[0], out, cpo);
  }
private:
  AscendC::TPipe pipe_;
  AscendC::TBuf<AscendC::TPosition::VECIN> inBuf_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> calcBuf_;
  AscendC::TBuf<AscendC::TPosition::VECOUT> outBuf_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> nonceOut_;
  AscendC::GlobalTensor<uint16_t> x1u_, x2u_;
  AscendC::GlobalTensor<float> y_;
  AscendC::GlobalTensor<uint16_t> yU16_;
};
