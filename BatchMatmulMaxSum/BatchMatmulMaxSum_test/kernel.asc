using batch_matmul_max_sum_v3::SPLIT_UB_SLOT_FLOATS;
using batch_matmul_max_sum_v3::SHORT_REDUCE_TMP_BYTES;
using batch_matmul_max_sum_v3::SPLIT_POLL_LIMIT;
class DirectMmadCase8Za {
public:
  static constexpr int OM = 1025, ON = 1031, OK = 1032;
  static constexpr int MS = 5, NSC = 4, TASKS = 20;
  static constexpr int MR = 208;
  static constexpr int KPAD = 1040;
  static constexpr int PITCH = 80;
  static constexpr int SLOT_FLOATS = 224;
  static constexpr int FLAG_OFF = 208;
  static constexpr int CACHE_ROWS = 272;
  static constexpr int CACHE_FLOATS = CACHE_ROWS * MR;
  static constexpr uint16_t SYNC_PRE = 14;
  __aicore__ inline AscendC::TPipe* Pipe() { return &pipe_; }
  __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
                GM_ADDR zn, GM_ADDR za, GM_ADDR cache,
                GM_ADDR slots, float nonce)
  {
    block_ = static_cast<int32_t>(AscendC::GetBlockIdx());
    nonce_ = nonce;
    x1u_.SetGlobalBuffer(reinterpret_cast<__gm__ uint16_t*>(x1),
              static_cast<int64_t>(OK) * OM);
    x2u_.SetGlobalBuffer(reinterpret_cast<__gm__ uint16_t*>(x2),
              static_cast<int64_t>(ON) * OK);
    x2b_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(x2),
              static_cast<int64_t>(ON) * OK);
    zt_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(zn),
              1040ull * 1040);
    za2_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(za),
              65ull * 16640);
    ztP_ = reinterpret_cast<__gm__ uint16_t*>(zn);
    za2P_ = reinterpret_cast<__gm__ uint16_t*>(za);
    y_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y), 2048);
    cache_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(cache),
               static_cast<int64_t>(TASKS) * CACHE_FLOATS);
    slots_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(slots),
               static_cast<int64_t>(TASKS) * SLOT_FLOATS);
    if ASCEND_IS_AIC {
      pipe_.InitBuffer(aResBuf_, MR * KPAD * sizeof(bfloat16_t));
      pipe_.InitBuffer(b1Q_, 2, 128 * 128 * sizeof(bfloat16_t));
      pipe_.InitBuffer(a2Q_, 1, 13 * 8 * 256 * sizeof(bfloat16_t));
      pipe_.InitBuffer(b2Q_, 2, 8 * 8 * 256 * sizeof(bfloat16_t));
      pipe_.InitBuffer(c1Q_, 1, 128 * MR * sizeof(float));
      return;
    }
    pipe_.InitBuffer(redBuf_, 4 * 104 * PITCH * sizeof(float));
    pipe_.InitBuffer(rowMaxBuf_, 256 * sizeof(float));
    pipe_.InitBuffer(flagBuf_, TASKS * SPLIT_UB_SLOT_FLOATS * sizeof(float));
    pipe_.InitBuffer(gatherBuf_, 4 * MR * sizeof(float));
    pipe_.InitBuffer(foldBuf_, 256 * sizeof(float));
    pipe_.InitBuffer(reduceTmpBuf_, 2048 * sizeof(float));
    pipe_.InitBuffer(outBuf_, 32);
  }
  __aicore__ inline void Process()
  {
    if ASCEND_IS_AIV {
      if (AscendC::GetSubBlockIdx() != 0) return;
      if (block_ == 0) PrepassZtTail();
      PrepassZa2First();
      AscendC::SyncAll();
      AscendC::CrossCoreSetFlag<2, PIPE_MTE3>(SYNC_PRE);
      PrepassZa2Rest();
      AscendC::SyncAll();
      AscendC::CrossCoreSetFlag<2, PIPE_MTE3>(12);
      ReduceAll();
      Publish();
      if (block_ == 0) Fold();
      return;
    }
    AscendC::CrossCoreWaitFlag<2, PIPE_MTE1>(SYNC_PRE);
    Compute();
  }
private:
  __aicore__ inline static int Ladder(int s)
  { return s < 7 ? 128 : (s == 7 ? 112 : 32); }
  __aicore__ inline static int LadderK0(int s)
  { return s < 7 ? s * 128 : (896 + (s == 7 ? 0 : 112)); }
  __aicore__ inline static int Steps() { return 9; }
  __aicore__ inline static int NbOf(int ni) { return ni == 0 ? 17 : 16; }
  __aicore__ inline static int NsOf(int ni)
  { return ni == 0 ? 0 : (ni == 1 ? 272 : (ni == 2 ? 528 : 784)); }
  __aicore__ inline void PrepassZtTail()
  {
    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> big;
    pipe.InitBuffer(big, 16 * 1040 * sizeof(uint16_t) + 64);
    auto stH = big.Get<uint8_t>().ReinterpretCast<half>();
    const AscendC::DataCopyExtParams rowIn{1, 2064, 0, 0, 0};
    const AscendC::DataCopyPadExtParams<uint16_t> rowPad{true, 0, 8, 0};
    AscendC::Duplicate(stH, static_cast<half>(0.0F), 16 * 1040);
    AscendC::PipeBarrier<PIPE_V>();
    const auto zeroed = pipe.FetchEventID(AscendC::HardEvent::V_MTE2);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(zeroed);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(zeroed);
    for (int n = 1024; n < ON; ++n)
      AscendC::DataCopyPad(
        stH[(n - 1024) * 1040].ReinterpretCast<uint16_t>(),
        x2u_[static_cast<int64_t>(n) * OK], rowIn, rowPad);
    const auto ld = pipe.FetchEventID(AscendC::HardEvent::MTE2_V);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(ld);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(ld);
    AscendC::GlobalTensor<uint16_t> dst;
    dst.SetGlobalBuffer(ztP_, 16 * 1040);
    const auto sv = pipe.FetchEventID(AscendC::HardEvent::V_MTE3);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(sv);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(sv);
    const AscendC::DataCopyExtParams rows{16, 2080, 0, 0, 0};
    AscendC::DataCopyPad(dst, stH.ReinterpretCast<uint16_t>(), rows);
    const auto fl = pipe.FetchEventID(AscendC::HardEvent::MTE3_V);
    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(fl);
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(fl);
  }
  __aicore__ inline void PrepassZa2Block(int g)
  {
    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> big;
    pipe.InitBuffer(big, (16 * 2064 + 2064 + 2064 * 16) * 2);
    AscendC::TBuf<AscendC::TPosition::VECCALC> scratchQ;
    pipe.InitBuffer(scratchQ, 1024);
    auto calc8 = big.Get<uint8_t>();
    auto rowsH = calc8.ReinterpretCast<half>();
    auto outH = calc8[16 * 2064 * 2 + 2064 * 2].ReinterpretCast<half>();
    AscendC::tiling::ConfusionTransposeTiling ctt_{};
    ctt_.param0 = 16;
    ctt_.param1 = 16;
    ctt_.param2 = 2064;
    ctt_.param3 = 1;
    ctt_.param4 = 16;
    ctt_.param5 = 129;
    const int kLo = g * 16;
    const int kHi = kLo + 16 < OK ? kLo + 16 : OK;
    AscendC::Duplicate(rowsH, static_cast<half>(0.0F), 16 * 2064 + 2064);
    AscendC::PipeBarrier<PIPE_V>();
    const AscendC::DataCopyExtParams rowIn{1, 2050, 0, 0, 0};
    const AscendC::DataCopyPadExtParams<uint16_t> rowPad{true, 0, 15, 0};
    for (int k = kLo; k < kHi; ++k) {
      const auto war = pipe.FetchEventID(AscendC::HardEvent::MTE3_MTE2);
      AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(war);
      AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(war);
      AscendC::DataCopyPad(
        rowsH[(k - kLo) * 2064].ReinterpretCast<uint16_t>(),
        x1u_[static_cast<int64_t>(k) * OM], rowIn, rowPad);
    }
    const auto ld = pipe.FetchEventID(AscendC::HardEvent::MTE2_V);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(ld);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(ld);
    AscendC::Transpose(outH, rowsH, scratchQ.Get<uint8_t>(),
             AscendC::TransposeType::TRANSPOSE_ND2ND_ONLY, ctt_);
    AscendC::PipeBarrier<PIPE_V>();
    AscendC::GlobalTensor<uint16_t> dst;
    dst.SetGlobalBuffer(za2P_ + static_cast<int64_t>(g) * 16640, 16640);
    const auto sv2 = pipe.FetchEventID(AscendC::HardEvent::V_MTE3);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(sv2);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(sv2);
    AscendC::DataCopy(dst, outH.ReinterpretCast<uint16_t>(), 16640);
    const auto fl = pipe.FetchEventID(AscendC::HardEvent::MTE3_V);
    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(fl);
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(fl);
  }
  __aicore__ inline void PrepassZa2First()
  {
    const int32_t bid = static_cast<int32_t>(AscendC::GetBlockIdx());
    if (bid < 16) PrepassZa2Block(bid);
    else PrepassZa2Block(bid);
  }
  __aicore__ inline void PrepassZa2Rest()
  {
    const int32_t bid = static_cast<int32_t>(AscendC::GetBlockIdx());
    for (int r = 1; r < 8; ++r) {
      const int g = bid + 20 * r;
      if (g >= 65) break;
      PrepassZa2Block(g);
    }
  }
  __aicore__ inline void IssueB(int32_t nStart, int nb0, int s)
  {
    const int kk = Ladder(s);
    const int k0 = LadderK0(s);
    const int ni = nStart == 0 ? 0 : 1;
    const int nbAll2 = NbOf(ni);
    const int nRows = (nbAll2 - nb0 >= 8 ? 8 : nbAll2 - nb0) * 16;
    auto b1 = b1Q_.AllocTensor<bfloat16_t>();
    const int64_t nGlob = static_cast<int64_t>(nStart) + nb0 * 16;
    int fromX2 = nRows;
    if (nGlob + nRows > 1024)
      fromX2 = static_cast<int>(1024 - nGlob);
    if (fromX2 < 0) fromX2 = 0;
    AscendC::Nd2NzParams p;
    p.ndNum = 1;
    p.dValue = kk;
    p.srcNdMatrixStride = 0;
    p.dstNzC0Stride = nRows;
    p.dstNzNStride = 1;
    p.dstNzMatrixStride = 0;
    if (fromX2 > 0) {
      p.nValue = static_cast<uint16_t>(fromX2);
      p.srcDValue = OK;
      AscendC::DataCopy(b1, x2b_[nGlob * OK + k0], p);
    }
    if (fromX2 < nRows) {
      p.nValue = static_cast<uint16_t>(nRows - fromX2);
      p.srcDValue = 1040;
      AscendC::DataCopy(b1[static_cast<int64_t>(fromX2) * 16],
        zt_[(nGlob + fromX2 - 1024) * 1040 + k0], p);
    }
    b1Q_.EnQue(b1);
  }
  __aicore__ inline void Compute()
  {
    const int mi = block_ / 4;
    const int ni = block_ % 4;
    const int mStart = mi * MR;
    const int nbAll = NbOf(ni);
    const int nStart = NsOf(ni);
    const int NBX = nbAll * 16;
    auto cacheT = cache_[static_cast<int64_t>(block_) * CACHE_FLOATS];
    auto aRes = aResBuf_.Get<bfloat16_t>();
    AscendC::DataCopyEnhancedParams aep;
    aep.blockMode = AscendC::BlockMode::BLOCK_MODE_VECTOR;
    AscendC::DataCopyParams arp0{16, 208, 832, 0};
    AscendC::DataCopy(aRes, za2_[static_cast<int64_t>(mStart) * 16],
             arp0, aep);
    const auto ev0 = pipe_.FetchEventID(AscendC::HardEvent::MTE2_MTE1);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(ev0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(ev0);
    int tileIdx = 0;
    for (int nb0 = 0; nb0 < nbAll; nb0 += 8) {
      const int ntb = nbAll - nb0 >= 8 ? 8 : nbAll - nb0;
      const int nRows = ntb * 16;
      auto c1 = c1Q_.AllocTensor<float>();
      IssueB(nStart, nb0, 0);
      for (int s = 0; s < Steps(); ++s) {
        const int kk = Ladder(s);
        const int k0 = LadderK0(s);
        const int KB = kk / 16;
        if (s == 2 && nb0 == 0) {
          AscendC::CrossCoreWaitFlag<2, PIPE_MTE1>(12);
          AscendC::DataCopyParams arp1{49, 208, 832, 0};
          AscendC::DataCopy(aRes[16 * MR * 16],
            za2_[16 * 16640 + static_cast<int64_t>(mStart) * 16],
            arp1, aep);
          const auto ev1 = pipe_.FetchEventID(
            AscendC::HardEvent::MTE2_MTE1);
          AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(ev1);
          AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(ev1);
        }
        if (s + 1 < Steps()) IssueB(nStart, nb0, s + 1);
        auto b1 = b1Q_.DeQue<bfloat16_t>();
        auto a2 = a2Q_.AllocTensor<bfloat16_t>();
        AscendC::LoadData2DParams ap;
        ap.startIndex = 0;
        ap.repeatTimes = static_cast<uint8_t>(KB);
        ap.srcStride = 13;
        ap.dstGap = 0;
        ap.ifTranspose = false;
        const int64_t kbase = static_cast<int64_t>(k0 / 16) * 3328;
        for (int mf = 0; mf < 13; ++mf)
          AscendC::LoadData(
            a2[static_cast<int64_t>(mf) * KB * 256],
            aRes[kbase + static_cast<int64_t>(mf) * 256], ap);
        a2Q_.EnQue(a2);
        auto b2 = b2Q_.AllocTensor<bfloat16_t>();
        AscendC::LoadData2DParams bp;
        bp.startIndex = 0;
        bp.repeatTimes = static_cast<uint8_t>(KB * ntb);
        bp.srcStride = 1;
        bp.dstGap = 0;
        bp.ifTranspose = false;
        AscendC::LoadData(b2, b1, bp);
        b2Q_.EnQue(b2);
        a2 = a2Q_.DeQue<bfloat16_t>();
        b2 = b2Q_.DeQue<bfloat16_t>();
        AscendC::MmadParams mp;
        mp.m = MR;
        mp.n = nRows;
        mp.k = kk;
        mp.cmatrixInitVal = (s == 0);
        AscendC::Mmad(c1, a2, b2, mp);
        a2Q_.FreeTensor(a2);
        b2Q_.FreeTensor(b2);
        b1Q_.FreeTensor(b1);
      }
      c1Q_.EnQue(c1);
      c1 = c1Q_.DeQue<float>();
      AscendC::FixpipeParamsV220 fp;
      fp.nSize = nRows;
      fp.mSize = MR;
      fp.srcStride = MR;
      fp.dstStride = NBX;
      fp.ndNum = 1;
      fp.srcNdStride = 0;
      fp.dstNdStride = 0;
      AscendC::Fixpipe(cacheT[static_cast<int64_t>(nb0) * 16], c1, fp);
      c1Q_.FreeTensor(c1);
      const auto fixed = pipe_.FetchEventID(AscendC::HardEvent::FIX_M);
      AscendC::SetFlag<AscendC::HardEvent::FIX_M>(fixed);
      AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(fixed);
      AscendC::CrossCoreSetFlag<2, PIPE_FIX>(3 + tileIdx);
      ++tileIdx;
    }
    AscendC::PipeBarrier<PIPE_ALL>();
  }
  __aicore__ inline void ReduceAll()
  {
    const int mi = block_ / 4;
    const int ni = block_ % 4;
    const int nbAll = NbOf(ni);
    const int NBX = nbAll * 16;
    const int validM = OM - mi * MR < MR ? OM - mi * MR : MR;
    const int tiles = (nbAll + 7) >> 3;
    const int HALF_ROWS = 104;
    AscendC::DataCopyPadExtParams<float> pad{};
    auto base = redBuf_.Get<float>();
    AscendC::Duplicate(base, batch_matmul_max_sum_v3::NEG_INF,
             4 * HALF_ROWS * PITCH);
    AscendC::PipeBarrier<PIPE_V>();
    for (int t = 0; t < tiles; ++t) {
      AscendC::CrossCoreWaitFlag<2, PIPE_MTE2>(3 + t);
      const int cLo = t * 128;
      const int cHi = cLo + 128 < NBX ? cLo + 128 : NBX;
      for (int h = 0; h < 2; ++h) {
        const int rows =
          validM - h * HALF_ROWS < HALF_ROWS ? validM - h * HALF_ROWS
                           : HALF_ROWS;
        if (rows <= 0) break;
        const int N = rows * PITCH;
        auto acc = base[h * HALF_ROWS * PITCH];
        auto c = base[(2 + h) * HALF_ROWS * PITCH];
        int c0 = cLo;
        while (c0 < cHi) {
          int len = cHi - c0;
          if (len > PITCH) len = PITCH;
          const auto wr = pipe_.FetchEventID(AscendC::HardEvent::V_MTE2);
          AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(wr);
          AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(wr);
          AscendC::DataCopyExtParams cc{
            static_cast<uint16_t>(rows),
            static_cast<uint32_t>(len * 4),
            static_cast<uint32_t>((NBX - len) * 4),
            static_cast<uint32_t>((PITCH - len) / 8), 0};
          AscendC::DataCopyPad(c, cache_[
            static_cast<int64_t>(block_) * CACHE_FLOATS +
            static_cast<int64_t>(h * HALF_ROWS) * NBX + c0], cc, pad);
          const auto ld = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
          AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(ld);
          AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(ld);
          AscendC::Max(acc, acc, c, N);
          AscendC::PipeBarrier<PIPE_V>();
          c0 += len;
        }
      }
    }
    for (int h = 0; h < 2; ++h) {
      const int rows =
        validM - h * HALF_ROWS < HALF_ROWS ? validM - h * HALF_ROWS
                         : HALF_ROWS;
      if (rows <= 0) break;
      uint32_t shape[2] = {static_cast<uint32_t>(rows),
                static_cast<uint32_t>(PITCH)};
      AscendC::ReduceMax<float, AscendC::Pattern::Reduce::AR, true>(
        rowMaxBuf_.Get<float>()[h * HALF_ROWS],
        base[h * HALF_ROWS * PITCH],
        reduceTmpBuf_.Get<uint8_t>(), shape, true);
      AscendC::PipeBarrier<PIPE_V>();
    }
  }
  __aicore__ inline void Publish()
  {
    const int mi = block_ / 4;
    const int validM = OM - mi * MR < MR ? OM - mi * MR : MR;
    const int64_t slot = static_cast<int64_t>(block_) * SLOT_FLOATS;
    auto flag = flagBuf_.Get<float>();
    AscendC::Duplicate(flag, nonce_, 8);
    const auto ready = pipe_.FetchEventID(AscendC::HardEvent::V_MTE3);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(ready);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(ready);
    AscendC::DataCopyExtParams rowsP{
      1, static_cast<uint32_t>(validM * sizeof(float)), 0, 0, 0};
    AscendC::DataCopyPad(slots_[slot], rowMaxBuf_.Get<float>(), rowsP);
    AscendC::DataCopyExtParams one{1, sizeof(float), 0, 0, 0};
    AscendC::DataCopyPad(slots_[slot + FLAG_OFF], flag, one);
    const auto done = pipe_.FetchEventID(AscendC::HardEvent::MTE3_V);
    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(done);
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(done);
  }
  __aicore__ inline void Fold()
  {
    auto flags = flagBuf_.Get<float>();
    AscendC::DataCopyPadExtParams<float> pad{};
    AscendC::DataCopyExtParams fg{TASKS, sizeof(float),
      SLOT_FLOATS * sizeof(float) - sizeof(float), 0, 0};
    for (int32_t attempt = 0; attempt < SPLIT_POLL_LIMIT; ++attempt) {
      AscendC::DataCopyPad(flags, slots_[FLAG_OFF], fg, pad);
      const auto m2v = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
      AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(m2v);
      AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(m2v);
      const auto v2s = pipe_.FetchEventID(AscendC::HardEvent::V_S);
      AscendC::SetFlag<AscendC::HardEvent::V_S>(v2s);
      AscendC::WaitFlag<AscendC::HardEvent::V_S>(v2s);
      bool ready = true;
      for (int i = 0; i < TASKS; ++i) {
        if (flags.GetValue(i * SPLIT_UB_SLOT_FLOATS) != nonce_) {
          ready = false;
          break;
        }
      }
      if (ready) break;
    }
    auto gathered = gatherBuf_.Get<float>();
    AscendC::DataCopyExtParams rg{4, MR * sizeof(float),
      SLOT_FLOATS * sizeof(float) - MR * sizeof(float), 0, 0};
    auto fold = foldBuf_.Get<float>();
    auto tmp = reduceTmpBuf_.Get<float>();
    auto out = outBuf_.Get<float>();
    float total = 0.0F;
    for (int mi = 0; mi < MS; ++mi) {
      AscendC::DataCopyPad(
        gathered, slots_[static_cast<int64_t>(mi * NSC) * SLOT_FLOATS],
        rg, pad);
      const auto m2v = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
      AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(m2v);
      AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(m2v);
      const int validM = OM - mi * MR < MR ? OM - mi * MR : MR;
      const int cnt = validM;
      AscendC::Adds(fold, gathered, 0.0F, cnt);
      AscendC::PipeBarrier<PIPE_V>();
      for (int ni = 1; ni < NSC; ++ni) {
        AscendC::Max(fold, fold, gathered[ni * MR], cnt);
        AscendC::PipeBarrier<PIPE_V>();
      }
      AscendC::ReduceSum<float>(out, fold, tmp, cnt);
      AscendC::PipeBarrier<PIPE_V>();
      const auto v2s = pipe_.FetchEventID(AscendC::HardEvent::V_S);
      AscendC::SetFlag<AscendC::HardEvent::V_S>(v2s);
      AscendC::WaitFlag<AscendC::HardEvent::V_S>(v2s);
      total += out.GetValue(0);
    }
    const auto s2v = pipe_.FetchEventID(AscendC::HardEvent::S_V);
    AscendC::SetFlag<AscendC::HardEvent::S_V>(s2v);
    AscendC::WaitFlag<AscendC::HardEvent::S_V>(s2v);
    AscendC::Duplicate(out, total, 8);
    const auto v2m3 = pipe_.FetchEventID(AscendC::HardEvent::V_MTE3);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(v2m3);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(v2m3);
    y_.SetValue(0, total);
    (void)out;
  }
  int32_t block_ = 0;
  float nonce_ = 1.0F;
  AscendC::TPipe pipe_;
  AscendC::TBuf<AscendC::TPosition::A1> aResBuf_;
  AscendC::TQue<AscendC::TPosition::A2, 2> a2Q_;
  AscendC::TQue<AscendC::TPosition::B1, 2> b1Q_;
  AscendC::TQue<AscendC::TPosition::B2, 1> b2Q_;
  AscendC::TQue<AscendC::TPosition::CO1, 1> c1Q_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> redBuf_, rowMaxBuf_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> flagBuf_, gatherBuf_, foldBuf_, reduceTmpBuf_;
  AscendC::TBuf<AscendC::TPosition::VECOUT> outBuf_;
  AscendC::GlobalTensor<uint16_t> x1u_, x2u_;
  AscendC::GlobalTensor<bfloat16_t> zt_, za2_, x2b_;
  __gm__ uint16_t* ztP_ = nullptr;
  __gm__ uint16_t* za2P_ = nullptr;
  AscendC::GlobalTensor<float> y_, cache_, slots_;
};
