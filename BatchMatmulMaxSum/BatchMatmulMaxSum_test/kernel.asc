  GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR tabs)
{
  VectorCase2V12 op;
  op.Init(x1, x2, y, tabs);
  op.Process();
}
class VectorCase2V13 {
public:
  __aicore__ static inline void Run(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR tabs)
  {
    AscendC::InitSocState();
    AscendC::GlobalTensor<uint16_t> x1u, x2u;
    AscendC::GlobalTensor<uint32_t> tg;
    AscendC::GlobalTensor<float> yg;
    x1u.SetGlobalBuffer(reinterpret_cast<__gm__ uint16_t*>(x1), 120);
    x2u.SetGlobalBuffer(reinterpret_cast<__gm__ uint16_t*>(x2), 200);
    tg.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t*>(tabs), batch_matmul_max_sum_v3::CASE2_V13_TAB);
    yg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y), 1);
    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ub;
    auto u8 = ub.Alloc<uint8_t, 25600>();
    auto raw = u8[0].ReinterpretCast<uint16_t>();
    auto f   = u8[1024].ReinterpretCast<float>();
    auto tab = u8[2560].ReinterpretCast<uint32_t>();
    auto G   = u8[10496].ReinterpretCast<float>();
    auto P   = u8[18432].ReinterpretCast<float>();
    auto r24 = u8[22528].ReinterpretCast<float>();
    auto rm  = u8[22784].ReinterpretCast<float>();
    auto out = u8[24064].ReinterpretCast<float>();
    const AscendC::DataCopyExtParams pa{1, 240, 0, 0, 0};
    const AscendC::DataCopyExtParams pb{1, 400, 0, 0, 0};
    const AscendC::DataCopyExtParams pt{1, batch_matmul_max_sum_v3::CASE2_V13_TAB * 4, 0, 0, 0};
    const AscendC::DataCopyPadExtParams<uint16_t> np16{};
    const AscendC::DataCopyPadExtParams<uint32_t> np32{};
    AscendC::DataCopyPad(raw, x1u[0], pa, np16);
    AscendC::DataCopyPad(raw[128], x2u[0], pb, np16);
    AscendC::DataCopyPad(tab, tg[0], pt, np32);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::Cast(f, raw.ReinterpretCast<bfloat16_t>(),
           AscendC::RoundMode::CAST_NONE, 328);
    AscendC::Gather<float>(G, f, tab, 0, batch_matmul_max_sum_v3::CASE2_V13_TAB);
    AscendC::Adds(G[1280], G[960], 0.0F, 320);
    AscendC::Adds(G[1600], G[960], 0.0F, 320);
    AscendC::Mul(P, G, G[960], 960);
    AscendC::WholeReduceSum<float>(r24, P, 40, 24, 1, 1, 5);
    AscendC::BlockReduceMax<float>(rm, r24, 1, 24, 1, 1, 8);
    AscendC::WholeReduceSum<float>(out, rm, 3, 1, 1, 1, 1);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    const AscendC::DataCopyExtParams po{1, 4, 0, 0, 0};
    AscendC::DataCopyPad(yg[0], out, po);
  }
};
extern "C" __global__ __vector__ void batch_matmul_case2_v13_bf16(
  GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR tabs)
{
  VectorCase2V13::Run(x1, x2, y, tabs);
}
class VectorCase2V14 {
public:
  __aicore__ static inline void Run(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR tabs)
  {
    AscendC::InitSocState();
    AscendC::GlobalTensor<uint16_t> x1u, x2u;
    AscendC::GlobalTensor<uint32_t> tg;
    AscendC::GlobalTensor<float> yg;
    x1u.SetGlobalBuffer(reinterpret_cast<__gm__ uint16_t*>(x1), 120);
    x2u.SetGlobalBuffer(reinterpret_cast<__gm__ uint16_t*>(x2), 200);
    tg.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t*>(tabs), batch_matmul_max_sum_v3::CASE2_V14_TAB);
    yg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y), 1);
    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ub;
    auto u8 = ub.Alloc<uint8_t, 25600>();
    auto raw = u8[0].ReinterpretCast<uint16_t>();
    auto f   = u8[1024].ReinterpretCast<float>();
    auto tab = u8[2560].ReinterpretCast<uint32_t>();
    auto G   = u8[6656].ReinterpretCast<float>();
    auto P   = u8[12800].ReinterpretCast<float>();
    auto r24 = u8[18432].ReinterpretCast<float>();
    auto rm  = u8[18560].ReinterpretCast<float>();
    auto out = u8[18688].ReinterpretCast<float>();
    const AscendC::DataCopyExtParams pa{1, 240, 0, 0, 0};
    const AscendC::DataCopyExtParams pb{1, 400, 0, 0, 0};
    const AscendC::DataCopyExtParams pt{1, batch_matmul_max_sum_v3::CASE2_V14_TAB * 4, 0, 0, 0};
    const AscendC::DataCopyPadExtParams<uint16_t> np16{};
    const AscendC::DataCopyPadExtParams<uint32_t> np32{};
    AscendC::DataCopyPad(raw, x1u[0], pa, np16);
    AscendC::DataCopyPad(raw[128], x2u[0], pb, np16);
    AscendC::DataCopyPad(tab, tg[0], pt, np32);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::Cast(f, raw.ReinterpretCast<bfloat16_t>(),
           AscendC::RoundMode::CAST_NONE, 328);
    AscendC::Gather<float>(G, f, tab, 0, batch_matmul_max_sum_v3::CASE2_V14_TAB);
    AscendC::Adds(G[320], G[280], 0.0F, 40, 3,
           AscendC::UnaryRepeatParams(1, 1, 5, 0));
    const AscendC::BinaryRepeatParams mp(1, 1, 1, 5, 0, 5);
    AscendC::Mul(P,      G[0],  G[120], 40, 8, mp);
    AscendC::Mul(P[320], G[40], G[120], 40, 8, mp);
    AscendC::Mul(P[640], G[80], G[120], 40, 8, mp);
    AscendC::WholeReduceSum<float>(r24, P, 40, 24, 1, 1, 5);
    AscendC::BlockReduceMax<float>(rm, r24, 1, 24, 1, 1, 8);
    AscendC::WholeReduceSum<float>(out, rm, 3, 1, 1, 1, 1);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    const AscendC::DataCopyExtParams po{1, 4, 0, 0, 0};
    AscendC::DataCopyPad(yg[0], out, po);
  }
};
extern "C" __global__ __vector__ void batch_matmul_case2_v14_bf16(
  GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR tabs)
{
  VectorCase2V14::Run(x1, x2, y, tabs);
}
