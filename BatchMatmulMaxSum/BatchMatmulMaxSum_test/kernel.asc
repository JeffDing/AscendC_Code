} \
extern "C" __global__ __aicore__ void batch_matmul_case3_g20_fp16(
  GM_ADDR x1, GM_ADDR x2, GM_ADDR y)
{
  const int64_t batch = AscendC::GetBlockIdx();
  if (batch >= 2) return;
  constexpr int32_t M = 7, N = 13, K = 48, NP = 16;
  constexpr uint32_t ROWB = K * sizeof(float) / 32;
  constexpr uint32_t PADB = NP * sizeof(float) / 32;
  AscendC::GlobalTensor<half> x1g, x2g;
  AscendC::GlobalTensor<float> yg;
  x1g.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(x1), 2 * M * K);
  x2g.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(x2), 2 * N * K);
  yg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y), 2);
  AscendC::LocalTensor<half> raw(AscendC::TPosition::VECIN, 0, (M + N) * K);
  AscendC::LocalTensor<float> a32(AscendC::TPosition::VECCALC, 2048, M * K);
  AscendC::LocalTensor<float> b32(AscendC::TPosition::VECCALC, 3392, NP * K);
  AscendC::LocalTensor<float> prod(AscendC::TPosition::VECCALC, 8192, M * NP * K);
  AscendC::LocalTensor<float> c(AscendC::TPosition::VECCALC, 32768, 256);
  AscendC::LocalTensor<float> rowMax(AscendC::TPosition::VECCALC, 34816, 64);
  AscendC::LocalTensor<float> out(AscendC::TPosition::VECOUT, 35840, 64);
  const AscendC::DataCopyExtParams copyA{1, static_cast<uint32_t>(M * K * sizeof(half)), 0, 0, 0};
  const AscendC::DataCopyExtParams copyB{1, static_cast<uint32_t>(N * K * sizeof(half)), 0, 0, 0};
  const AscendC::DataCopyPadExtParams<half> pad{};
  AscendC::DataCopyPad(raw, x1g[batch * M * K], copyA, pad);
  AscendC::DataCopyPad(raw[M * K], x2g[batch * N * K], copyB, pad);
  AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(0);
  AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(0);
  AscendC::Cast(a32, raw, AscendC::RoundMode::CAST_NONE, (M + N) * K);
  AscendC::Duplicate(b32[N * K], 0.0F, (NP - N) * K + 64);
  const AscendC::BinaryRepeatParams rp(1, 1, 1, ROWB, 0, ROWB);
  for (int32_t m = 0; m < M; ++m)
    AscendC::Mul(prod[m * NP * K], a32[m * K], b32,
          static_cast<uint64_t>(K), static_cast<uint8_t>(NP), rp);
  AscendC::WholeReduceSum<float>(c, prod, static_cast<int32_t>(K),
                 static_cast<int32_t>(M * NP), 1, 1, ROWB);
  const uint64_t nmask[2] = {(1ULL << N) - 1ULL, 0ULL};
  AscendC::WholeReduceMax<float>(rowMax, c, nmask, static_cast<int32_t>(M),
                 1, 1, PADB, AscendC::ReduceOrder::ORDER_ONLY_VALUE);
  AscendC::WholeReduceSum<float>(out, rowMax, static_cast<int32_t>(M),
                 1, 1, 1, 1);
  AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(0);
  AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(0);
  const AscendC::DataCopyExtParams one{1, sizeof(float), 0, 0, 0};
  AscendC::DataCopyPad(yg[batch], out, one);
}
