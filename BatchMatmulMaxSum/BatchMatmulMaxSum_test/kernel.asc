constexpr int32_t CASE14_CHUNK_N = CASE14_N / CASE14_SPLITS;
constexpr int32_t CASE14_SLOT_BYTES = 512;
constexpr int32_t CASE14_SLOT_FLOATS = CASE14_SLOT_BYTES / sizeof(float);
constexpr int32_t CASE14_FLAG_OFFSET = 64;
