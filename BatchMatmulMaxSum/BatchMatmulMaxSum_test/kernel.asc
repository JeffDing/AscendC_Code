{
  static int32_t v = BMM_CASE4_DEFAULT_TUNED;
  return v;
}
template <typename T>
class CubeCase14SplitN {
  using AType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, T, false>;
  using BType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, T, true>;
  using CType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float>;
  using BiasType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float>;
public:
  __aicore__ inline AscendC::TPipe* Pipe() { return &pipe_; }
  __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR tiles,
                DeviceTiling& tiling)
  {
    bm_ = tiling.baseM;
    bn_ = tiling.baseN;
    reduceN_ = bn_ < REDUCE_N ? bn_ : REDUCE_N;
    x1_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1), CASE14_M * CASE14_K);
    x2_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2), CASE14_N * CASE14_K);
    y_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y), 2048);
    auto* base = reinterpret_cast<__gm__ float*>(tiles);
    constexpr int64_t slabElems = static_cast<int64_t>(CASE14_M) * CASE14_CHUNK_N;
    cGm_.SetGlobalBuffer(base + AscendC::GetBlockIdx() * slabElems, slabElems);
    slots_.SetGlobalBuffer(base + static_cast<int64_t>(CASE14_SPLITS) * slabElems,
               CASE14_SPLITS * CASE14_SLOT_FLOATS);
    const uint32_t cBytes = CASE14_M * REDUCE_N * sizeof(float);
    pipe_.InitBuffer(cBuf_, cBytes);
    pipe_.InitBuffer(tileMaxBuf_, CASE14_M * sizeof(float));
    pipe_.InitBuffer(rowMaxBuf_, CASE14_M * sizeof(float));
    pipe_.InitBuffer(scratchBuf_, cBytes);
    pipe_.InitBuffer(flagBuf_, CASE14_SPLITS * SPLIT_UB_SLOT_FLOATS * sizeof(float));
    pipe_.InitBuffer(gatherBuf_, CASE14_SPLITS * CASE14_M * sizeof(float));
    pipe_.InitBuffer(foldBuf_, CASE14_M * sizeof(float));
    pipe_.InitBuffer(reduceTmpBuf_, SHORT_REDUCE_TMP_BYTES);
    pipe_.InitBuffer(outBuf_, 32);
  }
  __aicore__ inline void Process()
  {
    const int64_t split = AscendC::GetBlockIdx();
    if (split >= CASE14_SPLITS) return;
    const int64_t nStart = split * CASE14_CHUNK_N;
    const int32_t validN = CASE14_CHUNK_N;
    mm_.SetTensorA(x1_, false);
    mm_.SetTensorB(x2_[nStart * CASE14_K], true);
    mm_.SetTail(CASE14_M, validN, CASE14_K);
    mm_.template IterateAll<true>(cGm_);
    mm_.End();
    auto rowMax = rowMaxBuf_.Get<float>();
    AscendC::Duplicate(rowMax, NEG_INF, CASE14_M);
    AscendC::PipeBarrier<PIPE_V>();
    for (int32_t n0 = 0; n0 < validN; n0 += reduceN_) {
      const int32_t nv = validN - n0 < reduceN_ ?
               validN - n0 : reduceN_;
      auto c = cBuf_.Get<float>();
      const uint32_t paddedN = (nv + 7) / 8 * 8;
      if (paddedN < static_cast<uint32_t>(reduceN_)) {
        AscendC::Duplicate(c, NEG_INF, CASE14_M * reduceN_);
        AscendC::PipeBarrier<PIPE_V>();
      }
      const auto writable = pipe_.FetchEventID(AscendC::HardEvent::V_MTE2);
      AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(writable);
      AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(writable);
      AscendC::DataCopyExtParams copy{CASE14_M,
        static_cast<uint32_t>(nv * sizeof(float)),
        static_cast<uint32_t>((CASE14_CHUNK_N - nv) * sizeof(float)),
        static_cast<uint32_t>((reduceN_ - paddedN) / 8), 0};
      AscendC::DataCopyPadExtParams<float> pad{true, 0,
        static_cast<uint8_t>(paddedN - nv), NEG_INF};
      AscendC::DataCopyPad(c, cGm_[n0], copy, pad);
      const auto loaded = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
      AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(loaded);
      AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(loaded);
      auto tileMax = tileMaxBuf_.Get<float>();
      uint32_t shape[2] = {CASE14_M, static_cast<uint32_t>(reduceN_)};
      AscendC::ReduceMax<float, AscendC::Pattern::Reduce::AR, true>(
        tileMax, c, scratchBuf_.Get<uint8_t>(), shape, true);
      AscendC::PipeBarrier<PIPE_V>();
      AscendC::Max(rowMax, rowMax, tileMax, CASE14_M);
      AscendC::PipeBarrier<PIPE_V>();
    }
    Publish(split);
    if (split == 0) Fold();
  }
private:
  __aicore__ inline void Publish(int64_t split)
  {
    const int64_t slot = split * CASE14_SLOT_FLOATS;
    auto flag = flagBuf_.Get<float>();
    AscendC::Duplicate(flag, SPLIT_READY, 8);
    const auto ready = pipe_.FetchEventID(AscendC::HardEvent::V_MTE3);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(ready);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(ready);
    AscendC::DataCopyExtParams rows{1, CASE14_M * sizeof(float), 0, 0, 0};
    AscendC::DataCopyExtParams one{1, sizeof(float), 0, 0, 0};
    AscendC::DataCopyPad(slots_[slot], rowMaxBuf_.Get<float>(), rows);
    AscendC::DataCopyPad(slots_[slot + CASE14_FLAG_OFFSET], flag, one);
    const auto done = pipe_.FetchEventID(AscendC::HardEvent::MTE3_V);
    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(done);
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(done);
  }
  __aicore__ inline void Fold()
  {
    auto flags = flagBuf_.Get<float>();
    AscendC::DataCopyPadExtParams<float> pad{};
    AscendC::DataCopyExtParams flagGather{
      CASE14_SPLITS, sizeof(float), CASE14_SLOT_BYTES - sizeof(float), 0, 0};
    for (int32_t attempt = 0; attempt < SPLIT_POLL_LIMIT; ++attempt) {
      AscendC::DataCopyPad(flags, slots_[CASE14_FLAG_OFFSET], flagGather, pad);
      const auto loaded = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
      AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(loaded);
      AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(loaded);
      const auto scalar = pipe_.FetchEventID(AscendC::HardEvent::V_S);
      AscendC::SetFlag<AscendC::HardEvent::V_S>(scalar);
      AscendC::WaitFlag<AscendC::HardEvent::V_S>(scalar);
      bool all = true;
      for (int32_t p = 0; p < CASE14_SPLITS; ++p) {
        if (flags.GetValue(p * SPLIT_UB_SLOT_FLOATS) != SPLIT_READY) { all = false; break; }
      }
      if (all) break;
    }
    auto gathered = gatherBuf_.Get<float>();
    AscendC::DataCopyExtParams rowGather{
      CASE14_SPLITS, CASE14_M * sizeof(float),
      CASE14_SLOT_BYTES - CASE14_M * sizeof(float), 0, 0};
    AscendC::DataCopyPad(gathered, slots_[0], rowGather, pad);
    const auto rowsLoaded = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(rowsLoaded);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(rowsLoaded);
    auto fold = foldBuf_.Get<float>();
    AscendC::Adds(fold, gathered, 0.0F, CASE14_M);
    AscendC::PipeBarrier<PIPE_V>();
    for (int32_t p = 1; p < CASE14_SPLITS; ++p) {
      AscendC::Max(fold, fold, gathered[p * CASE14_M], CASE14_M);
      AscendC::PipeBarrier<PIPE_V>();
    }
    auto out = outBuf_.Get<float>();
    AscendC::ReduceSum<float>(out, fold, reduceTmpBuf_.Get<float>(), CASE14_M);
    const auto toGm = pipe_.FetchEventID(AscendC::HardEvent::V_MTE3);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(toGm);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(toGm);
    AscendC::DataCopyExtParams one{1, sizeof(float), 0, 0, 0};
    AscendC::DataCopyPad(y_[0], out, one);
    const auto stored = pipe_.FetchEventID(AscendC::HardEvent::MTE3_V);
    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(stored);
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(stored);
    AscendC::Duplicate(flags, 0.0F, CASE14_SPLITS * SPLIT_UB_SLOT_FLOATS);
    const auto zeroReady = pipe_.FetchEventID(AscendC::HardEvent::V_MTE3);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(zeroReady);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(zeroReady);
    AscendC::DataCopyExtParams clear{CASE14_SPLITS, sizeof(float), 0,
      CASE14_SLOT_BYTES - sizeof(float), 0};
    AscendC::DataCopyPad(slots_[CASE14_FLAG_OFFSET], flags, clear);
    const auto zeroDone = pipe_.FetchEventID(AscendC::HardEvent::MTE3_V);
    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(zeroDone);
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(zeroDone);
  }
  int32_t bm_, bn_, reduceN_;
  AscendC::TPipe pipe_;
  AscendC::TBuf<AscendC::TPosition::VECIN> cBuf_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> tileMaxBuf_, rowMaxBuf_, scratchBuf_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> flagBuf_, gatherBuf_, foldBuf_, reduceTmpBuf_;
  AscendC::TBuf<AscendC::TPosition::VECOUT> outBuf_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> nonceOut_;
public:
  AscendC::Matmul<AType, BType, CType, BiasType> mm_;
private:
  AscendC::GlobalTensor<T> x1_, x2_;
  AscendC::GlobalTensor<float> y_, cGm_, slots_;
};
class DirectMmadCase14SplitN {
public:
  static constexpr uint16_t SYNC_FLAG = 2;
  static constexpr int M = CASE14_M, K = CASE14_K;
  static constexpr int NCHUNK = CASE14_CHUNK_N;
  static constexpr int QUART = NCHUNK / 4;
  static constexpr int NQ = NCHUNK / QUART;
  static constexpr int NF = NCHUNK / 16;
  static constexpr int QF = QUART / 16;
  static constexpr int MF = M / 16;
  static constexpr int KF = K / 16;
  static constexpr int A1_ELEMS = M * K;
  static constexpr int B1_ELEMS = NCHUNK * K;
  static constexpr int A2_ELEMS = MF * KF * 256;
  static constexpr int B2_ELEMS = KF * QF * 256;
  static constexpr int C_ELEMS = M * QUART;
  static constexpr int RED_ROWS = M;
  static constexpr int RED_COLS = QUART;
  static constexpr int RED_CHUNKS = NCHUNK / QUART;
  static constexpr int LF_FLAGS = CASE14_SPLITS * M;
  static constexpr int LF_FLAG_FLOATS = CASE14_SPLITS * 8;
  static constexpr uint16_t BAR_FLAG = 9;
  __aicore__ inline AscendC::TPipe* Pipe() { return &pipe_; }
  __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR tiles)
  {
    block_ = static_cast<int32_t>(AscendC::GetBlockIdx());
#if defined(BMM_C14_PROBE) && BMM_C14_PROBE == 4
    return;
#endif
    x1u_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(x1),
              static_cast<int64_t>(M) * K);
    x2u_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(x2),
              static_cast<int64_t>(CASE14_N) * K);
    y_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y), 2048);
    auto* base = reinterpret_cast<__gm__ float*>(tiles);
    constexpr int64_t slabElems = static_cast<int64_t>(NCHUNK) * M;
    cGm_.SetGlobalBuffer(base + block_ * slabElems, slabElems);
    slots_.SetGlobalBuffer(base + static_cast<int64_t>(CASE14_SPLITS) * slabElems,
               CASE14_SPLITS * CASE14_SLOT_FLOATS);
#if defined(BMM_C14_HC) && BMM_C14_HC
    cGmH_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(base + block_ * slabElems),
               slabElems * 2);
#endif
    if ASCEND_IS_AIC {
      pipe_.InitBuffer(a1Q_, 1, A1_ELEMS * sizeof(bfloat16_t));
#if defined(BMM_C14_PB) && BMM_C14_PB
      pipe_.InitBuffer(b1Q_, 1, QUART * K * sizeof(bfloat16_t));
      pipe_.InitBuffer(b1Qb_, 1, QUART * K * sizeof(bfloat16_t));
      pipe_.InitBuffer(b1Qc_, 1, QUART * K * sizeof(bfloat16_t));
      pipe_.InitBuffer(b1Qd_, 1, QUART * K * sizeof(bfloat16_t));
#else
      pipe_.InitBuffer(b1Q_, 1, B1_ELEMS * sizeof(bfloat16_t));
#endif
      pipe_.InitBuffer(a2Q_, 1, A2_ELEMS * sizeof(bfloat16_t));
      pipe_.InitBuffer(b2Q_, 2, B2_ELEMS * sizeof(bfloat16_t));
#if defined(BMM_CASE14_E2) && BMM_CASE14_E2
      pipe_.InitBuffer(c1Q_, 2, C_ELEMS * sizeof(float));
#else
      pipe_.InitBuffer(c1Q_, 1, C_ELEMS * sizeof(float));
#endif
      return;
    }
    pipe_.InitBuffer(cBuf_, RED_ROWS * RED_COLS * sizeof(float));
#if defined(BMM_C14_QM) && BMM_C14_QM
    pipe_.InitBuffer(cBuf2_, RED_ROWS * RED_COLS * sizeof(float));
#endif
    pipe_.InitBuffer(tileMaxBuf_, M * sizeof(float));
    pipe_.InitBuffer(rowMaxBuf_, M * sizeof(float));
#if defined(BMM_C14_HC) && BMM_C14_HC
    pipe_.InitBuffer(tileMaxHBuf_, M * sizeof(half));
#endif
    pipe_.InitBuffer(scratchBuf_, RED_ROWS * RED_COLS * sizeof(float));
    pipe_.InitBuffer(flagBuf_, CASE14_SPLITS * SPLIT_UB_SLOT_FLOATS * sizeof(float));
    pipe_.InitBuffer(gatherBuf_, CASE14_SPLITS * M * sizeof(float));
    pipe_.InitBuffer(foldBuf_, M * sizeof(float));
    pipe_.InitBuffer(reduceTmpBuf_, SHORT_REDUCE_TMP_BYTES);
    pipe_.InitBuffer(outBuf_, 32);
  }
  __aicore__ inline void Process()
  {
    if (block_ >= CASE14_SPLITS) return;
    if ASCEND_IS_AIC {
#if defined(BMM_C14_PROBE) && (BMM_C14_PROBE == 3 || BMM_C14_PROBE == 4)
      return;
#else
      Compute();
      return;
#endif
    }
    if (AscendC::GetSubBlockIdx() != 0) return;
#if defined(BMM_C14_PROBE) && (BMM_C14_PROBE >= 2 && BMM_C14_PROBE <= 4)
    return;
#endif
#if defined(BMM_CASE14_E1) && BMM_CASE14_E1
    ReduceQ();
#else
    AscendC::CrossCoreWaitFlag<2, PIPE_MTE2>(SYNC_FLAG);
    ReduceQ();
#endif
    Publish(block_);
#if defined(BMM_C14_BAR) && BMM_C14_BAR
    AscendC::CrossCoreSetFlag<0, PIPE_MTE3>(BAR_FLAG);
    AscendC::CrossCoreWaitFlag<0, PIPE_MTE3>(BAR_FLAG);
#endif
#if !defined(BMM_C14_PROBE) || BMM_C14_PROBE < 1 || BMM_C14_PROBE == 5
    if (block_ == 0) Fold();
#endif
  }
private:
  __aicore__ inline void StageNZ(const AscendC::LocalTensor<bfloat16_t>& dst,
                 const AscendC::GlobalTensor<bfloat16_t>& src,
                 int rows, int d, int padRows, int srcD)
  {
    AscendC::Nd2NzParams p;
    p.ndNum = 1;
    p.nValue = rows;
    p.dValue = d;
    p.srcNdMatrixStride = 0;
    p.srcDValue = srcD;
    p.dstNzC0Stride = padRows;
    p.dstNzNStride = 1;
    p.dstNzMatrixStride = 0;
    AscendC::DataCopy(dst, src, p);
  }
  __aicore__ inline void SplitA(const AscendC::LocalTensor<bfloat16_t>& a2,
                 const AscendC::LocalTensor<bfloat16_t>& a1)
  {
    AscendC::LoadData2DParams p;
    p.startIndex = 0;
    p.dstGap = 0;
    p.ifTranspose = false;
#if defined(BMM_C14_SA) && BMM_C14_SA
    p.repeatTimes = static_cast<uint8_t>(KF);
    p.srcStride = MF;
    for (int mi = 0; mi < MF; ++mi)
      AscendC::LoadData(a2[static_cast<int64_t>(mi) * KF * 256],
               a1[static_cast<int64_t>(mi) * 256], p);
#else
    p.repeatTimes = 1;
    p.srcStride = 0;
    for (int mi = 0; mi < MF; ++mi)
      for (int ki = 0; ki < KF; ++ki)
        AscendC::LoadData(a2[static_cast<int64_t>(mi) * KF * 256 +
                     static_cast<int64_t>(ki) * 256],
                 a1[static_cast<int64_t>(ki) * MF * 256 +
                     static_cast<int64_t>(mi) * 256], p);
#endif
  }
  __aicore__ inline void SplitB(const AscendC::LocalTensor<bfloat16_t>& b2,
                 const AscendC::LocalTensor<bfloat16_t>& b1, int q)
  {
    AscendC::LoadData2DParams p;
    p.startIndex = 0;
    p.dstGap = 0;
    p.ifTranspose = false;
#if defined(BMM_C14_QB) && BMM_C14_QB
    p.repeatTimes = static_cast<uint8_t>(KF * QF);
    p.srcStride = 1;
    AscendC::LoadData(b2, b1[static_cast<int64_t>(q) * QUART * K], p);
#else
    p.repeatTimes = static_cast<uint8_t>(QF);
    p.srcStride = 1;
    const int nf0 = q * QF;
    for (int ki = 0; ki < KF; ++ki)
      AscendC::LoadData(b2[static_cast<int64_t>(ki) * QF * 256],
               b1[static_cast<int64_t>(ki) * NF * 256 +
                 static_cast<int64_t>(nf0) * 256], p);
#endif
  }
#if defined(BMM_C14_PB) && BMM_C14_PB
  __aicore__ inline void ComputePB(int64_t nStart)
  {
    auto a1 = a1Q_.AllocTensor<bfloat16_t>();
    StageNZ(a1, x1u_[0], M, K, M, K);
    a1Q_.EnQue(a1);
    auto bq0 = b1Q_.AllocTensor<bfloat16_t>();
    StageNZ(bq0, x2u_[nStart * K], QUART, K, QUART, K);
    b1Q_.EnQue(bq0);
    auto bq1 = b1Qb_.AllocTensor<bfloat16_t>();
    StageNZ(bq1, x2u_[(nStart + QUART) * K], QUART, K, QUART, K);
    b1Qb_.EnQue(bq1);
    auto bq2 = b1Qc_.AllocTensor<bfloat16_t>();
    StageNZ(bq2, x2u_[(nStart + 2 * QUART) * K], QUART, K, QUART, K);
    b1Qc_.EnQue(bq2);
    auto bq3 = b1Qd_.AllocTensor<bfloat16_t>();
    StageNZ(bq3, x2u_[(nStart + 3 * QUART) * K], QUART, K, QUART, K);
    b1Qd_.EnQue(bq3);
    a1 = a1Q_.DeQue<bfloat16_t>();
    auto a2 = a2Q_.AllocTensor<bfloat16_t>();
    SplitA(a2, a1);
    a2Q_.EnQue(a2);
    a2 = a2Q_.DeQue<bfloat16_t>();
    a1Q_.FreeTensor(a1);
    bq0 = b1Q_.DeQue<bfloat16_t>();
    auto b2 = b2Q_.AllocTensor<bfloat16_t>();
    SplitB(b2, bq0, 0);
    b2Q_.EnQue(b2);
    b1Q_.FreeTensor(bq0);
    for (int q = 0; q < NQ; ++q) {
      b2 = b2Q_.DeQue<bfloat16_t>();
      if (q + 1 < NQ) {
        auto b2n = b2Q_.AllocTensor<bfloat16_t>();
        if (q + 1 == 1) {
          bq1 = b1Qb_.DeQue<bfloat16_t>();
          SplitB(b2n, bq1, 0);
          b1Qb_.FreeTensor(bq1);
        } else if (q + 1 == 2) {
          bq2 = b1Qc_.DeQue<bfloat16_t>();
          SplitB(b2n, bq2, 0);
          b1Qc_.FreeTensor(bq2);
        } else {
          bq3 = b1Qd_.DeQue<bfloat16_t>();
          SplitB(b2n, bq3, 0);
          b1Qd_.FreeTensor(bq3);
        }
        b2Q_.EnQue(b2n);
      }
      auto c1 = c1Q_.AllocTensor<float>();
      AscendC::MmadParams mp;
      mp.m = M;
      mp.n = QUART;
      mp.k = K;
      mp.cmatrixInitVal = true;
      AscendC::Mmad(c1, a2, b2, mp);
      AscendC::PipeBarrier<PIPE_M>();
      c1Q_.EnQue(c1);
      b2Q_.FreeTensor(b2);
      c1 = c1Q_.DeQue<float>();
      AscendC::FixpipeParamsV220 fp;
      fp.nSize = QUART;
      fp.mSize = M;
      fp.srcStride = M;
      fp.dstStride = QUART;
      fp.ndNum = 1; fp.srcNdStride = 0; fp.dstNdStride = 0;
#if defined(BMM_C14_HC) && BMM_C14_HC
      fp.quantPre = QuantMode_t::F322F16;
      AscendC::Fixpipe(cGmH_[static_cast<int64_t>(q) * C_ELEMS], c1, fp);
#else
      AscendC::Fixpipe(cGm_[static_cast<int64_t>(q) * C_ELEMS], c1, fp);
#endif
      c1Q_.FreeTensor(c1);
#if !defined(BMM_CASE14_E2) || !BMM_CASE14_E2
      const auto fixed = pipe_.FetchEventID(AscendC::HardEvent::FIX_M);
      AscendC::SetFlag<AscendC::HardEvent::FIX_M>(fixed);
      AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(fixed);
#endif
#if defined(BMM_CASE14_E1) && BMM_CASE14_E1
      AscendC::CrossCoreSetFlag<2, PIPE_FIX>(3 + q);
#endif
    }
    a2Q_.FreeTensor(a2);
    AscendC::PipeBarrier<PIPE_ALL>();
#if defined(BMM_CASE14_E1) && BMM_CASE14_E1
    AscendC::CrossCoreSetFlag<2, PIPE_FIX>(3 + NQ);
#else
    AscendC::CrossCoreSetFlag<2, PIPE_FIX>(SYNC_FLAG);
#endif
  }
#endif
  __aicore__ inline void Compute()
  {
    const int64_t nStart = static_cast<int64_t>(block_) * NCHUNK;
#if defined(BMM_C14_PB) && BMM_C14_PB
    ComputePB(nStart);
    return;
#endif
    auto a1 = a1Q_.AllocTensor<bfloat16_t>();
    StageNZ(a1, x1u_[0], M, K, M, K);
    a1Q_.EnQue(a1);
    auto b1 = b1Q_.AllocTensor<bfloat16_t>();
#if defined(BMM_C14_QB) && BMM_C14_QB
    for (int q = 0; q < NQ; ++q)
      StageNZ(b1[static_cast<int64_t>(q) * QUART * K],
          x2u_[(nStart + static_cast<int64_t>(q) * QUART) * K],
          QUART, K, QUART, K);
#else
    StageNZ(b1, x2u_[nStart * K], NCHUNK, K, NCHUNK, K);
#endif
    b1Q_.EnQue(b1);
    a1 = a1Q_.DeQue<bfloat16_t>();
    b1 = b1Q_.DeQue<bfloat16_t>();
    auto a2 = a2Q_.AllocTensor<bfloat16_t>();
    SplitA(a2, a1);
    a2Q_.EnQue(a2);
    a2 = a2Q_.DeQue<bfloat16_t>();
    a1Q_.FreeTensor(a1);
    auto b2 = b2Q_.AllocTensor<bfloat16_t>();
    SplitB(b2, b1, 0);
    b2Q_.EnQue(b2);
    for (int q = 0; q < NQ; ++q) {
      b2 = b2Q_.DeQue<bfloat16_t>();
      if (q + 1 < NQ) {
        auto b2n = b2Q_.AllocTensor<bfloat16_t>();
        SplitB(b2n, b1, q + 1);
        b2Q_.EnQue(b2n);
      }
      auto c1 = c1Q_.AllocTensor<float>();
      AscendC::MmadParams mp;
      mp.m = M;
      mp.n = QUART;
      mp.k = K;
      mp.cmatrixInitVal = true;
      AscendC::Mmad(c1, a2, b2, mp);
      AscendC::PipeBarrier<PIPE_M>();
      c1Q_.EnQue(c1);
      b2Q_.FreeTensor(b2);
      c1 = c1Q_.DeQue<float>();
      AscendC::FixpipeParamsV220 fp;
      fp.nSize = QUART;
      fp.mSize = M;
      fp.srcStride = M;
      fp.dstStride = QUART;
      fp.ndNum = 1; fp.srcNdStride = 0; fp.dstNdStride = 0;
#if defined(BMM_C14_HC) && BMM_C14_HC
      fp.quantPre = QuantMode_t::F322F16;
      AscendC::Fixpipe(cGmH_[static_cast<int64_t>(q) * C_ELEMS], c1, fp);
#else
      AscendC::Fixpipe(cGm_[static_cast<int64_t>(q) * C_ELEMS], c1, fp);
#endif
      c1Q_.FreeTensor(c1);
#if !defined(BMM_CASE14_E2) || !BMM_CASE14_E2
      const auto fixed = pipe_.FetchEventID(AscendC::HardEvent::FIX_M);
      AscendC::SetFlag<AscendC::HardEvent::FIX_M>(fixed);
      AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(fixed);
#endif
#if defined(BMM_CASE14_E1) && BMM_CASE14_E1
      AscendC::CrossCoreSetFlag<2, PIPE_FIX>(3 + q);
#endif
    }
    a2Q_.FreeTensor(a2);
    b1Q_.FreeTensor(b1);
    AscendC::PipeBarrier<PIPE_ALL>();
#if defined(BMM_CASE14_E1) && BMM_CASE14_E1
    AscendC::CrossCoreSetFlag<2, PIPE_FIX>(3 + NQ);
#else
    AscendC::CrossCoreSetFlag<2, PIPE_FIX>(SYNC_FLAG);
#endif
  }
#if defined(BMM_C14_QM) && BMM_C14_QM
  __aicore__ inline void ReduceQ()
  {
    auto rowMax = rowMaxBuf_.Get<float>();
    auto acc = cBuf_.Get<half>();
    auto stage = cBuf2_.Get<half>();
    constexpr uint32_t TILE = RED_ROWS * RED_COLS;
    for (int c0 = 0; c0 < RED_CHUNKS; ++c0) {
      AscendC::CrossCoreWaitFlag<2, PIPE_MTE2>(3 + c0);
      auto dst = (c0 == 0) ? acc : stage;
      if (c0 > 0) {
        const auto writable = pipe_.FetchEventID(AscendC::HardEvent::V_MTE2);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(writable);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(writable);
      }
      AscendC::DataCopy(dst, cGmH_[static_cast<int64_t>(c0) * C_ELEMS], TILE);
      const auto loaded = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
      AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(loaded);
      AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(loaded);
      if (c0 > 0) {
        AscendC::Max(acc, acc, stage, TILE);
        AscendC::PipeBarrier<PIPE_V>();
      }
    }
    auto tileMaxH = tileMaxHBuf_.Get<half>();
    uint32_t shape[2] = {RED_ROWS, static_cast<uint32_t>(RED_COLS)};
    AscendC::ReduceMax<half, AscendC::Pattern::Reduce::AR, true>(
      tileMaxH, acc, scratchBuf_.Get<uint8_t>(), shape, true);
    AscendC::PipeBarrier<PIPE_V>();
    AscendC::Cast<float, half>(rowMax, tileMaxH,
                 AscendC::RoundMode::CAST_NONE, M);
    AscendC::PipeBarrier<PIPE_V>();
  }
#else
  __aicore__ inline void ReduceQ()
  {
    auto rowMax = rowMaxBuf_.Get<float>();
    AscendC::Duplicate(rowMax, NEG_INF, M);
    AscendC::PipeBarrier<PIPE_V>();
    for (int c0 = 0; c0 < RED_CHUNKS; ++c0) {
#ifndef BMM_CASE14_E1
      ;
#else
      AscendC::CrossCoreWaitFlag<2, PIPE_MTE2>(3 + c0);
#endif
      auto tileMax = tileMaxBuf_.Get<float>();
      uint32_t shape[2] = {RED_ROWS, static_cast<uint32_t>(RED_COLS)};
      const auto writable = pipe_.FetchEventID(AscendC::HardEvent::V_MTE2);
      AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(writable);
      AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(writable);
#if defined(BMM_C14_HC) && BMM_C14_HC
      auto c = cBuf_.Get<half>();
      AscendC::DataCopy(c, cGmH_[static_cast<int64_t>(c0) * C_ELEMS],
               static_cast<uint32_t>(RED_ROWS * RED_COLS));
      const auto loaded = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
      AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(loaded);
      AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(loaded);
      auto tileMaxH = tileMaxHBuf_.Get<half>();
      AscendC::ReduceMax<half, AscendC::Pattern::Reduce::AR, true>(
        tileMaxH, c, scratchBuf_.Get<uint8_t>(), shape, true);
      AscendC::PipeBarrier<PIPE_V>();
      AscendC::Cast<float, half>(tileMax, tileMaxH,
                   AscendC::RoundMode::CAST_NONE, M);
      AscendC::PipeBarrier<PIPE_V>();
#else
      auto c = cBuf_.Get<float>();
      AscendC::DataCopy(c, cGm_[static_cast<int64_t>(c0) * C_ELEMS],
               static_cast<uint32_t>(RED_ROWS * RED_COLS));
      const auto loaded = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
      AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(loaded);
      AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(loaded);
      AscendC::ReduceMax<float, AscendC::Pattern::Reduce::AR, true>(
        tileMax, c, scratchBuf_.Get<uint8_t>(), shape, true);
      AscendC::PipeBarrier<PIPE_V>();
#endif
      AscendC::Max(rowMax, rowMax, tileMax, M);
      AscendC::PipeBarrier<PIPE_V>();
    }
  }
#endif
  __aicore__ inline void Publish(int64_t split)
  {
#if defined(BMM_C14_LF) && BMM_C14_LF
    const int64_t slot = split * M;
    const int64_t flagSlot = LF_FLAGS + split * 8;
#else
    const int64_t slot = split * CASE14_SLOT_FLOATS;
    const int64_t flagSlot = slot + CASE14_FLAG_OFFSET;
#endif
    auto flag = flagBuf_.Get<float>();
    AscendC::Duplicate(flag, SPLIT_READY, 8);
    const auto ready = pipe_.FetchEventID(AscendC::HardEvent::V_MTE3);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(ready);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(ready);
    AscendC::DataCopyExtParams rows{1, M * sizeof(float), 0, 0, 0};
    AscendC::DataCopyExtParams one{1, sizeof(float), 0, 0, 0};
    AscendC::DataCopyPad(slots_[slot], rowMaxBuf_.Get<float>(), rows);
#if !defined(BMM_C14_BAR) || !BMM_C14_BAR
    AscendC::DataCopyPad(slots_[flagSlot], flag, one);
#endif
    const auto done = pipe_.FetchEventID(AscendC::HardEvent::MTE3_V);
    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(done);
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(done);
  }
  __aicore__ inline void Fold()
  {
    auto flags = flagBuf_.Get<float>();
    AscendC::DataCopyPadExtParams<float> pad{};
    AscendC::DataCopyExtParams flagGather{
      CASE14_SPLITS, sizeof(float), CASE14_SLOT_BYTES - sizeof(float), 0, 0};
#if (defined(BMM_C14_PROBE) && BMM_C14_PROBE == 5) || \
  (defined(BMM_C14_BAR) && BMM_C14_BAR)
    for (int32_t attempt = 0; attempt < 0; ++attempt) {
#else
    for (int32_t attempt = 0; attempt < SPLIT_POLL_LIMIT; ++attempt) {
#endif
#if defined(BMM_C14_LF) && BMM_C14_LF
      AscendC::DataCopy(flags, slots_[LF_FLAGS],
               static_cast<uint32_t>(LF_FLAG_FLOATS));
#else
      AscendC::DataCopyPad(flags, slots_[CASE14_FLAG_OFFSET], flagGather, pad);
#endif
      const auto loaded = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
      AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(loaded);
      AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(loaded);
      const auto scalar = pipe_.FetchEventID(AscendC::HardEvent::V_S);
      AscendC::SetFlag<AscendC::HardEvent::V_S>(scalar);
      AscendC::WaitFlag<AscendC::HardEvent::V_S>(scalar);
      bool all = true;
      for (int32_t p = 0; p < CASE14_SPLITS; ++p) {
        if (flags.GetValue(p * SPLIT_UB_SLOT_FLOATS) != SPLIT_READY) { all = false; break; }
      }
      if (all) break;
    }
    auto gathered = gatherBuf_.Get<float>();
    AscendC::DataCopyExtParams rowGather{
      CASE14_SPLITS, M * sizeof(float),
      CASE14_SLOT_BYTES - M * sizeof(float), 0, 0};
#if defined(BMM_C14_LF) && BMM_C14_LF
    AscendC::DataCopy(gathered, slots_[0],
             static_cast<uint32_t>(CASE14_SPLITS * M));
#else
    AscendC::DataCopyPad(gathered, slots_[0], rowGather, pad);
#endif
    const auto rowsLoaded = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(rowsLoaded);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(rowsLoaded);
    auto fold = foldBuf_.Get<float>();
#if defined(BMM_C14_FT) && BMM_C14_FT
    for (int32_t n = CASE14_SPLITS; n > 1; n >>= 1) {
      const int32_t h = (n >> 1) * M;
      AscendC::Max(gathered, gathered, gathered[h], h);
      AscendC::PipeBarrier<PIPE_V>();
    }
    auto out = outBuf_.Get<float>();
    AscendC::ReduceSum<float>(out, gathered, reduceTmpBuf_.Get<float>(), M);
#else
    AscendC::Adds(fold, gathered, 0.0F, M);
    AscendC::PipeBarrier<PIPE_V>();
    for (int32_t p = 1; p < CASE14_SPLITS; ++p) {
      AscendC::Max(fold, fold, gathered[p * M], M);
      AscendC::PipeBarrier<PIPE_V>();
    }
    auto out = outBuf_.Get<float>();
    AscendC::ReduceSum<float>(out, fold, reduceTmpBuf_.Get<float>(), M);
#endif
    const auto toGm = pipe_.FetchEventID(AscendC::HardEvent::V_MTE3);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(toGm);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(toGm);
    AscendC::DataCopyExtParams one{1, sizeof(float), 0, 0, 0};
    AscendC::DataCopyPad(y_[0], out, one);
    const auto stored = pipe_.FetchEventID(AscendC::HardEvent::MTE3_V);
    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(stored);
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(stored);
#if !defined(BMM_C14_BAR) || !BMM_C14_BAR
    AscendC::Duplicate(flags, 0.0F, CASE14_SPLITS * SPLIT_UB_SLOT_FLOATS);
    const auto zeroReady = pipe_.FetchEventID(AscendC::HardEvent::V_MTE3);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(zeroReady);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(zeroReady);
    AscendC::DataCopyExtParams clear{CASE14_SPLITS, sizeof(float), 0,
      CASE14_SLOT_BYTES - sizeof(float), 0};
#if defined(BMM_C14_LF) && BMM_C14_LF
    AscendC::DataCopy(slots_[LF_FLAGS], flags,
             static_cast<uint32_t>(LF_FLAG_FLOATS));
#else
    AscendC::DataCopyPad(slots_[CASE14_FLAG_OFFSET], flags, clear);
#endif
    const auto zeroDone = pipe_.FetchEventID(AscendC::HardEvent::MTE3_V);
    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(zeroDone);
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(zeroDone);
#endif
  }
  int32_t block_ = 0;
  AscendC::TPipe pipe_;
  AscendC::TQue<AscendC::TPosition::A1, 1> a1Q_;
  AscendC::TQue<AscendC::TPosition::A2, 1> a2Q_;
  AscendC::TQue<AscendC::TPosition::B1, 1> b1Q_, b1Qb_, b1Qc_, b1Qd_;
  AscendC::TQue<AscendC::TPosition::B2, 1> b2Q_;
  AscendC::TQue<AscendC::TPosition::CO1, 1> c1Q_;
  AscendC::TBuf<AscendC::TPosition::VECIN> cBuf_, cBuf2_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> tileMaxBuf_, rowMaxBuf_, scratchBuf_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> flagBuf_, gatherBuf_, foldBuf_, reduceTmpBuf_;
  AscendC::TBuf<AscendC::TPosition::VECOUT> outBuf_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> nonceOut_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> tileMaxHBuf_;
  AscendC::GlobalTensor<bfloat16_t> x1u_, x2u_;
  AscendC::GlobalTensor<float> y_, cGm_, slots_;
  AscendC::GlobalTensor<half> cGmH_;
};
constexpr int32_t CASE15_M = 64;
constexpr int32_t CASE15_N = 64;
constexpr int32_t CASE15_K = 8192;
constexpr int32_t CASE15_SPLITS = CASE15_K / CASE15_SPLIT_K;
constexpr int32_t CASE15_C_ELEMS = CASE15_M * CASE15_N;
constexpr int32_t CASE15_FLAG_SLOT_BYTES = 128;
constexpr int32_t CASE15_FLAG_SLOT_FLOATS = CASE15_FLAG_SLOT_BYTES / sizeof(float);
template <typename T>
class CubeCase15SplitK {
  using AType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, T, true>;
  using BType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, T, true>;
  using CType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float>;
  using BiasType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float>;
public:
  __aicore__ inline AscendC::TPipe* Pipe() { return &pipe_; }
  __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR tiles,
                DeviceTiling& tiling)
  {
    x1_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1), CASE15_K * CASE15_M);
    x2_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2), CASE15_N * CASE15_K);
    y_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y), 2048);
    auto* base = reinterpret_cast<__gm__ float*>(tiles);
    allPartials_.SetGlobalBuffer(base, CASE15_SPLITS * CASE15_C_ELEMS);
    partial_.SetGlobalBuffer(base + AscendC::GetBlockIdx() * CASE15_C_ELEMS,
                CASE15_C_ELEMS);
    flags_.SetGlobalBuffer(base + static_cast<int64_t>(CASE15_SPLITS) * CASE15_C_ELEMS,
               CASE15_SPLITS * CASE15_FLAG_SLOT_FLOATS);
    pipe_.InitBuffer(accumBuf_, CASE15_SPLITS * CASE15_C_ELEMS * sizeof(float));
    pipe_.InitBuffer(scratchBuf_, CASE15_C_ELEMS * sizeof(float));
    pipe_.InitBuffer(rowMaxBuf_, CASE15_M * sizeof(float));
    pipe_.InitBuffer(flagBuf_, CASE15_SPLITS * SPLIT_UB_SLOT_FLOATS * sizeof(float));
    pipe_.InitBuffer(reduceTmpBuf_, SHORT_REDUCE_TMP_BYTES);
    pipe_.InitBuffer(outBuf_, 32);
  }
  __aicore__ inline void Process()
  {
    const int64_t split = AscendC::GetBlockIdx();
    if (split >= CASE15_SPLITS) return;
    const int64_t kStart = split * CASE15_SPLIT_K;
    mm_.SetTensorA(x1_[kStart * CASE15_M], true);
    mm_.SetTensorB(x2_[kStart], true);
    mm_.SetTail(CASE15_M, CASE15_N, CASE15_SPLIT_K);
    mm_.template IterateAll<true>(partial_);
    mm_.End();
    PublishFlag(split);
    if (split == 0) Fold();
  }
private:
  __aicore__ inline void PublishFlag(int64_t split)
  {
    auto flag = flagBuf_.Get<float>();
    AscendC::Duplicate(flag, SPLIT_READY, 8);
    const int64_t slot = split * CASE15_FLAG_SLOT_FLOATS;
    const auto ready = pipe_.FetchEventID(AscendC::HardEvent::V_MTE3);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(ready);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(ready);
    AscendC::DataCopyExtParams one{1, sizeof(float), 0, 0, 0};
    AscendC::DataCopyPad(flags_[slot], flag, one);
    const auto done = pipe_.FetchEventID(AscendC::HardEvent::MTE3_V);
    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(done);
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(done);
  }
  __aicore__ inline void Fold()
  {
    auto localFlags = flagBuf_.Get<float>();
    AscendC::DataCopyPadExtParams<float> pad{};
    AscendC::DataCopyExtParams flagGather{CASE15_SPLITS, sizeof(float),
      CASE15_FLAG_SLOT_BYTES - sizeof(float), 0, 0};
    for (int32_t attempt = 0; attempt < SPLIT_POLL_LIMIT; ++attempt) {
      AscendC::DataCopyPad(localFlags, flags_[0], flagGather, pad);
      const auto loaded = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
      AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(loaded);
      AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(loaded);
      const auto scalar = pipe_.FetchEventID(AscendC::HardEvent::V_S);
      AscendC::SetFlag<AscendC::HardEvent::V_S>(scalar);
      AscendC::WaitFlag<AscendC::HardEvent::V_S>(scalar);
      bool all = true;
      for (int32_t p = 0; p < CASE15_SPLITS; ++p) {
        if (localFlags.GetValue(p * SPLIT_UB_SLOT_FLOATS) != SPLIT_READY) {
          all = false; break;
        }
      }
      if (all) break;
    }
    auto accum = accumBuf_.Get<float>();
    auto all = accum;
    const auto writable = pipe_.FetchEventID(AscendC::HardEvent::V_MTE2);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(writable);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(writable);
    AscendC::DataCopy(accum, allPartials_[0], CASE15_SPLITS * CASE15_C_ELEMS);
    const auto firstLoaded = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(firstLoaded);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(firstLoaded);
    for (int32_t p = 1; p < CASE15_SPLITS; ++p) {
      AscendC::Add(accum, accum, all[p * CASE15_C_ELEMS], CASE15_C_ELEMS);
    }
    AscendC::PipeBarrier<PIPE_V>();
    auto rowMax = rowMaxBuf_.Get<float>();
    uint32_t shape[2] = {CASE15_M, CASE15_N};
    AscendC::ReduceMax<float, AscendC::Pattern::Reduce::AR, true>(
      rowMax, accum, scratchBuf_.Get<uint8_t>(), shape, true);
    AscendC::PipeBarrier<PIPE_V>();
    auto out = outBuf_.Get<float>();
    AscendC::ReduceSum<float>(out, rowMax, reduceTmpBuf_.Get<float>(), CASE15_M);
    const auto readyOut = pipe_.FetchEventID(AscendC::HardEvent::V_MTE3);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(readyOut);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(readyOut);
    AscendC::DataCopyExtParams one{1, sizeof(float), 0, 0, 0};
    AscendC::DataCopyPad(y_[0], out, one);
    const auto outDone = pipe_.FetchEventID(AscendC::HardEvent::MTE3_V);
    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(outDone);
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outDone);
    AscendC::Duplicate(localFlags, 0.0F, CASE15_SPLITS * SPLIT_UB_SLOT_FLOATS);
    const auto zeroReady = pipe_.FetchEventID(AscendC::HardEvent::V_MTE3);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(zeroReady);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(zeroReady);
    AscendC::DataCopyExtParams clear{CASE15_SPLITS, sizeof(float), 0,
      CASE15_FLAG_SLOT_BYTES - sizeof(float), 0};
    AscendC::DataCopyPad(flags_[0], localFlags, clear);
    const auto zeroDone = pipe_.FetchEventID(AscendC::HardEvent::MTE3_V);
    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(zeroDone);
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(zeroDone);
  }
  AscendC::TPipe pipe_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> accumBuf_, scratchBuf_, rowMaxBuf_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> flagBuf_, reduceTmpBuf_;
  AscendC::TBuf<AscendC::TPosition::VECOUT> outBuf_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> nonceOut_;
public:
  AscendC::Matmul<AType, BType, CType, BiasType> mm_;
private:
  AscendC::GlobalTensor<T> x1_, x2_;
  AscendC::GlobalTensor<float> y_, partial_, allPartials_, flags_;
};
class DirectMmadCase15SplitK {
public:
  static constexpr int C15_FLAG_BASE = 2;
  static constexpr uint16_t SYNC_FLAG = 2;
  static constexpr int M = CASE15_M, N = CASE15_N, K = CASE15_K;
  static constexpr int SPLITS = CASE15_SPLITS;
  static constexpr int KPER = K / SPLITS;
  static constexpr int KSTEP = 256;
  static constexpr int KSTEP_PER_SPLIT = KPER / KSTEP;
  static constexpr int MB = M / 16;
  static constexpr int KB = KSTEP / 16;
  static constexpr int KFRACS = KPER / 16;
  static constexpr int NB = N / 16;
  static constexpr int A_ELEMS = N * KPER;
  static constexpr int B_ELEMS = KPER * M;
  static constexpr int A2_ELEMS = NB * KB * 256;
  static constexpr int B2_ELEMS = KB * MB * 256;
  static constexpr int C_ELEMS = CASE15_C_ELEMS;
  static constexpr int B1_CHUNK_ELEMS = KSTEP * M;
  static constexpr int ACC_H_ELEMS = SPLITS * C_ELEMS;
  static constexpr int ACC_F_ELEMS = 2 * CASE15_M;
  __aicore__ inline AscendC::TPipe* Pipe() { return &pipe_; }
  __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR tiles,
                float nonce)
  {
    block_ = static_cast<int32_t>(AscendC::GetBlockIdx());
    nonce_ = nonce;
    x1_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(x1),
              static_cast<int64_t>(K) * M);
    x2_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(x2),
              static_cast<int64_t>(N) * K);
    y_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y), 2048);
    auto* baseH = reinterpret_cast<__gm__ half*>(tiles);
    allPartialsH_.SetGlobalBuffer(baseH, SPLITS * C_ELEMS);
    partialH_.SetGlobalBuffer(
      baseH + static_cast<int64_t>(block_) * C_ELEMS, C_ELEMS);
    flags_.SetGlobalBuffer(
      reinterpret_cast<__gm__ float*>(baseH + SPLITS * C_ELEMS),
      SPLITS * CASE15_FLAG_SLOT_FLOATS);
    if ASCEND_IS_AIC {
      pipe_.InitBuffer(a1Q_, 1, A_ELEMS * sizeof(half));
      pipe_.InitBuffer(a2Q_, 2, A2_ELEMS * sizeof(half));
      pipe_.InitBuffer(b1Q_, 2, B1_CHUNK_ELEMS * sizeof(half));
      pipe_.InitBuffer(b2Q_, 2, B2_ELEMS * sizeof(half));
      pipe_.InitBuffer(c1Q_, 1, C_ELEMS * sizeof(float));
      return;
    }
    pipe_.InitBuffer(accumBuf_, ACC_H_ELEMS * sizeof(half) +
                   ACC_F_ELEMS * sizeof(float));
    pipe_.InitBuffer(flagBuf_, SPLITS * SPLIT_UB_SLOT_FLOATS * sizeof(float));
    pipe_.InitBuffer(outBuf_, 32);
  }
  __aicore__ inline void Process()
  {
    if (block_ >= SPLITS) return;
    if ASCEND_IS_AIC {
      Compute();
      return;
    }
    if (AscendC::GetSubBlockIdx() != 0) return;
    AscendC::CrossCoreWaitFlag<2, PIPE_MTE2>(SYNC_FLAG);
    if (block_ != 0) {
      PublishFlag(block_);
      return;
    }
    Fold();
  }
private:
  __aicore__ inline void StageA(const AscendC::LocalTensor<half>& a1, int64_t k0)
  {
    AscendC::Nd2NzParams p;
    p.ndNum = 1;
    p.nValue = N;
    p.dValue = KPER;
    p.srcNdMatrixStride = 0;
    p.srcDValue = K;
    p.dstNzC0Stride = N;
    p.dstNzNStride = 1;
    p.dstNzMatrixStride = 0;
    AscendC::DataCopy(a1, x2_[k0], p);
  }
  __aicore__ inline void StageB(const AscendC::LocalTensor<half>& b1, int64_t k0)
  {
    AscendC::Nd2NzParams p;
    p.ndNum = 1;
    p.nValue = KPER;
    p.dValue = M;
    p.srcNdMatrixStride = 0;
    p.srcDValue = M;
    p.dstNzC0Stride = KPER;
    p.dstNzNStride = 1;
    p.dstNzMatrixStride = 0;
    AscendC::DataCopy(b1, x1_[k0 * M], p);
  }
  __aicore__ inline void SplitA(const AscendC::LocalTensor<half>& a2,
                 const AscendC::LocalTensor<half>& a1, int step)
  {
    AscendC::LoadData2DParams p;
    p.startIndex = 0;
    p.repeatTimes = KB;
    p.srcStride = NB;
    p.dstGap = 0;
    p.ifTranspose = false;
    const int kf0 = step * KB;
    for (int ni = 0; ni < NB; ++ni)
      AscendC::LoadData(a2[ni * KB * 256],
               a1[static_cast<int64_t>(kf0) * NB * 256 + ni * 256], p);
  }
  __aicore__ inline void SplitB(const AscendC::LocalTensor<half>& b2,
                 const AscendC::LocalTensor<half>& b1, int step)
  {
    AscendC::LoadData2DParams p;
    p.startIndex = 0;
    p.repeatTimes = MB;
    p.srcStride = KFRACS;
    p.dstGap = 0;
    p.ifTranspose = true;
    const int kf0 = step * KB;
    for (int kb = 0; kb < KB; ++kb)
      AscendC::LoadData(b2[kb * MB * 256], b1[(kf0 + kb) * 256], p);
  }
  __aicore__ inline void StageBChunk(const AscendC::LocalTensor<half>& b1,
                   int64_t k0, int chunk)
  {
    AscendC::Nd2NzParams p;
    p.ndNum = 1;
    p.nValue = KSTEP;
    p.dValue = M;
    p.srcNdMatrixStride = 0;
    p.srcDValue = M;
    p.dstNzC0Stride = KSTEP;
    p.dstNzNStride = 1;
    p.dstNzMatrixStride = 0;
    AscendC::DataCopy(b1, x1_[(k0 + static_cast<int64_t>(chunk) * KSTEP) * M], p);
  }
  __aicore__ inline void SplitBChunk(const AscendC::LocalTensor<half>& b2,
                   const AscendC::LocalTensor<half>& b1)
  {
    AscendC::LoadData2DParams p;
    p.startIndex = 0;
    p.repeatTimes = MB;
    p.srcStride = KB;
    p.dstGap = 0;
    p.ifTranspose = true;
    for (int kb = 0; kb < KB; ++kb)
      AscendC::LoadData(b2[kb * MB * 256], b1[kb * 256], p);
  }
  __aicore__ inline void Compute()
  {
    const int64_t k0 = static_cast<int64_t>(block_) * KPER;
    auto a1 = a1Q_.AllocTensor<half>();
    StageA(a1, k0);
    a1Q_.EnQue(a1);
    auto b1f = b1Q_.AllocTensor<half>();
    StageBChunk(b1f, k0, 0);
    b1Q_.EnQue(b1f);
    a1 = a1Q_.DeQue<half>();
    auto c1 = c1Q_.AllocTensor<float>();
    for (int chunk = 0; chunk < KSTEP_PER_SPLIT; ++chunk) {
      auto b1 = b1Q_.DeQue<half>();
      if (chunk + 1 < KSTEP_PER_SPLIT) {
        auto b1n = b1Q_.AllocTensor<half>();
        StageBChunk(b1n, k0, chunk + 1);
        b1Q_.EnQue(b1n);
      }
      auto a2 = a2Q_.AllocTensor<half>();
      SplitA(a2, a1, chunk);
      auto b2 = b2Q_.AllocTensor<half>();
      SplitBChunk(b2, b1);
      a2Q_.EnQue(a2);
      b2Q_.EnQue(b2);
      a2 = a2Q_.DeQue<half>();
      b2 = b2Q_.DeQue<half>();
      AscendC::MmadParams mp;
      mp.m = N; mp.n = M; mp.k = KSTEP;
      mp.cmatrixInitVal = (chunk == 0);
      AscendC::Mmad(c1, a2, b2, mp);
      AscendC::PipeBarrier<PIPE_M>();
      a2Q_.FreeTensor(a2);
      b2Q_.FreeTensor(b2);
      b1Q_.FreeTensor(b1);
    }
    a1Q_.FreeTensor(a1);
    c1Q_.EnQue(c1);
    c1 = c1Q_.DeQue<float>();
    AscendC::FixpipeParamsV220 fp;
    fp.nSize = M;
    fp.mSize = N;
    fp.srcStride = N;
    fp.dstStride = M;
    fp.ndNum = 1; fp.srcNdStride = 0; fp.dstNdStride = 0;
    fp.quantPre = QuantMode_t::F322F16;
    AscendC::Fixpipe(partialH_, c1, fp);
    c1Q_.FreeTensor(c1);
    const auto fixed = pipe_.FetchEventID(AscendC::HardEvent::FIX_M);
    AscendC::SetFlag<AscendC::HardEvent::FIX_M>(fixed);
    AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(fixed);
    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::CrossCoreSetFlag<2, PIPE_FIX>(SYNC_FLAG);
  }
  __aicore__ inline void PublishFlag(int64_t split)
  {
    auto flag = flagBuf_.Get<float>();
    AscendC::Duplicate(flag, nonce_, 8);
    AscendC::PipeBarrier<PIPE_V>();
    const int64_t slot = split * CASE15_FLAG_SLOT_FLOATS;
    const auto ready = pipe_.FetchEventID(AscendC::HardEvent::V_MTE3);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(ready);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(ready);
    AscendC::DataCopyExtParams one{1, sizeof(float), 0, 0, 0};
    AscendC::DataCopyPad(flags_[slot], flag, one);
    const auto done = pipe_.FetchEventID(AscendC::HardEvent::MTE3_V);
    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(done);
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(done);
  }
  __aicore__ inline void Fold()
  {
    auto localFlags = flagBuf_.Get<float>();
    AscendC::DataCopyPadExtParams<float> pad{};
    AscendC::DataCopyExtParams flagGather{SPLITS, sizeof(float),
      CASE15_FLAG_SLOT_BYTES - sizeof(float), 0, 0};
    auto accBytes = accumBuf_.Get<uint8_t>();
    auto accumH = accBytes.ReinterpretCast<half>();
    auto rowMaxF = accBytes[ACC_H_ELEMS * sizeof(half)]
             .ReinterpretCast<float>();
    AscendC::DataCopy(accumH, partialH_, C_ELEMS);
    bool got[SPLITS];
    for (int p = 0; p < SPLITS; ++p) got[p] = false;
    got[0] = true;
    int remaining = SPLITS - 1;
    for (int32_t attempt = 0; attempt < SPLIT_POLL_LIMIT && remaining > 0;
      ++attempt) {
      AscendC::DataCopyPad(localFlags, flags_[0], flagGather, pad);
      const auto loaded = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
      AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(loaded);
      AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(loaded);
      const auto scalar = pipe_.FetchEventID(AscendC::HardEvent::V_S);
      AscendC::SetFlag<AscendC::HardEvent::V_S>(scalar);
      AscendC::WaitFlag<AscendC::HardEvent::V_S>(scalar);
      for (int32_t p = 1; p < SPLITS; ++p) {
        if (!got[p] && localFlags.GetValue(p * SPLIT_UB_SLOT_FLOATS) == nonce_) {
          AscendC::DataCopy(
            accumH[static_cast<int64_t>(p) * C_ELEMS],
            allPartialsH_[static_cast<int64_t>(p) * C_ELEMS],
            C_ELEMS);
          const auto pl = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
          AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(pl);
          AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(pl);
          got[p] = true;
          --remaining;
        }
      }
    }
    for (int h = SPLITS / 2; h >= 1; h >>= 1) {
      const int span = h * C_ELEMS;
      for (int off = 0; off < span; off += 2 * C_ELEMS) {
        const int cnt = (span - off >= 2 * C_ELEMS)
                ? 2 * C_ELEMS : C_ELEMS;
        AscendC::Add(accumH[off], accumH[off], accumH[off + span], cnt);
      }
      AscendC::PipeBarrier<PIPE_V>();
    }
    for (int rows = N / 2; rows >= 1; rows >>= 1) {
      AscendC::Max(accumH, accumH, accumH[rows * M], rows * M);
      AscendC::PipeBarrier<PIPE_V>();
    }
    AscendC::Cast<float, half>(rowMaxF, accumH,
                 AscendC::RoundMode::CAST_NONE, M);
    AscendC::PipeBarrier<PIPE_V>();
    auto out = outBuf_.Get<float>();
    AscendC::WholeReduceSum<float>(out, rowMaxF, M, 1, 1, 1, 8);
    const auto readyOut = pipe_.FetchEventID(AscendC::HardEvent::V_MTE3);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(readyOut);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(readyOut);
    AscendC::DataCopyExtParams one{1, sizeof(float), 0, 0, 0};
    AscendC::DataCopyPad(y_[0], out, one);
  }
  AscendC::TPipe pipe_;
  AscendC::TQue<AscendC::TPosition::A1, 1> a1Q_;
  AscendC::TQue<AscendC::TPosition::A2, 1> a2Q_;
  AscendC::TQue<AscendC::TPosition::B1, 1> b1Q_;
  AscendC::TQue<AscendC::TPosition::B2, 1> b2Q_;
  AscendC::TQue<AscendC::TPosition::CO1, 1> c1Q_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> accumBuf_, scratchBuf_, rowMaxBuf_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> flagBuf_, reduceTmpBuf_;
  AscendC::TBuf<AscendC::TPosition::VECOUT> outBuf_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> nonceOut_;
  AscendC::GlobalTensor<half> x1_, x2_;
  AscendC::GlobalTensor<half> partialH_, allPartialsH_;
  AscendC::GlobalTensor<float> y_, flags_;
  int32_t block_ = 0;
  float nonce_ = 1.0F;
};
constexpr int32_t FINAL_C5_B = 8, FINAL_C5_M = 16, FINAL_C5_N = 32, FINAL_C5_K = 128;
constexpr int32_t FINAL_C13_M = 8192, FINAL_C13_N = 64, FINAL_C13_K = 128;
template <int HEIGHT, int WIDTH>
__aicore__ inline void FinalCopyND2NZ(const AscendC::LocalTensor<half>& dst,
                   const AscendC::GlobalTensor<half>& src)
{
  constexpr uint16_t widthBlocks = WIDTH / 16;
  for (int i = 0; i < widthBlocks; ++i) {
    AscendC::DataCopyParams p;
    p.blockCount = HEIGHT;
    p.blockLen = 1;
    p.srcStride = widthBlocks - 1;
    p.dstStride = 0;
    AscendC::DataCopy(dst[i * 16 * HEIGHT], src[i * 16], p);
  }
}
template <int HEIGHT, int WIDTH>
__aicore__ inline void FinalCopyNd2NzHw(const AscendC::LocalTensor<half>& dst,
                    const AscendC::GlobalTensor<half>& src)
{
  AscendC::Nd2NzParams p;
  p.ndNum = 1;
  p.nValue = HEIGHT;
  p.dValue = WIDTH;
  p.srcNdMatrixStride = 0;
  p.srcDValue = WIDTH;
  p.dstNzC0Stride = ((HEIGHT + 15) / 16) * 16;
  p.dstNzNStride = 1;
  p.dstNzMatrixStride = 0;
  AscendC::DataCopy(dst, src, p);
}
template <int M, int N, int K>
__aicore__ inline void FinalSplitA(const AscendC::LocalTensor<half>& a2,
                 const AscendC::LocalTensor<half>& a1)
{
  constexpr int mBlocks = M / 16;
  constexpr int kBlocks = K / 16;
  int srcOffset = 0;
  int dstOffset = 0;
  for (int i = 0; i < mBlocks; ++i) {
    AscendC::LoadData2DParams p;
    p.startIndex = 0;
    p.repeatTimes = kBlocks;
    p.srcStride = mBlocks;
    p.dstGap = 0;
    p.ifTranspose = false;
    AscendC::LoadData(a2[dstOffset], a1[srcOffset], p);
    srcOffset += 16 * 16;
    dstOffset += K * 16;
  }
}
template <int K, int N>
__aicore__ inline void FinalSplitB(const AscendC::LocalTensor<half>& b2,
                 const AscendC::LocalTensor<half>& b1)
{
  constexpr int nBlocks = N / 16;
  constexpr int kBlocks = K / 16;
  AscendC::LoadData2DParams p;
  p.startIndex = 0;
  p.repeatTimes = nBlocks;
  p.srcStride = kBlocks;
  p.dstGap = 0;
  p.ifTranspose = true;
  for (int kb = 0; kb < kBlocks; ++kb) {
    AscendC::LoadData(b2[kb * nBlocks * 16 * 16], b1[kb * 16 * 16], p);
  }
}
class DirectMmadCase5 {
public:
  static constexpr int A_ELEMS = FINAL_C5_M * FINAL_C5_K;
  static constexpr int B_ELEMS = FINAL_C5_K * FINAL_C5_N;
  static constexpr int C_ELEMS = FINAL_C5_M * FINAL_C5_N;
  static constexpr uint16_t SYNC_FLAG = 2;
  __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR scratch)
  {
    const int32_t batch = static_cast<int32_t>(AscendC::GetBlockIdx());
    batch_ = batch;
    aGm_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(x1) + batch * A_ELEMS, A_ELEMS);
    bGm_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(x2) + batch * B_ELEMS, B_ELEMS);
    y_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y), FINAL_C5_B);
    cGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scratch) + batch * C_ELEMS, C_ELEMS);
    if ASCEND_IS_AIC {
      pipe_.InitBuffer(a1Q_, 1, A_ELEMS * sizeof(half));
      pipe_.InitBuffer(a2Q_, 1, A_ELEMS * sizeof(half));
      pipe_.InitBuffer(b1Q_, 1, B_ELEMS * sizeof(half));
      pipe_.InitBuffer(b2Q_, 1, B_ELEMS * sizeof(half));
      pipe_.InitBuffer(c1Q_, 1, C_ELEMS * sizeof(float));
      return;
    }
    pipe_.InitBuffer(cBuf_, C_ELEMS * sizeof(float));
    pipe_.InitBuffer(redTmp_, SHORT_REDUCE_TMP_BYTES);
    pipe_.InitBuffer(outBuf_, 32);
  }
  __aicore__ inline void Process()
  {
    if (batch_ >= FINAL_C5_B) return;
    if ASCEND_IS_AIC {
      Compute();
      return;
    }
    Reduce();
  }
private:
  __aicore__ inline void Compute()
  {
    auto a1 = a1Q_.AllocTensor<half>();
    auto b1 = b1Q_.AllocTensor<half>();
    FinalCopyND2NZ<FINAL_C5_M, FINAL_C5_K>(a1, aGm_);
    FinalCopyND2NZ<FINAL_C5_K, FINAL_C5_N>(b1, bGm_);
    a1Q_.EnQue(a1); b1Q_.EnQue(b1);
    a1 = a1Q_.DeQue<half>();
    b1 = b1Q_.DeQue<half>();
    auto a2 = a2Q_.AllocTensor<half>();
    auto b2 = b2Q_.AllocTensor<half>();
    {
      constexpr int nBlocks = FINAL_C5_N / 16;
      constexpr int kBlocks = FINAL_C5_K / 16;
      AscendC::LoadData2DParams p;
      p.startIndex = 0;
      p.repeatTimes = kBlocks;
      p.srcStride = 1;
      p.dstGap = 0;
      p.ifTranspose = true;
      for (int nb = 0; nb < nBlocks; ++nb) {
        AscendC::LoadData(a2[nb * FINAL_C5_K * 16],
                 b1[nb * FINAL_C5_K * 16], p);
      }
    }
    {
      constexpr int kBlocks = FINAL_C5_K / 16;
      AscendC::LoadData2DParams p;
      p.startIndex = 0;
      p.repeatTimes = kBlocks;
      p.srcStride = 1;
      p.dstGap = 0;
      p.ifTranspose = false;
      AscendC::LoadData(b2, a1, p);
    }
    a2Q_.EnQue(a2); b2Q_.EnQue(b2);
    a1Q_.FreeTensor(a1); b1Q_.FreeTensor(b1);
    a2 = a2Q_.DeQue<half>();
    b2 = b2Q_.DeQue<half>();
    auto c1 = c1Q_.AllocTensor<float>();
    AscendC::MmadParams mp;
    mp.m = FINAL_C5_N;
    mp.n = FINAL_C5_M;
    mp.k = FINAL_C5_K;
    mp.cmatrixInitVal = true;
    AscendC::Mmad(c1, a2, b2, mp);
    AscendC::PipeBarrier<PIPE_M>();
    c1Q_.EnQue(c1);
    a2Q_.FreeTensor(a2); b2Q_.FreeTensor(b2);
    c1 = c1Q_.DeQue<float>();
    AscendC::FixpipeParamsV220 fp;
    fp.nSize = FINAL_C5_M;
    fp.mSize = FINAL_C5_N;
    fp.srcStride = (FINAL_C5_N + 15) / 16;
    fp.dstStride = FINAL_C5_M;
    fp.ndNum = 1; fp.srcNdStride = 0; fp.dstNdStride = 0;
    AscendC::Fixpipe(cGm_, c1, fp);
    c1Q_.FreeTensor(c1);
    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::CrossCoreSetFlag<2, PIPE_FIX>(SYNC_FLAG);
  }
  __aicore__ inline void Reduce()
  {
    AscendC::CrossCoreWaitFlag<2, PIPE_MTE2>(SYNC_FLAG);
    auto c = cBuf_.Get<float>();
    AscendC::DataCopy(c, cGm_, C_ELEMS);
    const auto m2v = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(m2v);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(m2v);
    auto redTmp = redTmp_.Get<float>();
    auto t = c;
    AscendC::Max<float>(t, t, t[256], 256);
    AscendC::PipeBarrier<PIPE_V>();
    AscendC::Max<float>(t, t, t[128], 128);
    AscendC::PipeBarrier<PIPE_V>();
    AscendC::Max<float>(t, t, t[64], 64);
    AscendC::PipeBarrier<PIPE_V>();
    AscendC::Max<float>(t, t, t[32], 32);
    AscendC::PipeBarrier<PIPE_V>();
    AscendC::Max<float>(t, t, t[16], 16);
    AscendC::PipeBarrier<PIPE_V>();
    AscendC::ReduceSum<float>(outBuf_.Get<float>(), t, redTmp, FINAL_C5_M);
    AscendC::PipeBarrier<PIPE_V>();
    const auto v2m3 = pipe_.FetchEventID(AscendC::HardEvent::V_MTE3);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(v2m3);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(v2m3);
    AscendC::DataCopyExtParams one{1, sizeof(float), 0, 0, 0};
    AscendC::DataCopyPad(y_[batch_], outBuf_.Get<float>(), one);
  }
private:
  int32_t batch_ = 0;
  AscendC::TPipe pipe_;
  AscendC::TQue<AscendC::TPosition::A1, 1> a1Q_;
  AscendC::TQue<AscendC::TPosition::A2, 1> a2Q_;
  AscendC::TQue<AscendC::TPosition::B1, 1> b1Q_;
  AscendC::TQue<AscendC::TPosition::B2, 1> b2Q_;
  AscendC::TQue<AscendC::TPosition::CO1, 1> c1Q_;
  AscendC::TBuf<AscendC::TPosition::VECIN> cBuf_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> redTmp_;
  AscendC::TBuf<AscendC::TPosition::VECOUT> outBuf_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> nonceOut_;
  AscendC::GlobalTensor<half> aGm_, bGm_;
  AscendC::GlobalTensor<float> y_, cGm_;
};
class DirectMmadCase5MixT {
public:
  static constexpr int A_ELEMS = FINAL_C5_M * FINAL_C5_K;
  static constexpr int B_ELEMS = FINAL_C5_K * FINAL_C5_N;
  static constexpr int C_ELEMS = FINAL_C5_M * FINAL_C5_N;
  static constexpr uint16_t SYNC_FLAG = 2;
  __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR scratch)
  {
    const int32_t batch = static_cast<int32_t>(AscendC::GetBlockIdx());
    batch_ = batch;
    aGm_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(x1) + batch * A_ELEMS, A_ELEMS);
    bGm_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(x2) + batch * B_ELEMS, B_ELEMS);
    y_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y), FINAL_C5_B);
    cGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scratch) + batch * C_ELEMS, C_ELEMS);
    if ASCEND_IS_AIC {
      pipe_.InitBuffer(a1Q_, 1, A_ELEMS * sizeof(half));
      pipe_.InitBuffer(a2Q_, 1, A_ELEMS * sizeof(half));
      pipe_.InitBuffer(b1Q_, 1, B_ELEMS * sizeof(half));
      pipe_.InitBuffer(b2Q_, 1, B_ELEMS * sizeof(half));
      pipe_.InitBuffer(c1Q_, 1, C_ELEMS * sizeof(float));
      return;
    }
    pipe_.InitBuffer(cBuf_, C_ELEMS * sizeof(float));
    pipe_.InitBuffer(redTmp_, SHORT_REDUCE_TMP_BYTES);
    pipe_.InitBuffer(outBuf_, 32);
  }
  __aicore__ inline void Process()
  {
    if (batch_ >= FINAL_C5_B) return;
    if ASCEND_IS_AIC {
      Compute();
      return;
    }
    Reduce();
  }
private:
  __aicore__ inline void Compute()
  {
    auto a1 = a1Q_.AllocTensor<half>();
    auto b1 = b1Q_.AllocTensor<half>();
    FinalCopyNd2NzHw<FINAL_C5_M, FINAL_C5_K>(a1, aGm_);
    FinalCopyNd2NzHw<FINAL_C5_K, FINAL_C5_N>(b1, bGm_);
    a1Q_.EnQue(a1); b1Q_.EnQue(b1);
    a1 = a1Q_.DeQue<half>();
    b1 = b1Q_.DeQue<half>();
    auto a2 = a2Q_.AllocTensor<half>();
    auto b2 = b2Q_.AllocTensor<half>();
    {
      constexpr int nBlocks = FINAL_C5_N / 16;
      constexpr int kBlocks = FINAL_C5_K / 16;
      AscendC::LoadData2DParams p;
      p.startIndex = 0;
      p.repeatTimes = kBlocks;
      p.srcStride = 1;
      p.dstGap = 0;
      p.ifTranspose = true;
      for (int nb = 0; nb < nBlocks; ++nb) {
        AscendC::LoadData(a2[nb * FINAL_C5_K * 16],
                 b1[nb * FINAL_C5_K * 16], p);
      }
    }
    {
      constexpr int kBlocks = FINAL_C5_K / 16;
      AscendC::LoadData2DParams p;
      p.startIndex = 0;
      p.repeatTimes = kBlocks;
      p.srcStride = 1;
      p.dstGap = 0;
      p.ifTranspose = false;
      AscendC::LoadData(b2, a1, p);
    }
    a2Q_.EnQue(a2); b2Q_.EnQue(b2);
    a1Q_.FreeTensor(a1); b1Q_.FreeTensor(b1);
    a2 = a2Q_.DeQue<half>();
    b2 = b2Q_.DeQue<half>();
    auto c1 = c1Q_.AllocTensor<float>();
    AscendC::MmadParams mp;
    mp.m = FINAL_C5_N;
    mp.n = FINAL_C5_M;
    mp.k = FINAL_C5_K;
    mp.cmatrixInitVal = true;
    AscendC::Mmad(c1, a2, b2, mp);
    AscendC::PipeBarrier<PIPE_M>();
    c1Q_.EnQue(c1);
    a2Q_.FreeTensor(a2); b2Q_.FreeTensor(b2);
    c1 = c1Q_.DeQue<float>();
    AscendC::FixpipeParamsV220 fp;
    fp.nSize = FINAL_C5_M;
    fp.mSize = FINAL_C5_N;
    fp.srcStride = (FINAL_C5_N + 15) / 16;
    fp.dstStride = FINAL_C5_M;
    fp.ndNum = 1; fp.srcNdStride = 0; fp.dstNdStride = 0;
    AscendC::Fixpipe(cGm_, c1, fp);
    c1Q_.FreeTensor(c1);
    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::CrossCoreSetFlag<2, PIPE_FIX>(SYNC_FLAG);
  }
  __aicore__ inline void Reduce()
  {
    AscendC::CrossCoreWaitFlag<2, PIPE_MTE2>(SYNC_FLAG);
    auto c = cBuf_.Get<float>();
    AscendC::DataCopy(c, cGm_, C_ELEMS);
    const auto m2v = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(m2v);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(m2v);
    auto t = c;
    AscendC::Max<float>(t, t, t[256], 256);
    AscendC::PipeBarrier<PIPE_V>();
    AscendC::Max<float>(t, t, t[128], 128);
    AscendC::PipeBarrier<PIPE_V>();
    AscendC::Max<float>(t, t, t[64], 64);
    AscendC::PipeBarrier<PIPE_V>();
    AscendC::Max<float>(t, t, t[32], 32);
    AscendC::PipeBarrier<PIPE_V>();
    AscendC::Max<float>(t, t, t[16], 16);
    AscendC::PipeBarrier<PIPE_V>();
    auto out = outBuf_.Get<float>();
    AscendC::ReduceSum<float>(out, t, redTmp_.Get<float>(), FINAL_C5_M);
    AscendC::PipeBarrier<PIPE_V>();
    const auto v2m3 = pipe_.FetchEventID(AscendC::HardEvent::V_MTE3);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(v2m3);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(v2m3);
    AscendC::DataCopyExtParams one{1, sizeof(float), 0, 0, 0};
    AscendC::DataCopyPad(y_[batch_], out, one);
    const auto done = pipe_.FetchEventID(AscendC::HardEvent::MTE3_V);
    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(done);
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(done);
  }
  int32_t batch_ = 0;
  AscendC::TPipe pipe_;
  AscendC::TQue<AscendC::TPosition::A1, 1> a1Q_;
  AscendC::TQue<AscendC::TPosition::A2, 1> a2Q_;
  AscendC::TQue<AscendC::TPosition::B1, 1> b1Q_;
  AscendC::TQue<AscendC::TPosition::B2, 1> b2Q_;
  AscendC::TQue<AscendC::TPosition::CO1, 1> c1Q_;
  AscendC::TBuf<AscendC::TPosition::VECIN> cBuf_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> redTmp_;
  AscendC::TBuf<AscendC::TPosition::VECOUT> outBuf_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> nonceOut_;
  AscendC::GlobalTensor<half> aGm_, bGm_;
  AscendC::GlobalTensor<float> y_, cGm_;
};
#ifndef BMM_C5F_SPLITEV
#define BMM_C5F_SPLITEV 1
#endif
#ifndef BMM_C5F_NOPBM
#define BMM_C5F_NOPBM 0
#endif
#ifndef BMM_C5_F16C
#define BMM_C5_F16C 1
#endif
class DirectMmadCase5Fast {
public:
  static constexpr int A_ELEMS = FINAL_C5_M * FINAL_C5_K;
  static constexpr int B_ELEMS = FINAL_C5_K * FINAL_C5_N;
  static constexpr int C_ELEMS = FINAL_C5_M * FINAL_C5_N;
  static constexpr uint16_t SYNC_FLAG = 2;
  __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR scratch,
                AscendC::TPipe* pipe)
  {
    const int32_t batch = static_cast<int32_t>(AscendC::GetBlockIdx());
    batch_ = batch;
    cGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scratch) + batch * C_ELEMS,
              C_ELEMS);
    if ASCEND_IS_AIC {
      aGm_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(x1) + batch * A_ELEMS,
                A_ELEMS);
      bGm_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(x2) + batch * B_ELEMS,
                B_ELEMS);
      pipe->InitBuffer(l1Buf_, (A_ELEMS + B_ELEMS) * sizeof(half));
      pipe->InitBuffer(a2Q_, 1, B_ELEMS * sizeof(half));
      pipe->InitBuffer(b2Q_, 1, A_ELEMS * sizeof(half));
      pipe->InitBuffer(c1Q_, 1, C_ELEMS * sizeof(float));
      return;
    }
    y_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y), FINAL_C5_B);
    pipe->InitBuffer(ubBuf_, C_ELEMS * sizeof(float) + 32);
  }
  __aicore__ inline void Process()
  {
    if ASCEND_IS_AIC {
      Compute();
      return;
    }
    Reduce();
  }
private:
  __aicore__ inline void Compute()
  {
    auto a1 = l1Buf_.Get<half>();
    auto b1 = a1[A_ELEMS];
    auto a2 = a2Q_.AllocTensor<half>();
    auto b2 = b2Q_.AllocTensor<half>();
    AscendC::LoadData2DParams pa;
    pa.startIndex = 0;
    pa.srcStride = 1;
    pa.dstGap = 0;
    AscendC::LoadData2DParams pb = pa;
    pa.repeatTimes = (FINAL_C5_N / 16) * (FINAL_C5_K / 16);
    pa.ifTranspose = true;
    pb.repeatTimes = FINAL_C5_K / 16;
    pb.ifTranspose = false;
#if BMM_C5F_SPLITEV
    FinalCopyNd2NzHw<FINAL_C5_M, FINAL_C5_K>(a1, aGm_);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);
    FinalCopyNd2NzHw<FINAL_C5_K, FINAL_C5_N>(b1, bGm_);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID1);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);
    AscendC::LoadData(b2, a1, pb);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID1);
    AscendC::LoadData(a2, b1, pa);
#else
    FinalCopyNd2NzHw<FINAL_C5_M, FINAL_C5_K>(a1, aGm_);
    FinalCopyNd2NzHw<FINAL_C5_K, FINAL_C5_N>(b1, bGm_);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);
    AscendC::LoadData(a2, b1, pa);
    AscendC::LoadData(b2, a1, pb);
#endif
    a2Q_.EnQue(a2);
    b2Q_.EnQue(b2);
    a2 = a2Q_.DeQue<half>();
    b2 = b2Q_.DeQue<half>();
    auto c1 = c1Q_.AllocTensor<float>();
    AscendC::MmadParams mp;
    mp.m = FINAL_C5_N;
    mp.n = FINAL_C5_M;
    mp.k = FINAL_C5_K;
    mp.cmatrixInitVal = true;
    AscendC::Mmad(c1, a2, b2, mp);
#if !BMM_C5F_NOPBM
    AscendC::PipeBarrier<PIPE_M>();
#endif
    c1Q_.EnQue(c1);
    a2Q_.FreeTensor(a2);
    b2Q_.FreeTensor(b2);
    c1 = c1Q_.DeQue<float>();
    AscendC::FixpipeParamsV220 fp;
    fp.nSize = FINAL_C5_M;
    fp.mSize = FINAL_C5_N;
    fp.srcStride = (FINAL_C5_N + 15) / 16;
    fp.dstStride = FINAL_C5_M;
    fp.ndNum = 1; fp.srcNdStride = 0; fp.dstNdStride = 0;
    AscendC::Fixpipe(cGm_, c1, fp);
    c1Q_.FreeTensor(c1);
    AscendC::CrossCoreSetFlag<2, PIPE_FIX>(SYNC_FLAG);
  }
  __aicore__ inline void Reduce()
  {
    AscendC::CrossCoreWaitFlag<2, PIPE_MTE2>(SYNC_FLAG);
    auto t = ubBuf_.Get<float>();
    AscendC::DataCopy(t, cGm_, C_ELEMS);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::Max<float>(t, t, t[256], 256);
    AscendC::Max<float>(t, t, t[128], 128);
    AscendC::Max<float>(t, t, t[64], 64);
    AscendC::Max<float>(t, t, t[32], 32);
    AscendC::Max<float>(t, t, t[16], 16);
    auto out = t[C_ELEMS];
    AscendC::WholeReduceSum<float>(out, t, FINAL_C5_M, 1, 1, 1, 8);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::DataCopyExtParams one{1, sizeof(float), 0, 0, 0};
    AscendC::DataCopyPad(y_[batch_], out, one);
  }
  int32_t batch_ = 0;
  AscendC::TBuf<AscendC::TPosition::A1> l1Buf_;
  AscendC::TQue<AscendC::TPosition::A2, 1> a2Q_;
  AscendC::TQue<AscendC::TPosition::B2, 1> b2Q_;
  AscendC::TQue<AscendC::TPosition::CO1, 1> c1Q_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> ubBuf_;
  AscendC::GlobalTensor<half> aGm_, bGm_;
  AscendC::GlobalTensor<float> y_, cGm_;
};
class DirectMmadCase5Lag {
public:
  static constexpr int A_ELEMS = FINAL_C5_M * FINAL_C5_K;
  static constexpr int B_ELEMS = FINAL_C5_K * FINAL_C5_N;
  static constexpr int C_ELEMS = FINAL_C5_M * FINAL_C5_N;
  static constexpr uint16_t SYNC_FLAG = 2;
  __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR scratch,
                AscendC::TPipe* pipe, int32_t mode)
  {
    const int32_t batch = static_cast<int32_t>(AscendC::GetBlockIdx());
    batch_ = batch;
    mode_ = mode;
    cGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scratch) + batch * C_ELEMS,
              C_ELEMS);
#if BMM_C5_F16C
    cGmH_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(scratch) +
                 batch * C_ELEMS,
               C_ELEMS);
#endif
    if ASCEND_IS_AIC {
      aGm_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(x1) + batch * A_ELEMS,
                A_ELEMS);
      bGm_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(x2) + batch * B_ELEMS,
                B_ELEMS);
      pipe->InitBuffer(l1Buf_, (A_ELEMS + B_ELEMS) * sizeof(half));
      pipe->InitBuffer(a2Q_, 1, B_ELEMS * sizeof(half));
      pipe->InitBuffer(b2Q_, 1, A_ELEMS * sizeof(half));
      pipe->InitBuffer(c1Q_, 1, C_ELEMS * sizeof(float));
      return;
    }
    y_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y), FINAL_C5_B);
#if BMM_C5_F16C
    pipe->InitBuffer(ubBuf_, C_ELEMS * sizeof(half));
    pipe->InitBuffer(castBuf_, C_ELEMS * sizeof(float) + 32);
#else
    pipe->InitBuffer(ubBuf_, C_ELEMS * sizeof(float) + 32);
#endif
  }
  __aicore__ inline void Process()
  {
    if ASCEND_IS_AIC {
      Compute();
      return;
    }
    Reduce();
  }
private:
  __aicore__ inline void Compute()
  {
    auto a1 = l1Buf_.Get<half>();
    auto b1 = a1[A_ELEMS];
    auto a2 = a2Q_.AllocTensor<half>();
    auto b2 = b2Q_.AllocTensor<half>();
    AscendC::LoadData2DParams pa;
    pa.startIndex = 0;
    pa.srcStride = 1;
    pa.dstGap = 0;
    AscendC::LoadData2DParams pb = pa;
    pa.repeatTimes = (FINAL_C5_N / 16) * (FINAL_C5_K / 16);
    pa.ifTranspose = true;
    pb.repeatTimes = FINAL_C5_K / 16;
    pb.ifTranspose = false;
#if BMM_C5F_SPLITEV
    FinalCopyNd2NzHw<FINAL_C5_M, FINAL_C5_K>(a1, aGm_);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);
    FinalCopyNd2NzHw<FINAL_C5_K, FINAL_C5_N>(b1, bGm_);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID1);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);
    AscendC::LoadData(b2, a1, pb);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID1);
    AscendC::LoadData(a2, b1, pa);
#else
    FinalCopyNd2NzHw<FINAL_C5_M, FINAL_C5_K>(a1, aGm_);
    FinalCopyNd2NzHw<FINAL_C5_K, FINAL_C5_N>(b1, bGm_);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);
    AscendC::LoadData(a2, b1, pa);
    AscendC::LoadData(b2, a1, pb);
#endif
    a2Q_.EnQue(a2);
    b2Q_.EnQue(b2);
    a2 = a2Q_.DeQue<half>();
    b2 = b2Q_.DeQue<half>();
    auto c1 = c1Q_.AllocTensor<float>();
    AscendC::MmadParams mp;
    mp.m = FINAL_C5_N;
    mp.n = FINAL_C5_M;
    mp.k = FINAL_C5_K;
    mp.cmatrixInitVal = true;
    AscendC::Mmad(c1, a2, b2, mp);
#if !BMM_C5F_NOPBM
    AscendC::PipeBarrier<PIPE_M>();
#endif
    c1Q_.EnQue(c1);
    a2Q_.FreeTensor(a2);
    b2Q_.FreeTensor(b2);
    c1 = c1Q_.DeQue<float>();
    AscendC::FixpipeParamsV220 fp;
    fp.nSize = FINAL_C5_M;
    fp.mSize = FINAL_C5_N;
    fp.srcStride = (FINAL_C5_N + 15) / 16;
    fp.dstStride = FINAL_C5_M;
    fp.ndNum = 1; fp.srcNdStride = 0; fp.dstNdStride = 0;
#if BMM_C5_F16C
    fp.quantPre = QuantMode_t::F322F16;
    AscendC::Fixpipe(cGmH_, c1, fp);
#else
    AscendC::Fixpipe(cGm_, c1, fp);
#endif
    c1Q_.FreeTensor(c1);
    if (mode_ == 0) {
      AscendC::CrossCoreSetFlag<2, PIPE_FIX>(SYNC_FLAG);
    }
  }
  __aicore__ inline void Reduce()
  {
    if (mode_ == 0) {
      AscendC::CrossCoreWaitFlag<2, PIPE_MTE2>(SYNC_FLAG);
    }
#if BMM_C5_F16C
    auto h = ubBuf_.Get<half>();
    AscendC::DataCopy(h, cGmH_, C_ELEMS);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    auto t = castBuf_.Get<float>();
    AscendC::Cast(t, h, AscendC::RoundMode::CAST_NONE, C_ELEMS);
    AscendC::PipeBarrier<PIPE_V>();
#else
    auto t = ubBuf_.Get<float>();
    AscendC::DataCopy(t, cGm_, C_ELEMS);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
#endif
    AscendC::Max<float>(t, t, t[256], 256);
    AscendC::Max<float>(t, t, t[128], 128);
    AscendC::Max<float>(t, t, t[64], 64);
    AscendC::Max<float>(t, t, t[32], 32);
    AscendC::Max<float>(t, t, t[16], 16);
    auto out = t[C_ELEMS];
    AscendC::WholeReduceSum<float>(out, t, FINAL_C5_M, 1, 1, 1, 8);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::DataCopyExtParams one{1, sizeof(float), 0, 0, 0};
    AscendC::DataCopyPad(y_[batch_], out, one);
  }
  int32_t batch_ = 0;
  int32_t mode_ = 0;
  AscendC::TBuf<AscendC::TPosition::A1> l1Buf_;
  AscendC::TQue<AscendC::TPosition::A2, 1> a2Q_;
  AscendC::TQue<AscendC::TPosition::B2, 1> b2Q_;
  AscendC::TQue<AscendC::TPosition::CO1, 1> c1Q_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> ubBuf_;
#if BMM_C5_F16C
  AscendC::TBuf<AscendC::TPosition::VECCALC> castBuf_;
  AscendC::GlobalTensor<half> cGmH_;
#endif
  AscendC::GlobalTensor<half> aGm_, bGm_;
  AscendC::GlobalTensor<float> y_, cGm_;
};
class DirectMmadCase6 {
public:
  static constexpr int B = 13, M = 23, N = 73, K = 192;
  static constexpr int MP = 32;
  static constexpr int NP = 80;
  static constexpr int KB = K / 16;
  static constexpr int NB = NP / 16;
  static constexpr int MB = MP / 16;
  static constexpr int A1_ELEMS = KB * MP * 16;
  static constexpr int B1_ELEMS = KB * NP * 16;
  static constexpr int A2_ELEMS = MB * KB * 256;
  static constexpr int B2_ELEMS = KB * NB * 256;
  static constexpr int C_ELEMS = MP * NP;
  static constexpr uint16_t SYNC_FLAG = 2;
  __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR scratch,
                int32_t mode = 0)
  {
    const int32_t batch = static_cast<int32_t>(AscendC::GetBlockIdx());
    batch_ = batch;
    mode_ = mode;
    aGm_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(x1) +
                static_cast<uint64_t>(batch) * M * K,
              static_cast<uint64_t>(M) * K);
    bGm_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(x2) +
                static_cast<uint64_t>(batch) * N * K,
              static_cast<uint64_t>(N) * K);
    y_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y), B);
    cGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scratch) +
                static_cast<uint64_t>(batch) * C_ELEMS,
              C_ELEMS);
    cGmH_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(scratch) +
                 static_cast<uint64_t>(batch) * C_ELEMS,
               C_ELEMS);
    if ASCEND_IS_AIC {
      pipe_.InitBuffer(a1Q_, 1, A1_ELEMS * sizeof(bfloat16_t));
      pipe_.InitBuffer(a2Q_, 1, A2_ELEMS * sizeof(bfloat16_t));
      pipe_.InitBuffer(b1Q_, 1, B1_ELEMS * sizeof(bfloat16_t));
      pipe_.InitBuffer(b2Q_, 1, B2_ELEMS * sizeof(bfloat16_t));
      pipe_.InitBuffer(c1Q_, 1, C_ELEMS * sizeof(float));
      return;
    }
    pipe_.InitBuffer(cBuf_, M * 128 * sizeof(float));
    pipe_.InitBuffer(rowBuf_, M * sizeof(float));
    pipe_.InitBuffer(redScratch_, M * 128 * sizeof(float));
    pipe_.InitBuffer(redTmp_, SHORT_REDUCE_TMP_BYTES);
    pipe_.InitBuffer(outBuf_, 32);
  }
  __aicore__ inline void Process()
  {
    if (batch_ >= B) return;
    if ASCEND_IS_AIC {
      Compute();
      return;
    }
    Reduce();
  }
private:
  template <int ROWS, int PAD_ROWS>
  __aicore__ inline void StageND2NZ(const AscendC::LocalTensor<bfloat16_t>& dst,
                   const AscendC::GlobalTensor<bfloat16_t>& src,
                   int dstRowOffset = 0, int srcRow = 0)
  {
    AscendC::Nd2NzParams p;
    p.ndNum = 1;
    p.nValue = ROWS;
    p.dValue = K;
    p.srcNdMatrixStride = 0;
    p.srcDValue = K;
    p.dstNzC0Stride = PAD_ROWS;
    p.dstNzNStride = 1;
    p.dstNzMatrixStride = 0;
    AscendC::DataCopy(dst[dstRowOffset * 16], src[srcRow * K], p);
  }
  __aicore__ inline void DupPadRows(const AscendC::LocalTensor<bfloat16_t>& dst,
                   const AscendC::GlobalTensor<bfloat16_t>& src,
                   int rows, int padRows)
  {
    if (mode_ == 1 || mode_ == 2) {
      AscendC::Nd2NzParams p;
      p.ndNum = static_cast<int8_t>(padRows - rows);
      p.nValue = 1;
      p.dValue = K;
      p.srcNdMatrixStride = 0;
      p.srcDValue = K;
      p.dstNzC0Stride = padRows;
      p.dstNzNStride = 1;
      p.dstNzMatrixStride = (mode_ == 1) ? 16 : 1;
      AscendC::DataCopy(dst[rows * 16], src[(rows - 1) * K], p);
      return;
    }
    for (int j = rows; j < padRows; ++j) {
      AscendC::Nd2NzParams p;
      p.ndNum = 1;
      p.nValue = 1;
      p.dValue = K;
      p.srcNdMatrixStride = 0;
      p.srcDValue = K;
      p.dstNzC0Stride = padRows;
      p.dstNzNStride = 1;
      p.dstNzMatrixStride = 0;
      AscendC::DataCopy(dst[j * 16], src[(rows - 1) * K], p);
    }
  }
  __aicore__ inline void Compute()
  {
    auto a1 = a1Q_.AllocTensor<bfloat16_t>();
    auto b1 = b1Q_.AllocTensor<bfloat16_t>();
    StageND2NZ<M, MP>(a1, aGm_);
    StageND2NZ<N, NP>(b1, bGm_);
    if (mode_ != 3) DupPadRows(b1, bGm_, N, NP);
    a1Q_.EnQue(a1); b1Q_.EnQue(b1);
    a1 = a1Q_.DeQue<bfloat16_t>();
    b1 = b1Q_.DeQue<bfloat16_t>();
    auto a2 = a2Q_.AllocTensor<bfloat16_t>();
    auto b2 = b2Q_.AllocTensor<bfloat16_t>();
    for (int mi = 0; mi < MB; ++mi) {
      AscendC::LoadData2DParams pa;
      pa.startIndex = 0;
      pa.repeatTimes = static_cast<uint8_t>(KB);
      pa.srcStride = static_cast<uint16_t>(MB);
      pa.dstGap = 0;
      pa.ifTranspose = false;
      AscendC::LoadData(a2[static_cast<int64_t>(mi) * KB * 256],
               a1[static_cast<int64_t>(mi) * 256], pa);
    }
    {
      AscendC::LoadData2DParams pb;
      pb.startIndex = 0;
      pb.repeatTimes = static_cast<uint8_t>(NB * KB);
      pb.srcStride = 1;
      pb.dstGap = 0;
      pb.ifTranspose = false;
      AscendC::LoadData(b2, b1, pb);
    }
    a2Q_.EnQue(a2); b2Q_.EnQue(b2);
    a1Q_.FreeTensor(a1); b1Q_.FreeTensor(b1);
    a2 = a2Q_.DeQue<bfloat16_t>();
    b2 = b2Q_.DeQue<bfloat16_t>();
    auto c1 = c1Q_.AllocTensor<float>();
    AscendC::MmadParams mp;
    mp.m = MP; mp.n = NP; mp.k = K;
    mp.cmatrixInitVal = true;
    AscendC::Mmad(c1, a2, b2, mp);
    AscendC::PipeBarrier<PIPE_M>();
    c1Q_.EnQue(c1);
    a2Q_.FreeTensor(a2); b2Q_.FreeTensor(b2);
    c1 = c1Q_.DeQue<float>();
    AscendC::FixpipeParamsV220 fp;
    fp.nSize = NP;
    fp.mSize = MP;
    fp.srcStride = MP;
    fp.dstStride = NP;
    fp.ndNum = 1; fp.srcNdStride = 0; fp.dstNdStride = 0;
    if (mode_ == 7) {
      fp.quantPre = QuantMode_t::F322F16;
      AscendC::Fixpipe(cGmH_, c1, fp);
    } else {
      AscendC::Fixpipe(cGm_, c1, fp);
    }
    c1Q_.FreeTensor(c1);
    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::CrossCoreSetFlag<2, PIPE_FIX>(2 + batch_);
  }
  __aicore__ inline void Reduce()
  {
    AscendC::CrossCoreWaitFlag<2, PIPE_MTE2>(2 + batch_);
    constexpr int32_t REDU_N = 80;
    if (mode_ == 7) {
      auto c16 = cBuf_.Get<half>();
      AscendC::DataCopyExtParams cph{static_cast<uint16_t>(M),
        static_cast<uint32_t>(N * sizeof(half)),
        static_cast<uint32_t>((REDU_N - N) * sizeof(half)), 0, 0};
      AscendC::DataCopyPadExtParams<half> padh{
        true, 0, static_cast<uint8_t>(REDU_N - N),
        static_cast<half>(-65504.0f)};
      AscendC::DataCopyPad(c16, cGmH_, cph, padh);
      const auto m2vh = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
      AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(m2vh);
      AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(m2vh);
      auto c32 = redScratch_.Get<float>();
      AscendC::Cast(c32, c16, AscendC::RoundMode::CAST_NONE, M * REDU_N);
      AscendC::PipeBarrier<PIPE_V>();
      auto rows = rowBuf_.Get<float>();
      uint32_t shape7[2] = {M, REDU_N};
      AscendC::ReduceMax<float, AscendC::Pattern::Reduce::AR, true>(
        rows, c32, redTmp_.Get<uint8_t>(), shape7, true);
      AscendC::PipeBarrier<PIPE_V>();
      auto out = outBuf_.Get<float>();
      AscendC::ReduceSum<float>(out, rows, redTmp_.Get<float>(), M);
      const auto v2m3h = pipe_.FetchEventID(AscendC::HardEvent::V_MTE3);
      AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(v2m3h);
      AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(v2m3h);
      AscendC::DataCopyExtParams oneh{1, sizeof(float), 0, 0, 0};
      AscendC::DataCopyPad(y_[batch_], out, oneh);
      return;
    }
    auto c = cBuf_.Get<float>();
    if (mode_ == 3) {
      AscendC::DataCopyExtParams cpl{static_cast<uint16_t>(M),
        static_cast<uint32_t>(N * sizeof(float)),
        static_cast<uint32_t>((REDU_N - N) * sizeof(float)), 0, 0};
      AscendC::DataCopyPadExtParams<float> padl{
        true, 0, static_cast<uint8_t>(REDU_N - N), -3.4028234663852886e+38f};
      AscendC::DataCopyPad(c, cGm_, cpl, padl);
    } else {
      AscendC::DataCopyExtParams cp{static_cast<uint16_t>(M),
        static_cast<uint32_t>(REDU_N * sizeof(float)), 0, 0, 0};
      AscendC::DataCopyPadExtParams<float> pad{false, 0, 0, 0.0f};
      AscendC::DataCopyPad(c, cGm_, cp, pad);
    }
    const auto m2v = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(m2v);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(m2v);
    auto rows = rowBuf_.Get<float>();
    uint32_t shape[2] = {M, REDU_N};
    AscendC::ReduceMax<float, AscendC::Pattern::Reduce::AR, true>(
      rows, c, redScratch_.Get<uint8_t>(), shape, true);
    AscendC::PipeBarrier<PIPE_V>();
    auto out = outBuf_.Get<float>();
    AscendC::ReduceSum<float>(out, rows, redTmp_.Get<float>(), M);
    const auto v2m3 = pipe_.FetchEventID(AscendC::HardEvent::V_MTE3);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(v2m3);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(v2m3);
    AscendC::DataCopyExtParams one{1, sizeof(float), 0, 0, 0};
    AscendC::DataCopyPad(y_[batch_], out, one);
  }
private:
  int32_t batch_ = 0;
  int32_t mode_ = 0;
  AscendC::TPipe pipe_;
  AscendC::TQue<AscendC::TPosition::A1, 1> a1Q_;
  AscendC::TQue<AscendC::TPosition::A2, 1> a2Q_;
  AscendC::TQue<AscendC::TPosition::B1, 1> b1Q_;
  AscendC::TQue<AscendC::TPosition::B2, 1> b2Q_;
  AscendC::TQue<AscendC::TPosition::CO1, 1> c1Q_;
  AscendC::TBuf<AscendC::TPosition::VECIN> cBuf_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> rowBuf_, redScratch_, redTmp_;
  AscendC::TBuf<AscendC::TPosition::VECOUT> outBuf_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> nonceOut_;
  AscendC::GlobalTensor<bfloat16_t> aGm_, bGm_;
  AscendC::GlobalTensor<float> y_, cGm_;
  AscendC::GlobalTensor<half> cGmH_;
};
template <int REPB>
class DirectMmadCase7 {
public:
  static constexpr int B = 16, M = 32, N = 128, K = 256;
  static constexpr int MB = M / 16, NB = N / 16, KB = K / 16;
  static constexpr int A1_ELEMS = MB * K * 16;
  static constexpr int B1_ELEMS = NB * K * 16;
  static constexpr int A2_ELEMS = MB * KB * 256;
  static constexpr int B2_ELEMS = KB * NB * 256;
  static constexpr int C_ELEMS = M * N;
  static constexpr uint16_t SYNC_FLAG = 2;
  __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR scratch)
  {
    const int32_t batch = static_cast<int32_t>(AscendC::GetBlockIdx());
    batch_ = batch;
    aGm_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(x1) +
                static_cast<int64_t>(batch) * K * M,
              static_cast<int64_t>(K) * M);
    bGm_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(x2) +
                static_cast<int64_t>(batch) * K * N,
              static_cast<int64_t>(K) * N);
    y_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y), B);
    cGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scratch) +
                static_cast<int64_t>(batch) * C_ELEMS,
              C_ELEMS);
    if ASCEND_IS_AIC {
      pipe_.InitBuffer(a1Q_, 1, A1_ELEMS * sizeof(half));
      pipe_.InitBuffer(a2Q_, 1, A2_ELEMS * sizeof(half));
      pipe_.InitBuffer(b1Q_, 1, B1_ELEMS * sizeof(half));
      pipe_.InitBuffer(b2Q_, 1, B2_ELEMS * sizeof(half));
      pipe_.InitBuffer(c1Q_, 1, C_ELEMS * sizeof(float));
      return;
    }
    pipe_.InitBuffer(cBuf_, M * N * sizeof(float));
    pipe_.InitBuffer(rowBuf_, M * sizeof(float));
    pipe_.InitBuffer(redScratch_, M * N * sizeof(float));
    pipe_.InitBuffer(redTmp_, SHORT_REDUCE_TMP_BYTES);
    pipe_.InitBuffer(outBuf_, 32);
  }
  __aicore__ inline void Process()
  {
    if (batch_ >= B) return;
    if ASCEND_IS_AIC {
      Compute();
      return;
    }
    Reduce();
  }
private:
  __aicore__ inline void Compute()
  {
    auto a1 = a1Q_.AllocTensor<half>();
    auto b1 = b1Q_.AllocTensor<half>();
    FinalCopyNd2NzHw<K, M>(a1, aGm_);
    FinalCopyNd2NzHw<K, N>(b1, bGm_);
    a1Q_.EnQue(a1); b1Q_.EnQue(b1);
    a1 = a1Q_.DeQue<half>();
    b1 = b1Q_.DeQue<half>();
    auto a2 = a2Q_.AllocTensor<half>();
    auto b2 = b2Q_.AllocTensor<half>();
    if (REPB) {
      for (int mi = 0; mi < MB; ++mi) {
        AscendC::LoadData2DParams p;
        p.repeatTimes = KB;
        p.srcStride = 1;
        p.ifTranspose = true;
        AscendC::LoadData(a2[mi * KB * 256], a1[mi * (K * 16)], p);
      }
    } else {
      for (int mi = 0; mi < MB; ++mi) {
        for (int ki = 0; ki < KB; ++ki) {
          AscendC::LoadData2DParams p;
          p.repeatTimes = 1;
          p.srcStride = 0;
          p.ifTranspose = true;
          AscendC::LoadData(a2[(mi * KB + ki) * 256],
                   a1[mi * (K * 16) + ki * 256], p);
        }
      }
    }
    if (REPB) {
      for (int kb = 0; kb < KB; ++kb) {
        AscendC::LoadData2DParams p;
        p.repeatTimes = NB;
        p.srcStride = KB;
        p.ifTranspose = true;
        AscendC::LoadData(b2[kb * NB * 256], b1[kb * 256], p);
      }
    } else {
      for (int kb = 0; kb < KB; ++kb) {
        for (int ni = 0; ni < NB; ++ni) {
          AscendC::LoadData2DParams p;
          p.repeatTimes = 1;
          p.srcStride = 0;
          p.ifTranspose = true;
          AscendC::LoadData(b2[(kb * NB + ni) * 256],
                   b1[ni * (K * 16) + kb * 256], p);
        }
      }
    }
    a2Q_.EnQue(a2); b2Q_.EnQue(b2);
    a1Q_.FreeTensor(a1); b1Q_.FreeTensor(b1);
    a2 = a2Q_.DeQue<half>();
    b2 = b2Q_.DeQue<half>();
    auto c1 = c1Q_.AllocTensor<float>();
    AscendC::MmadParams mp;
    mp.m = M; mp.n = N; mp.k = K;
    mp.cmatrixInitVal = true;
    AscendC::Mmad(c1, a2, b2, mp);
    AscendC::PipeBarrier<PIPE_M>();
    c1Q_.EnQue(c1);
    a2Q_.FreeTensor(a2); b2Q_.FreeTensor(b2);
    c1 = c1Q_.DeQue<float>();
    AscendC::FixpipeParamsV220 fp;
    fp.nSize = N;
    fp.mSize = M;
    fp.srcStride = M;
    fp.dstStride = N;
    fp.ndNum = 1; fp.srcNdStride = 0; fp.dstNdStride = 0;
    AscendC::Fixpipe(cGm_, c1, fp);
    c1Q_.FreeTensor(c1);
    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::CrossCoreSetFlag<2, PIPE_FIX>(SYNC_FLAG);
  }
  __aicore__ inline void Reduce()
  {
    AscendC::CrossCoreWaitFlag<2, PIPE_MTE2>(SYNC_FLAG);
    auto c = cBuf_.Get<float>();
    AscendC::DataCopyExtParams cp{static_cast<uint16_t>(M),
      static_cast<uint32_t>(N * sizeof(float)), 0, 0, 0};
    AscendC::DataCopyPadExtParams<float> pad{false, 0, 0, 0.0f};
    AscendC::DataCopyPad(c, cGm_, cp, pad);
    const auto m2v = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(m2v);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(m2v);
    auto rows = rowBuf_.Get<float>();
    uint32_t shape[2] = {M, N};
    AscendC::ReduceMax<float, AscendC::Pattern::Reduce::AR, true>(
      rows, c, redScratch_.Get<uint8_t>(), shape, true);
    AscendC::PipeBarrier<PIPE_V>();
    auto out = outBuf_.Get<float>();
    AscendC::ReduceSum<float>(out, rows, redTmp_.Get<float>(), M);
    const auto v2m3 = pipe_.FetchEventID(AscendC::HardEvent::V_MTE3);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(v2m3);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(v2m3);
    AscendC::DataCopyExtParams one{1, sizeof(float), 0, 0, 0};
    AscendC::DataCopyPad(y_[batch_], out, one);
  }
private:
  int32_t batch_ = 0;
  AscendC::TPipe pipe_;
  AscendC::TQue<AscendC::TPosition::A1, 1> a1Q_;
  AscendC::TQue<AscendC::TPosition::A2, 1> a2Q_;
  AscendC::TQue<AscendC::TPosition::B1, 1> b1Q_;
  AscendC::TQue<AscendC::TPosition::B2, 1> b2Q_;
  AscendC::TQue<AscendC::TPosition::CO1, 1> c1Q_;
  AscendC::TBuf<AscendC::TPosition::VECIN> cBuf_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> rowBuf_, redScratch_, redTmp_;
  AscendC::TBuf<AscendC::TPosition::VECOUT> outBuf_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> nonceOut_;
  AscendC::GlobalTensor<half> aGm_, bGm_;
  AscendC::GlobalTensor<float> y_, cGm_;
};
template <int KS>
class DirectMmadCase7K {
public:
  static constexpr int B = 16, M = 32, N = 128, K = 256;
  static constexpr int KC = K / KS;
  static constexpr int MB = M / 16, NB = N / 16, KCB = KC / 16;
  static constexpr int A1_ELEMS = MB * KC * 16;
  static constexpr int B1_ELEMS = NB * KC * 16;
  static constexpr int A2_ELEMS = MB * KCB * 256;
  static constexpr int B2_ELEMS = KCB * NB * 256;
  static constexpr int C_ELEMS = M * N;
  static constexpr uint16_t SYNC_FLAG = 2;
  static_assert(KC % 16 == 0, "chunk K must be a multiple of 16");
  __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR scratch,
                int32_t mode = 0)
  {
    const int32_t batch = static_cast<int32_t>(AscendC::GetBlockIdx());
    batch_ = batch;
    mode_ = mode;
    aGm_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(x1) +
                static_cast<int64_t>(batch) * K * M,
              static_cast<int64_t>(K) * M);
    bGm_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(x2) +
                static_cast<int64_t>(batch) * K * N,
              static_cast<int64_t>(K) * N);
    y_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y), B);
    cGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scratch) +
                static_cast<int64_t>(batch) * C_ELEMS,
              C_ELEMS);
#if BMM_C7_F16C
    cGmH_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(scratch) +
                 static_cast<int64_t>(batch) * C_ELEMS,
               C_ELEMS);
#endif
    if ASCEND_IS_AIC {
#if BMM_C7_LEANL1
      pipe_.InitBuffer(a1Buf_, 2 * A1_ELEMS * sizeof(half));
      pipe_.InitBuffer(b1Buf_, 2 * B1_ELEMS * sizeof(half));
#else
      pipe_.InitBuffer(a1Q_, 2, A1_ELEMS * sizeof(half));
      pipe_.InitBuffer(b1Q_, 2, B1_ELEMS * sizeof(half));
#endif
#if BMM_C7_LEANEV && !BMM_C7_LEANL1
      pipe_.InitBuffer(a2Buf_, 2 * A2_ELEMS * sizeof(half));
      pipe_.InitBuffer(b2Buf_, B2_ELEMS * sizeof(half));
      pipe_.InitBuffer(c1Buf_, C_ELEMS * sizeof(float));
#else
      pipe_.InitBuffer(a2Q_, 2, A2_ELEMS * sizeof(half));
      pipe_.InitBuffer(b2Q_, 1, B2_ELEMS * sizeof(half));
      pipe_.InitBuffer(c1Q_, 1, C_ELEMS * sizeof(float));
#endif
      return;
    }
#if BMM_C7_F16C
    pipe_.InitBuffer(cBuf_, M * N * sizeof(half));
    pipe_.InitBuffer(rowBuf_, M * sizeof(float));
    pipe_.InitBuffer(castBuf_, M * N * sizeof(float));
    pipe_.InitBuffer(redScratch_, M * N * sizeof(float));
#else
    pipe_.InitBuffer(cBuf_, M * N * sizeof(float));
    pipe_.InitBuffer(rowBuf_, M * sizeof(float));
    pipe_.InitBuffer(redScratch_, M * N * sizeof(float));
#endif
    pipe_.InitBuffer(redTmp_, SHORT_REDUCE_TMP_BYTES);
    pipe_.InitBuffer(outBuf_, 32);
  }
  __aicore__ inline void Process()
  {
    if (batch_ >= B) return;
    if ASCEND_IS_AIC {
      Compute();
      return;
    }
    Reduce();
  }
private:
  __aicore__ inline void LoadA(const AscendC::LocalTensor<half>& a2,
                const AscendC::LocalTensor<half>& a1)
  {
#if BMM_C7_RT_MERGE
    static_assert(KCB * 256 == KC * 16, "fractal identity must hold for the rt-merge");
    AscendC::LoadData2DParams p;
    p.startIndex = 0;
    p.repeatTimes = static_cast<uint8_t>(MB * KCB);
    p.srcStride = 1;
    p.dstGap = 0;
    p.ifTranspose = true;
    AscendC::LoadData(a2, a1, p);
#else
    for (int mi = 0; mi < MB; ++mi) {
      for (int ki = 0; ki < KCB; ++ki) {
        AscendC::LoadData2DParams p;
        p.startIndex = 0;
        p.repeatTimes = 1;
        p.srcStride = 0;
        p.dstGap = 0;
        p.ifTranspose = true;
        AscendC::LoadData(a2[(mi * KCB + ki) * 256],
                 a1[mi * (KC * 16) + ki * 256], p);
      }
    }
#endif
  }
  __aicore__ inline void LoadB(const AscendC::LocalTensor<half>& b2,
                const AscendC::LocalTensor<half>& b1)
  {
#if BMM_C7_RT_MERGE
    static_assert((KC * 16) % 256 == 0, "src stride must be a whole number of fractals");
    constexpr uint16_t kSrcStrideUnits = static_cast<uint16_t>((KC * 16) / 256);
    for (int kb = 0; kb < KCB; ++kb) {
      AscendC::LoadData2DParams p;
      p.startIndex = 0;
      p.repeatTimes = static_cast<uint8_t>(NB);
      p.srcStride = kSrcStrideUnits;
      p.dstGap = 0;
      p.ifTranspose = true;
      AscendC::LoadData(b2[(kb * NB) * 256],
               b1[kb * 256], p);
    }
#else
    for (int kb = 0; kb < KCB; ++kb) {
      for (int ni = 0; ni < NB; ++ni) {
        AscendC::LoadData2DParams p;
        p.startIndex = 0;
        p.repeatTimes = 1;
        p.srcStride = 0;
        p.dstGap = 0;
        p.ifTranspose = true;
        AscendC::LoadData(b2[(kb * NB + ni) * 256],
                 b1[ni * (KC * 16) + kb * 256], p);
      }
    }
#endif
  }
  __aicore__ inline void StageL1(int c)
  {
#if BMM_C7_LEANL1
    auto a1 = a1Buf_.Get<half>()[c * A1_ELEMS];
    auto b1 = b1Buf_.Get<half>()[c * B1_ELEMS];
    FinalCopyNd2NzHw<KC, M>(a1, aGm_[static_cast<int64_t>(c) * KC * M]);
    FinalCopyNd2NzHw<KC, N>(b1, bGm_[static_cast<int64_t>(c) * KC * N]);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(c);
#else
    auto a1 = a1Q_.template AllocTensor<half>();
    auto b1 = b1Q_.template AllocTensor<half>();
    FinalCopyNd2NzHw<KC, M>(a1, aGm_[static_cast<int64_t>(c) * KC * M]);
    FinalCopyNd2NzHw<KC, N>(b1, bGm_[static_cast<int64_t>(c) * KC * N]);
    a1Q_.EnQue(a1);
    b1Q_.EnQue(b1);
#endif
  }
  __aicore__ inline void Compute()
  {
#if BMM_C7_LEANEV && !BMM_C7_LEANL1
    auto c1 = c1Buf_.Get<float>();
    StageL1(0);
    for (int c = 0; c < KS; ++c) {
      if (c + 1 < KS) StageL1(c + 1);
      AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(c);
      auto a1 = a1Buf_.Get<half>()[c * A1_ELEMS];
      auto b1 = b1Buf_.Get<half>()[c * B1_ELEMS];
      auto a2 = a2Buf_.Get<half>()[c * A2_ELEMS];
      LoadA(a2, a1);
      auto b2 = b2Buf_.Get<half>();
      LoadB(b2, b1);
      AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(2 + c);
      AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(2 + c);
      AscendC::MmadParams mp;
      mp.m = M; mp.n = N; mp.k = KC;
      mp.cmatrixInitVal = (c == 0);
      AscendC::Mmad(c1, a2, b2, mp);
      AscendC::PipeBarrier<PIPE_M>();
    }
#elif BMM_C7_LEANL1
    auto c1 = c1Q_.template AllocTensor<float>();
    StageL1(0);
    for (int c = 0; c < KS; ++c) {
      if (c + 1 < KS) StageL1(c + 1);
      AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(c);
      auto a1 = a1Buf_.Get<half>()[c * A1_ELEMS];
      auto b1 = b1Buf_.Get<half>()[c * B1_ELEMS];
      auto a2 = a2Q_.template AllocTensor<half>();
      LoadA(a2, a1);
      auto b2 = b2Q_.template AllocTensor<half>();
      LoadB(b2, b1);
      a2Q_.EnQue(a2);
      b2Q_.EnQue(b2);
      a2 = a2Q_.template DeQue<half>();
      b2 = b2Q_.template DeQue<half>();
      AscendC::MmadParams mp;
      mp.m = M; mp.n = N; mp.k = KC;
      mp.cmatrixInitVal = (c == 0);
      AscendC::Mmad(c1, a2, b2, mp);
      AscendC::PipeBarrier<PIPE_M>();
      a2Q_.FreeTensor(a2);
      b2Q_.FreeTensor(b2);
    }
    c1Q_.EnQue(c1);
    c1 = c1Q_.template DeQue<float>();
#else
    auto c1 = c1Q_.template AllocTensor<float>();
    StageL1(0);
    for (int c = 0; c < KS; ++c) {
      if (c + 1 < KS) StageL1(c + 1);
      auto a1 = a1Q_.template DeQue<half>();
      auto b1 = b1Q_.template DeQue<half>();
      auto a2 = a2Q_.template AllocTensor<half>();
      LoadA(a2, a1);
      auto b2 = b2Q_.template AllocTensor<half>();
      LoadB(b2, b1);
      a2Q_.EnQue(a2);
      b2Q_.EnQue(b2);
      a1Q_.FreeTensor(a1);
      b1Q_.FreeTensor(b1);
      a2 = a2Q_.template DeQue<half>();
      b2 = b2Q_.template DeQue<half>();
      AscendC::MmadParams mp;
      mp.m = M; mp.n = N; mp.k = KC;
      mp.cmatrixInitVal = (c == 0);
      AscendC::Mmad(c1, a2, b2, mp);
      AscendC::PipeBarrier<PIPE_M>();
      a2Q_.FreeTensor(a2);
      b2Q_.FreeTensor(b2);
    }
    c1Q_.EnQue(c1);
    c1 = c1Q_.template DeQue<float>();
#endif
    AscendC::FixpipeParamsV220 fp;
    fp.nSize = N;
    fp.mSize = M;
    fp.srcStride = M;
    fp.dstStride = N;
    fp.ndNum = 1; fp.srcNdStride = 0; fp.dstNdStride = 0;
#if BMM_C7_F16C
    fp.quantPre = QuantMode_t::F322F16;
    AscendC::Fixpipe(cGmH_, c1, fp);
#else
    AscendC::Fixpipe(cGm_, c1, fp);
#endif
#if !BMM_C7_LEANEV || BMM_C7_LEANL1
    c1Q_.FreeTensor(c1);
#endif
    if (mode_ == 0) {
      AscendC::CrossCoreSetFlag<2, PIPE_FIX>(SYNC_FLAG);
    }
  }
  __aicore__ inline void Reduce()
  {
    if (mode_ == 0) {
      AscendC::CrossCoreWaitFlag<2, PIPE_MTE2>(SYNC_FLAG);
    }
#if BMM_C7_F16C
    auto c16 = cBuf_.Get<half>();
    AscendC::DataCopy(c16, cGmH_, C_ELEMS);
    const auto m2v = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(m2v);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(m2v);
    auto c = castBuf_.Get<float>();
    AscendC::Cast(c, c16, AscendC::RoundMode::CAST_NONE, C_ELEMS);
    AscendC::PipeBarrier<PIPE_V>();
#else
    auto c = cBuf_.Get<float>();
    AscendC::DataCopyExtParams cp{static_cast<uint16_t>(M),
      static_cast<uint32_t>(N * sizeof(float)), 0, 0, 0};
    AscendC::DataCopyPadExtParams<float> pad{false, 0, 0, 0.0f};
    AscendC::DataCopyPad(c, cGm_, cp, pad);
    const auto m2v = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(m2v);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(m2v);
#endif
    auto rows = rowBuf_.Get<float>();
    uint32_t shape[2] = {M, N};
    AscendC::ReduceMax<float, AscendC::Pattern::Reduce::AR, true>(
      rows, c, redScratch_.Get<uint8_t>(), shape, true);
    AscendC::PipeBarrier<PIPE_V>();
    auto out = outBuf_.Get<float>();
    AscendC::ReduceSum<float>(out, rows, redTmp_.Get<float>(), M);
    const auto v2m3 = pipe_.FetchEventID(AscendC::HardEvent::V_MTE3);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(v2m3);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(v2m3);
    AscendC::DataCopyExtParams one{1, sizeof(float), 0, 0, 0};
    AscendC::DataCopyPad(y_[batch_], out, one);
  }
private:
  int32_t batch_ = 0;
  int32_t mode_ = 0;
  AscendC::TPipe pipe_;
#if BMM_C7_LEANL1
  AscendC::TBuf<AscendC::TPosition::A1> a1Buf_;
  AscendC::TBuf<AscendC::TPosition::B1> b1Buf_;
#endif
#if BMM_C7_LEANEV && !BMM_C7_LEANL1
  AscendC::TBuf<AscendC::TPosition::A2> a2Buf_;
  AscendC::TBuf<AscendC::TPosition::B2> b2Buf_;
  AscendC::TBuf<AscendC::TPosition::CO1> c1Buf_;
#endif
#if !BMM_C7_LEANL1 || !(BMM_C7_LEANEV && !BMM_C7_LEANL1)
  AscendC::TQue<AscendC::TPosition::A1, 2> a1Q_;
  AscendC::TQue<AscendC::TPosition::A2, 2> a2Q_;
  AscendC::TQue<AscendC::TPosition::B1, 2> b1Q_;
  AscendC::TQue<AscendC::TPosition::B2, 1> b2Q_;
  AscendC::TQue<AscendC::TPosition::CO1, 1> c1Q_;
#endif
  AscendC::TBuf<AscendC::TPosition::VECIN> cBuf_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> rowBuf_, redScratch_, redTmp_;
#if BMM_C7_F16C
  AscendC::TBuf<AscendC::TPosition::VECCALC> castBuf_;
#endif
  AscendC::TBuf<AscendC::TPosition::VECOUT> outBuf_;
  AscendC::GlobalTensor<half> aGm_, bGm_;
  AscendC::GlobalTensor<float> y_, cGm_;
#if BMM_C7_F16C
  AscendC::GlobalTensor<half> cGmH_;
#endif
};
class DirectMmadCase13Mix {
public:
  static constexpr int CM = 128;
  static constexpr int HALF = 128;
  static constexpr int N = FINAL_C13_N;
  static constexpr int K = FINAL_C13_K;
  static constexpr int CHUNKS = FINAL_C13_M / CM;
  static constexpr int DEPTH = 4;
  static constexpr int A_ELEMS = CM * K;
  static constexpr int B_ELEMS = K * N;
  static constexpr int C_ELEMS = CM * N;
  static constexpr int H_ELEMS = HALF * N;
  static constexpr int SLOT_FLOATS = 32;
  static constexpr uint16_t FLAG_BASE = 2;
  static constexpr uint16_t ACK_BASE = 6;
  __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR scratch,
                int32_t blocks)
  {
    blocks_ = blocks;
    block_ = static_cast<int32_t>(AscendC::GetBlockIdx());
    aGm_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(x1), FINAL_C13_M * K);
    bGm_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(x2), B_ELEMS);
    y_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y), 2048);
    auto* base = reinterpret_cast<__gm__ float*>(scratch);
    slabs_.SetGlobalBuffer(base,
      static_cast<int64_t>(blocks) * DEPTH * C_ELEMS);
    slots_.SetGlobalBuffer(base + static_cast<int64_t>(blocks) * DEPTH * C_ELEMS,
               CHUNKS * SLOT_FLOATS);
    if ASCEND_IS_AIC {
      pipe_.InitBuffer(a1Q_, 2, A_ELEMS * sizeof(half));
      pipe_.InitBuffer(a2Q_, 2, A_ELEMS * sizeof(half));
      pipe_.InitBuffer(b1Q_, 1, B_ELEMS * sizeof(half));
      pipe_.InitBuffer(b2Q_, 1, B_ELEMS * sizeof(half));
      pipe_.InitBuffer(c1Q_, 2, C_ELEMS * sizeof(float));
      return;
    }
    pipe_.InitBuffer(cBuf_, C_ELEMS * sizeof(float));
    pipe_.InitBuffer(workBuf_, UB_WORK_BYTES);
  }
  static constexpr int UB_ROWS_F  = 0;
  static constexpr int UB_ACC     = 512;
  static constexpr int UB_PART    = 1024;
  static constexpr int UB_FLAGS   = 1056;
  static constexpr int UB_POLL    = 1088;
  static constexpr int UB_GATHER  = 1600;
  static constexpr int UB_OUT     = 2112;
  static constexpr int UB_TMP     = 4096;
  static constexpr int UB_WORK_BYTES = 8192;
  __aicore__ inline void Process()
  {
    if (block_ >= blocks_) return;
    if ASCEND_IS_AIC {
      Compute();
      return;
    }
    if (AscendC::GetSubBlockIdx() != 0) return;
    Reduce();
    Publish();
    if (block_ == 0) Fold();
  }
private:
  __aicore__ inline void Compute()
  {
    auto b1 = b1Q_.AllocTensor<half>();
    FinalCopyNd2NzHw<K, N>(b1, bGm_);
    b1Q_.EnQue(b1);
    b1 = b1Q_.DeQue<half>();
    auto b2 = b2Q_.AllocTensor<half>();
    FinalSplitB<K, N>(b2, b1);
    b2Q_.EnQue(b2);
    b2 = b2Q_.DeQue<half>();
    int32_t i = 0;
    for (int32_t chunk = block_; chunk < CHUNKS; chunk += blocks_, ++i) {
      const int32_t slot = i & (DEPTH - 1);
      if (i >= DEPTH) {
        AscendC::CrossCoreWaitFlag<2, PIPE_MTE1>(ACK_BASE + slot);
      }
      auto a1 = a1Q_.AllocTensor<half>();
      FinalCopyNd2NzHw<CM, K>(a1, aGm_[static_cast<int64_t>(chunk) * CM * K]);
      a1Q_.EnQue(a1);
      a1 = a1Q_.DeQue<half>();
      auto a2 = a2Q_.AllocTensor<half>();
      FinalSplitA<CM, N, K>(a2, a1);
      a2Q_.EnQue(a2);
      a1Q_.FreeTensor(a1);
      a2 = a2Q_.DeQue<half>();
      auto c1 = c1Q_.AllocTensor<float>();
      AscendC::MmadParams mp;
      mp.m = CM; mp.n = N; mp.k = K;
      mp.cmatrixInitVal = true;
      AscendC::Mmad(c1, a2, b2, mp);
      AscendC::PipeBarrier<PIPE_M>();
      c1Q_.EnQue(c1);
      a2Q_.FreeTensor(a2);
      c1 = c1Q_.DeQue<float>();
      AscendC::FixpipeParamsV220 fp;
      fp.nSize = N;
      fp.mSize = CM;
      fp.srcStride = CM;
      fp.dstStride = N;
      fp.ndNum = 1; fp.srcNdStride = 0; fp.dstNdStride = 0;
      auto slab = slabs_[(static_cast<int64_t>(block_) * DEPTH + slot) * C_ELEMS];
      AscendC::Fixpipe(slab, c1, fp);
      c1Q_.FreeTensor(c1);
      AscendC::CrossCoreSetFlag<2, PIPE_FIX>(FLAG_BASE + slot);
    }
    b2Q_.FreeTensor(b2);
    b1Q_.FreeTensor(b1);
  }
  __aicore__ inline void Reduce()
  {
    auto ub = workBuf_.Get<uint8_t>();
    auto acc = ub[UB_ACC].ReinterpretCast<float>();
    AscendC::Duplicate(acc, 0.0F, CM);
    AscendC::PipeBarrier<PIPE_V>();
    auto cf = cBuf_.Get<float>();
    auto tmp = ub[UB_TMP].ReinterpretCast<float>();
    auto rowsF = ub[UB_ROWS_F].ReinterpretCast<float>();
    int32_t i = 0;
    int32_t chunk = block_;
    for (; chunk < CHUNKS; chunk += blocks_, ++i) {
      const int32_t slot = i & (DEPTH - 1);
      AscendC::CrossCoreWaitFlag<2, PIPE_MTE2>(FLAG_BASE + slot);
      const int64_t slab = static_cast<int64_t>(block_) * DEPTH * C_ELEMS +
        static_cast<int64_t>(slot) * C_ELEMS;
      if (i > 0) {
        const auto v2m2 = pipe_.FetchEventID(AscendC::HardEvent::V_MTE2);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(v2m2);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(v2m2);
      }
      AscendC::DataCopy(cf, slabs_[slab], C_ELEMS);
      const auto m2v = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
      AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(m2v);
      AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(m2v);
      AscendC::BlockReduceMax<float>(tmp, cf, CM, N, 1, 1,
                     N * sizeof(float) / 32);
      AscendC::PipeBarrier<PIPE_V>();
      AscendC::BlockReduceMax<float>(rowsF, tmp, CM / 8, 64, 1, 1, 8);
      AscendC::PipeBarrier<PIPE_V>();
      AscendC::Add(acc, acc, rowsF, CM);
      if (chunk + blocks_ < CHUNKS) {
        AscendC::CrossCoreSetFlag<2, PIPE_MTE3>(ACK_BASE + slot);
      }
    }
    AscendC::PipeBarrier<PIPE_V>();
    AscendC::Add(acc, acc, acc[CM / 2], CM / 2);
    AscendC::PipeBarrier<PIPE_V>();
    auto partial = ub[UB_PART].ReinterpretCast<float>();
    AscendC::WholeReduceSum<float>(partial, acc, CM / 2, 1, 1, 1,
                   (CM / 2) * sizeof(float) / 32);
  }
  __aicore__ inline void Publish()
  {
    auto ub = workBuf_.Get<uint8_t>();
    auto partial = ub[UB_PART].ReinterpretCast<float>();
    auto flag = ub[UB_FLAGS].ReinterpretCast<float>();
    AscendC::Duplicate(flag, SPLIT_READY, 8);
    AscendC::PipeBarrier<PIPE_V>();
    const auto v2m3 = pipe_.FetchEventID(AscendC::HardEvent::V_MTE3);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(v2m3);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(v2m3);
    AscendC::DataCopyExtParams one{1, sizeof(float), 0, 0, 0};
    AscendC::DataCopyPad(slots_[static_cast<int64_t>(block_) * SLOT_FLOATS],
              partial, one);
    AscendC::DataCopyPad(slots_[static_cast<int64_t>(block_) * SLOT_FLOATS + 8],
              flag, one);
#ifdef BMM_C13_DUMP_CHUNKS
    AscendC::DataCopyPad(slots_[static_cast<int64_t>(block_) * SLOT_FLOATS + 16],
              partial, one);
#endif
    const auto done = pipe_.FetchEventID(AscendC::HardEvent::MTE3_V);
    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(done);
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(done);
  }
  __aicore__ inline void Fold()
  {
    auto ub = workBuf_.Get<uint8_t>();
    auto flags = ub[UB_POLL].ReinterpretCast<float>();
    AscendC::DataCopyPadExtParams<float> pad{};
    const int32_t mine = block_;
    AscendC::DataCopyExtParams flagGather{static_cast<uint16_t>(blocks_), sizeof(float),
      (SLOT_FLOATS - 1) * sizeof(float), 0, 0};
    for (int32_t attempt = 0; attempt < SPLIT_POLL_LIMIT; ++attempt) {
      AscendC::DataCopyPad(flags, slots_[8], flagGather, pad);
      const auto loaded = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
      AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(loaded);
      AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(loaded);
      const auto scalar = pipe_.FetchEventID(AscendC::HardEvent::V_S);
      AscendC::SetFlag<AscendC::HardEvent::V_S>(scalar);
      AscendC::WaitFlag<AscendC::HardEvent::V_S>(scalar);
      bool all = true;
      for (int32_t p = 0; p < blocks_; ++p) {
        if (p == mine) continue;
        if (flags.GetValue(p * SPLIT_UB_SLOT_FLOATS) != SPLIT_READY) {
          all = false; break;
        }
      }
      if (all) break;
    }
    auto gathered = ub[UB_GATHER].ReinterpretCast<float>();
#if defined(BMM_C13_FOLD_E) && BMM_C13_FOLD_E
    {
      const uint32_t allBytes =
        static_cast<uint32_t>(static_cast<uint64_t>(blocks_) *
                   SLOT_FLOATS * sizeof(float));
      const AscendC::DataCopyExtParams allRows{1, allBytes, 0, 0, 0};
      AscendC::DataCopyPad(gathered, slots_[0], allRows, pad);
      const auto rowsLoaded = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
      AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(rowsLoaded);
      AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(rowsLoaded);
    }
    const auto toScalar = pipe_.FetchEventID(AscendC::HardEvent::V_S);
    AscendC::SetFlag<AscendC::HardEvent::V_S>(toScalar);
    AscendC::WaitFlag<AscendC::HardEvent::V_S>(toScalar);
    float total = 0.0F;
    for (int32_t p = 0; p < blocks_; ++p) {
      total += gathered.GetValue(p * SLOT_FLOATS);
    }
#else
    AscendC::DataCopyExtParams rows{static_cast<uint16_t>(blocks_), sizeof(float),
      (SLOT_FLOATS - 1) * sizeof(float), 0, 0};
    AscendC::DataCopyPad(gathered, slots_[0], rows, pad);
    const auto rowsLoaded = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(rowsLoaded);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(rowsLoaded);
    const auto toScalar = pipe_.FetchEventID(AscendC::HardEvent::V_S);
    AscendC::SetFlag<AscendC::HardEvent::V_S>(toScalar);
    AscendC::WaitFlag<AscendC::HardEvent::V_S>(toScalar);
    float total = ub[UB_PART].ReinterpretCast<float>().GetValue(0);
    for (int32_t p = 0; p < blocks_; ++p) {
      if (p == mine) continue;
      total += gathered.GetValue(p * SPLIT_UB_SLOT_FLOATS);
    }
#endif
    auto out = ub[UB_OUT].ReinterpretCast<float>();
    out.SetValue(0, total);
#ifdef BMM_C13_DUMP_CHUNKS
    AscendC::DataCopy(slots_[640], gathered, 256);
    AscendC::DataCopy(slots_[640 + 256], flags, 8);
    AscendC::DataCopy(slots_[640 + 264], out, 8);
#endif
    const auto s2m3 = pipe_.FetchEventID(AscendC::HardEvent::S_MTE3);
    AscendC::SetFlag<AscendC::HardEvent::S_MTE3>(s2m3);
    AscendC::WaitFlag<AscendC::HardEvent::S_MTE3>(s2m3);
    AscendC::DataCopyExtParams one{1, 3 * sizeof(float), 0, 0, 0};
    AscendC::DataCopyPad(y_[0], out, one);
  }
private:
  int32_t block_ = 0;
  int32_t blocks_ = 0;
  AscendC::TPipe pipe_;
  AscendC::TQue<AscendC::TPosition::A1, 1> a1Q_;
  AscendC::TQue<AscendC::TPosition::A2, 1> a2Q_;
  AscendC::TQue<AscendC::TPosition::B1, 1> b1Q_;
  AscendC::TQue<AscendC::TPosition::B2, 1> b2Q_;
  AscendC::TQue<AscendC::TPosition::CO1, 1> c1Q_;
  AscendC::TBuf<AscendC::TPosition::VECIN> cBuf_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> workBuf_;
  AscendC::GlobalTensor<half> aGm_, bGm_;
  AscendC::GlobalTensor<float> y_, slots_, slabs_;
};
template <typename T, bool TX1, bool TX2,
     int OM, int ON, int OK, int MS, int NS, int CM, int CN, int REDN>
class CubeWideNGrouped {
  using AType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, T, TX1>;
  using BType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, T, TX2>;
  using CType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float>;
  using BiasType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float>;
  static constexpr int TASKS = MS * NS;
  static constexpr int RN = REDN;
  static constexpr int SLOT_FLOATS = ((CM + 1 + 31) / 32) * 32;
  static constexpr int SLOT_BYTES = SLOT_FLOATS * sizeof(float);
  static constexpr int FLAG_OFF = CM;
public:
  __aicore__ inline AscendC::TPipe* Pipe() { return &pipe_; }
  __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR tiles,
                int32_t blocks, DeviceTiling& tiling)
  {
    blocks_ = blocks;
    block_ = static_cast<int32_t>(AscendC::GetBlockIdx());
    x1_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1), static_cast<int64_t>(OM) * OK);
    x2_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2), static_cast<int64_t>(ON) * OK);
    y_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y), 2048);
    auto* base = reinterpret_cast<__gm__ float*>(tiles);
    constexpr int64_t slabElems = static_cast<int64_t>(CM) * ON;
    cGm_.SetGlobalBuffer(base + static_cast<int64_t>(block_) * slabElems, slabElems);
    slots_.SetGlobalBuffer(base + static_cast<int64_t>(blocks_) * slabElems,
               TASKS * SLOT_FLOATS);
    pipe_.InitBuffer(cBuf_, CM * RN * sizeof(float));
    pipe_.InitBuffer(tileMaxBuf_, CM * sizeof(float));
    pipe_.InitBuffer(rowMaxBuf_, CM * sizeof(float));
    pipe_.InitBuffer(scratchBuf_, CM * RN * sizeof(float));
    pipe_.InitBuffer(flagBuf_, TASKS * SPLIT_UB_SLOT_FLOATS * sizeof(float));
    pipe_.InitBuffer(gatherBuf_, TASKS * CM * sizeof(float));
    pipe_.InitBuffer(foldBuf_, CM * sizeof(float));
    pipe_.InitBuffer(sumBuf_, MS * 8 * sizeof(float));
    pipe_.InitBuffer(reduceTmpBuf_, SHORT_REDUCE_TMP_BYTES);
    pipe_.InitBuffer(outBuf_, 32);
  }
  __aicore__ inline void Process()
  {
    if (block_ < blocks_) {
      for (int32_t task = block_; task < TASKS; task += blocks_) ComputeTask(task);
    }
    // Release-acquire across blocks: a block's MTE3 slot DMA completing locally
    // does not make it globally visible; without this barrier block 0's fold
    // can observe a landed flag DMA while the rowMax DMA is still in flight
    // (reproduced ~45% of launches on c12, 0/50 iters with the barrier).
    if ASCEND_IS_AIV {
      if (AscendC::GetSubBlockIdx() == 0) AscendC::SyncAll();
    }
    if (block_ == 0) Fold();
  }
private:
  __aicore__ inline void ComputeTask(int32_t task)
  {
    const int32_t mi = task / NS;
    const int32_t ni = task % NS;
    const int32_t mStart = mi * CM;
    const int32_t nStart = ni * CN;
    const int32_t validM = OM - mStart < CM ? OM - mStart : CM;
    const int32_t validN = ON - nStart < CN ? ON - nStart : CN;
    if (validM <= 0 || validN <= 0) return;
    const int64_t aOff = TX1 ? mStart : static_cast<int64_t>(mStart) * OK;
    const int64_t bOff = TX2 ? static_cast<int64_t>(nStart) * OK : nStart;
    mm_.SetTensorA(x1_[aOff], TX1);
    mm_.SetTensorB(x2_[bOff], TX2);
    mm_.SetTail(validM, validN, OK);
    mm_.template IterateAll<true>(cGm_);
    mm_.End();
    auto rowMax = rowMaxBuf_.Get<float>();
    AscendC::Duplicate(rowMax, -3.402823466e+38F, CM);
    AscendC::PipeBarrier<PIPE_V>();
    for (int32_t n0 = 0; n0 < validN; n0 += RN) {
      const int32_t nv = validN - n0 < RN ? validN - n0 : RN;
      const uint32_t paddedN = (nv + 7) / 8 * 8;
      auto c = cBuf_.Get<float>();
      if (paddedN < RN) {
        AscendC::Duplicate(c, NEG_INF, CM * RN);
        AscendC::PipeBarrier<PIPE_V>();
      }
      const auto v2m2 = pipe_.FetchEventID(AscendC::HardEvent::V_MTE2);
      AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(v2m2);
      AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(v2m2);
      AscendC::DataCopyExtParams cp{static_cast<uint16_t>(validM),
        static_cast<uint32_t>(nv * sizeof(float)),
        static_cast<uint32_t>((ON - nv) * sizeof(float)),
        static_cast<uint32_t>((RN - paddedN) / 8), 0};
      AscendC::DataCopyPadExtParams<float> pad{true, 0,
        static_cast<uint8_t>(paddedN - nv), NEG_INF};
      AscendC::DataCopyPad(c, cGm_[n0], cp, pad);
      const auto m2v = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
      AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(m2v);
      AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(m2v);
      auto tm = tileMaxBuf_.Get<float>();
      uint32_t shape[2] = {static_cast<uint32_t>(validM), RN};
      AscendC::ReduceMax<float, AscendC::Pattern::Reduce::AR, true>(
        tm, c, scratchBuf_.Get<uint8_t>(), shape, true);
      AscendC::PipeBarrier<PIPE_V>();
      AscendC::Max(rowMax, rowMax, tm, validM);
      AscendC::PipeBarrier<PIPE_V>();
    }
    Publish(task);
  }
  __aicore__ inline void Publish(int32_t task)
  {
    const int64_t slot = static_cast<int64_t>(task) * SLOT_FLOATS;
    auto flag = flagBuf_.Get<float>();
    AscendC::Duplicate(flag, SPLIT_READY, 8);
    const auto v2m3 = pipe_.FetchEventID(AscendC::HardEvent::V_MTE3);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(v2m3);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(v2m3);
    AscendC::DataCopyExtParams rows{1, CM * sizeof(float), 0, 0, 0};
    AscendC::DataCopyExtParams one{1, sizeof(float), 0, 0, 0};
    AscendC::DataCopyPad(slots_[slot], rowMaxBuf_.Get<float>(), rows);
    AscendC::DataCopyPad(slots_[slot + FLAG_OFF], flag, one);
    const auto done = pipe_.FetchEventID(AscendC::HardEvent::MTE3_V);
    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(done);
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(done);
  }
  __aicore__ inline void Fold()
  {
    int32_t usedAttempts = -1;
    auto flags = flagBuf_.Get<float>();
    AscendC::DataCopyPadExtParams<float> pad{};
    AscendC::DataCopyExtParams fg{TASKS, sizeof(float), SLOT_BYTES - sizeof(float), 0, 0};
    for (int32_t attempt = 0; attempt < SPLIT_POLL_LIMIT; ++attempt) {
      AscendC::DataCopyPad(flags, slots_[FLAG_OFF], fg, pad);
      const auto m2v = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
      AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(m2v);
      AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(m2v);
      const auto v2s = pipe_.FetchEventID(AscendC::HardEvent::V_S);
      AscendC::SetFlag<AscendC::HardEvent::V_S>(v2s);
      AscendC::WaitFlag<AscendC::HardEvent::V_S>(v2s);
      bool ready = true;
      for (int i = 0; i < TASKS; ++i) {
        if (flags.GetValue(i) != SPLIT_READY) {
          ready = false; break;
        }
      }
      usedAttempts = attempt;
      if (ready) break;
    }
    auto gathered = gatherBuf_.Get<float>();
    AscendC::DataCopyExtParams rg{TASKS, CM * sizeof(float),
      SLOT_BYTES - CM * sizeof(float), 0, 0};
    AscendC::DataCopyPad(gathered, slots_[0], rg, pad);
    const auto m2v = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(m2v);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(m2v);

    auto fold = foldBuf_.Get<float>();
    auto sums = sumBuf_.Get<float>();
    auto tmp = reduceTmpBuf_.Get<float>();
    for (int mi = 0; mi < MS; ++mi) {
      const int first = (mi * NS) * CM;
      AscendC::Adds(fold, gathered[first], 0.0F, CM);
      AscendC::PipeBarrier<PIPE_V>();
      for (int ni = 1; ni < NS; ++ni) {
        const int off = (mi * NS + ni) * CM;
        AscendC::Max(fold, fold, gathered[off], CM);
        AscendC::PipeBarrier<PIPE_V>();
      }
      const int mStart = mi * CM;
      const int valid = OM - mStart < CM ? OM - mStart : CM;
      AscendC::ReduceSum<float>(sums[mi * 8], fold, tmp, valid);
      AscendC::PipeBarrier<PIPE_V>();
    }
    const auto v2s = pipe_.FetchEventID(AscendC::HardEvent::V_S);
    AscendC::SetFlag<AscendC::HardEvent::V_S>(v2s);
    AscendC::WaitFlag<AscendC::HardEvent::V_S>(v2s);
    float total = 0.0F;
    for (int mi = 0; mi < MS; ++mi) total += sums[mi * 8].GetValue(0);
    const auto s2v = pipe_.FetchEventID(AscendC::HardEvent::S_V);
    AscendC::SetFlag<AscendC::HardEvent::S_V>(s2v);
    AscendC::WaitFlag<AscendC::HardEvent::S_V>(s2v);
    auto out = outBuf_.Get<float>();
    AscendC::Duplicate(out, total, 8);
    out.SetValue(1, sums[0 * 8].GetValue(0));
    out.SetValue(2, sums[1 * 8].GetValue(0));
    const auto v2m3 = pipe_.FetchEventID(AscendC::HardEvent::V_MTE3);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(v2m3);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(v2m3);
    AscendC::DataCopyExtParams one{1, 3 * sizeof(float), 0, 0, 0};
    AscendC::DataCopyPad(y_[0], out, one);
  }
  int32_t blocks_ = 1, block_ = 0;
  AscendC::TPipe pipe_;
  AscendC::TBuf<AscendC::TPosition::VECIN> cBuf_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> tileMaxBuf_, rowMaxBuf_, scratchBuf_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> flagBuf_, gatherBuf_, foldBuf_, sumBuf_, reduceTmpBuf_;
  AscendC::TBuf<AscendC::TPosition::VECOUT> outBuf_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> nonceOut_;
public:
  AscendC::Matmul<AType, BType, CType, BiasType> mm_;
private:
  AscendC::GlobalTensor<T> x1_, x2_;
  AscendC::GlobalTensor<float> y_, cGm_, slots_;
};
}
extern "C" __global__ __mix__(1, 1) void batch_matmul_case5_fast_fp16(
  GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR scratch)
{
  AscendC::TPipe pipe;
  batch_matmul_max_sum_v3::DirectMmadCase5Fast op;
  op.Init(x1, x2, y, scratch, &pipe);
  op.Process();
}
extern "C" __global__ __mix__(1, 1) void batch_matmul_case5_mixt_fp16(
  GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR scratch)
{
  batch_matmul_max_sum_v3::DirectMmadCase5MixT op;
  op.Init(x1, x2, y, scratch);
  op.Process();
}
extern "C" __global__ __mix__(1, 1) void batch_matmul_case5_lag_fp16(
  GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR scratch, GM_ADDR modeAddr)
{
  AscendC::TPipe pipe;
  batch_matmul_max_sum_v3::DirectMmadCase5Lag op;
  op.Init(x1, x2, y, scratch, &pipe, static_cast<int32_t>(
    reinterpret_cast<uintptr_t>(modeAddr)));
  op.Process();
}
extern "C" __global__ __mix__(1, 1) void batch_matmul_case6_direct_bf16(
  GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR scratch, int32_t mode)
{
  batch_matmul_max_sum_v3::DirectMmadCase6 op;
  op.Init(x1, x2, y, scratch, mode);
  op.Process();
}
extern "C" __global__ __mix__(1, 1) void batch_matmul_case6_guard_bf16(
  GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR scratch, int32_t mode)
{
  if (AscendC::GetBlockIdx() >=
    batch_matmul_max_sum_v3::DirectMmadCase6::B)
    return;
  if (mode == 100) return;
  batch_matmul_max_sum_v3::DirectMmadCase6 op;
  op.Init(x1, x2, y, scratch, mode);
  if (mode == 101) return;
  op.Process();
}
extern "C" __global__ __mix__(1, 1) void batch_matmul_case7_direct_v2_fp16(
  GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR scratch)
{
  batch_matmul_max_sum_v3::DirectMmadCase7<0> op;
  op.Init(x1, x2, y, scratch);
  op.Process();
}
extern "C" __global__ __mix__(1, 1) void batch_matmul_case7_k2_fp16(
  GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR scratch, GM_ADDR modeAddr)
{
  batch_matmul_max_sum_v3::DirectMmadCase7K<2> op;
  op.Init(x1, x2, y, scratch, static_cast<int32_t>(
    reinterpret_cast<uintptr_t>(modeAddr)));
  op.Process();
}
#ifndef BMM_C7_LEAN
#endif
extern "C" __global__ __mix__(1, 1) void batch_matmul_case13_mix_fp16(
  GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR scratch, int32_t blocks)
{
  if ASCEND_IS_AIV {
    if (AscendC::GetSubBlockIdx() == 0) {
      const int32_t pwB = static_cast<int32_t>(AscendC::GetBlockIdx());
      AscendC::TPipe pfPipe;
      AscendC::TBuf<AscendC::TPosition::VECIN> pfBuf;
      pfPipe.InitBuffer(pfBuf, 32 * 1024);
      auto pf = pfBuf.Get<half>();
      const int64_t chunk = 16384;
      const int64_t x1C = static_cast<int64_t>(8192) * 128 / chunk;
      const int64_t x2C = static_cast<int64_t>(64) * 128 / chunk;
      AscendC::GlobalTensor<half> g1, g2;
      g1.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(x1),
               static_cast<int64_t>(8192) * 128);
      g2.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(x2),
               static_cast<int64_t>(64) * 128);
      AscendC::DataCopyParams ip{8, 128, 0, 0};
      AscendC::DataCopyEnhancedParams ep;
      ep.blockMode = AscendC::BlockMode::BLOCK_MODE_VECTOR;
      for (int64_t c = pwB; c < x1C; c += blocks)
        AscendC::DataCopy(pf, g1[c * chunk], ip, ep);
      for (int64_t c = pwB; c < x2C; c += blocks)
        AscendC::DataCopy(pf, g2[c * chunk], ip, ep);
      const auto pfEv = pfPipe.FetchEventID(AscendC::HardEvent::MTE2_MTE3);
      AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE3>(pfEv);
      AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE3>(pfEv);
    }
  }
  batch_matmul_max_sum_v3::DirectMmadCase13Mix op;
  op.Init(x1, x2, y, scratch, blocks);
  op.Process();
}
#define DECLARE_WIDE_N_KERNEL(NAME, TYPE, TX1, TX2, OM, ON, OK, MS, NS, CM, CN, REDN) \
extern "C" __global__ __mix__(1, 1) void NAME( \
  GM_ADDR x1, GM_ADDR x2, GM_ADDR y, __kfc_workspace__ GM_ADDR workspace, GM_ADDR tiles, \
  int32_t blocks, batch_matmul_max_sum_v3::DeviceTiling tiling) \
{ \
  batch_matmul_max_sum_v3::CubeWideNGrouped<TYPE, TX1, TX2, OM, ON, OK, MS, NS, CM, CN, REDN> op; \
  op.Init(x1, x2, y, tiles, blocks, tiling); \
  REGIST_MATMUL_OBJ(op.Pipe(), GetSysWorkSpacePtr(), op.mm_, &tiling); \
  op.Process(); \
}
DECLARE_WIDE_N_KERNEL(batch_matmul_case9_widen_fp16, half, false, true,
           2048, 1536, 1280, 16, 2, 128, 768, 128)
DECLARE_WIDE_N_KERNEL(batch_matmul_case11_widen_fp16, half, true, true,
           1536, 2048, 2048, 12, 3, 128, 768, 128)
DECLARE_WIDE_N_KERNEL(batch_matmul_case12_widen_bf16, bfloat16_t, true, false,
           1280, 4096, 1536, 10, 2, 128, 2048, 128)
DECLARE_WIDE_N_KERNEL(batch_matmul_case10_widen_bf16, bfloat16_t, false, false,
           4096, 1280, 1152, BMM_CASE10_MS, BMM_CASE10_NS,
           BMM_CASE10_CM, BMM_CASE10_CN, 64)
#undef DECLARE_WIDE_N_KERNEL
#undef DECLARE_WIDE_DIRECT_KERNEL
#define DECLARE_WIDE_ASYNC_KERNEL(NAME, TYPE, TX1, TX2, OM, ON, OK, MS, NS, CM, CN) \
extern "C" __global__ __mix__(1, 1) void NAME( \
  GM_ADDR x1, GM_ADDR x2, GM_ADDR y, __kfc_workspace__ GM_ADDR workspace, \
  GM_ADDR asyncCache, GM_ADDR tiles, int32_t blocks, \
  batch_matmul_max_sum_v3::DeviceTiling tiling, float nonce) \
{ \
  if ASCEND_IS_AIV { \
    if (AscendC::GetSubBlockIdx() == 0) { \
      AscendC::TPipe pfPipe; \
      AscendC::TBuf<AscendC::TPosition::VECIN> pfBuf; \
      pfPipe.InitBuffer(pfBuf, 32 * 1024); \
      auto pf = pfBuf.Get<TYPE>(); \
      const int64_t chunk = 16384; \
      const int32_t bid = static_cast<int32_t>(AscendC::GetBlockIdx()); \
      AscendC::DataCopyParams ip{8, 128, 0, 0}; \
      AscendC::DataCopyEnhancedParams ep; \
      ep.blockMode = AscendC::BlockMode::BLOCK_MODE_VECTOR; \
      AscendC::GlobalTensor<TYPE> g1; \
      g1.SetGlobalBuffer(reinterpret_cast<__gm__ TYPE*>(x1), static_cast<int64_t>(OM) * OK); \
      AscendC::GlobalTensor<TYPE> g2; \
      g2.SetGlobalBuffer(reinterpret_cast<__gm__ TYPE*>(x2), static_cast<int64_t>(ON) * OK); \
      const int64_t x1C = static_cast<int64_t>(OM) * OK / chunk; \
      const int64_t x2C = static_cast<int64_t>(ON) * OK / chunk; \
      for (int64_t c = bid; c < x1C; c += blocks) \
        AscendC::DataCopy(pf, g1[c * chunk], ip, ep); \
      for (int64_t c = bid; c < x2C; c += blocks) \
        AscendC::DataCopy(pf, g2[c * chunk], ip, ep); \
      const auto pfEv = pfPipe.FetchEventID(AscendC::HardEvent::MTE2_MTE3); \
      AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE3>(pfEv); \
      AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE3>(pfEv); \
    } \
  } \
  batch_matmul_max_sum_v3::CubeWideNDirect< \
    TYPE, TX1, TX2, OM, ON, OK, MS, NS, CM, CN, true> op; \
  op.Init(x1, x2, y, asyncCache, tiles, blocks, tiling, nonce); \
  REGIST_MATMUL_OBJ(op.Pipe(), GetSysWorkSpacePtr(), op.mm_, &tiling); \
  op.Process(); \
}
#define DECLARE_WIDE_ASYNC_KERNEL_H(NAME, TYPE, TX1, TX2, OM, ON, OK, MS, NS, CM, CN) \
extern "C" __global__ __mix__(1, 1) void NAME( \
  GM_ADDR x1, GM_ADDR x2, GM_ADDR y, __kfc_workspace__ GM_ADDR workspace, \
  GM_ADDR asyncCache, GM_ADDR tiles, int32_t blocks, \
  batch_matmul_max_sum_v3::DeviceTiling tiling, float nonce) \
{ \
  if ASCEND_IS_AIV { \
    if (AscendC::GetSubBlockIdx() == 0) { \
      AscendC::TPipe pfPipe; \
      AscendC::TBuf<AscendC::TPosition::VECIN> pfBuf; \
      pfPipe.InitBuffer(pfBuf, 32 * 1024); \
      auto pf = pfBuf.Get<TYPE>(); \
      const int64_t chunk = 16384; \
      const int32_t bid = static_cast<int32_t>(AscendC::GetBlockIdx()); \
      AscendC::DataCopyParams ip{8, 128, 0, 0}; \
      AscendC::DataCopyEnhancedParams ep; \
      ep.blockMode = AscendC::BlockMode::BLOCK_MODE_VECTOR; \
      AscendC::GlobalTensor<TYPE> g1; \
      g1.SetGlobalBuffer(reinterpret_cast<__gm__ TYPE*>(x1), static_cast<int64_t>(OM) * OK); \
      AscendC::GlobalTensor<TYPE> g2; \
      g2.SetGlobalBuffer(reinterpret_cast<__gm__ TYPE*>(x2), static_cast<int64_t>(ON) * OK); \
      const int64_t x1C = static_cast<int64_t>(OM) * OK / chunk; \
      const int64_t x2C = static_cast<int64_t>(ON) * OK / chunk; \
      for (int64_t c = bid; c < x1C; c += blocks) \
        AscendC::DataCopy(pf, g1[c * chunk], ip, ep); \
      for (int64_t c = bid; c < x2C; c += blocks) \
        AscendC::DataCopy(pf, g2[c * chunk], ip, ep); \
      const auto pfEv = pfPipe.FetchEventID(AscendC::HardEvent::MTE2_MTE3); \
      AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE3>(pfEv); \
      AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE3>(pfEv); \
    } \
  } \
  batch_matmul_max_sum_v3::CubeWideNDirect< \
    TYPE, TX1, TX2, OM, ON, OK, MS, NS, CM, CN, true, half> op; \
  op.Init(x1, x2, y, asyncCache, tiles, blocks, tiling, nonce); \
  REGIST_MATMUL_OBJ(op.Pipe(), GetSysWorkSpacePtr(), op.mm_, &tiling); \
  op.Process(); \
}
