inline uint64_t LibApiWorkspaceBytes()
{
  static const uint64_t bytes = [] {
    auto* platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    return platform == nullptr ? 0 : platform->GetLibApiWorkSpaceSize();
  }();
  return bytes;
}
inline uint8_t* MatmulWorkspace(aclrtStream stream, uint64_t tileBytes)
{
  struct Entry { int32_t device; aclrtContext context; aclrtStream stream; uint64_t bytes; uint8_t* ptr; };
  static thread_local std::vector<Entry> entries;
  int32_t device = -1;
  if (aclrtGetDevice(&device) != ACL_SUCCESS)
    throw std::runtime_error("BMM: cannot query current device for workspace");
  aclrtContext context = nullptr;
  if (aclrtGetCurrentContext(&context) != ACL_SUCCESS)
    throw std::runtime_error("BMM: cannot query workspace context");
  auto* platform = platform_ascendc::PlatformAscendCManager::GetInstance();
  if (platform == nullptr) throw std::runtime_error("BMM: runtime platform unavailable");
  static const uint64_t systemBytes = platform->GetLibApiWorkSpaceSize();
  if (systemBytes == 0) throw std::runtime_error("BMM: platform reported zero Matmul workspace size");
  const uint64_t bytes = Align512(systemBytes) + tileBytes;
  for (const auto& entry : entries) {
    if (entry.device == device && entry.context == context &&
      entry.stream == stream && entry.bytes >= bytes)
      return entry.ptr;
  }
  uint8_t* ptr = nullptr;
  const aclError rc = aclrtMalloc(reinterpret_cast<void**>(&ptr), bytes, ACL_MEM_MALLOC_HUGE_FIRST);
  if (rc != ACL_SUCCESS)
    throw std::runtime_error("BMM: Matmul workspace allocation failed");
  entries.push_back({device, context, stream, bytes, ptr});
  return ptr;
}
inline uint8_t* g_nzZnBase = nullptr;
inline uint8_t* g_nzProbeBase = nullptr;
inline uint64_t g_nzProbeBytes = 0;
inline uint8_t* g_c8DmSlots = nullptr;
inline uint8_t* g_c8DmCache = nullptr;
inline uint8_t* g_c8DmZn = nullptr;
inline uint8_t* g_c8DmZa = nullptr;
inline void SetNZProbe(uint8_t* p, uint64_t bytes)
{
  g_nzProbeBase = p;
  g_nzProbeBytes = bytes;
}
inline float NextLaunchNonce()
{
  static std::atomic<uint32_t> seq{0};
  uint32_t s = seq.load(std::memory_order_relaxed);
  if (s == 0) {
    const uint64_t t = static_cast<uint64_t>(
      std::chrono::steady_clock::now().time_since_epoch().count());
    const uint32_t seed = 1u + static_cast<uint32_t>(t & 0x007FFFFEu);
    seq.compare_exchange_strong(s, seed, std::memory_order_relaxed);
  }
  const uint32_t v = seq.fetch_add(1, std::memory_order_relaxed);
  return static_cast<float>((v & 0x007FFFFFu) + 1u);
}
inline uint8_t* VectorScratchWorkspace(aclrtStream stream, uint64_t payloadBytes)
{
  struct Entry { int32_t device; aclrtContext context; aclrtStream stream; uint64_t bytes; uint8_t* ptr; };
  static thread_local std::vector<Entry> entries;
  int32_t device = -1;
  if (aclrtGetDevice(&device) != ACL_SUCCESS)
    throw std::runtime_error("BMM: cannot query current device for vector scratch");
  aclrtContext context = nullptr;
  if (aclrtGetCurrentContext(&context) != ACL_SUCCESS)
    throw std::runtime_error("BMM: cannot query vector scratch context");
  const uint64_t bytes = Align512(payloadBytes);
  for (const auto& entry : entries) {
    if (entry.device == device && entry.context == context &&
      entry.stream == stream && entry.bytes >= bytes)
      return entry.ptr;
  }
  uint8_t* ptr = nullptr;
  const aclError rc = aclrtMalloc(reinterpret_cast<void**>(&ptr), bytes, ACL_MEM_MALLOC_HUGE_FIRST);
  if (rc != ACL_SUCCESS)
    throw std::runtime_error("BMM: vector scratch allocation failed");
  entries.push_back({device, context, stream, bytes, ptr});
  return ptr;
}
constexpr int32_t CASE2_V13_TAB = 1280;
inline GM_ADDR Case2BakedTabsV13(aclrtStream stream)
{
  static const std::vector<char>& tbl = [] {
    auto* v = new std::vector<char>();
    v->resize(CASE2_V13_TAB * 4);
    auto* u = reinterpret_cast<uint32_t*>(v->data());
    for (int m = 0; m < 3; ++m)
      for (int r = 0; r < 8; ++r)
        for (int k = 0; k < 40; ++k)
          u[(m * 8 + r) * 40 + k] = static_cast<uint32_t>(4 * (3 * k + m));
    for (int r = 0; r < 8; ++r)
      for (int k = 0; k < 40; ++k)
        u[960 + r * 40 + k] =
          static_cast<uint32_t>(4 * (128 + 5 * k + (r < 5 ? r : 4)));
    return *v;
  }();
  auto* scratch = VectorScratchWorkspace(stream, CASE2_V13_TAB * 4);
  aclrtMemcpy(scratch, tbl.size(), tbl.data(), tbl.size(),
        ACL_MEMCPY_HOST_TO_DEVICE);
  GM_ADDR out = nullptr;
  std::memcpy(&out, &scratch, sizeof(out));
  return out;
}
constexpr int32_t CASE2_V14_TAB = 320;
inline GM_ADDR Case2BakedTabsV14(aclrtStream stream)
{
  (void)stream;
  struct Entry { int32_t device; aclrtContext context; uint8_t* ptr; };
  static thread_local std::vector<Entry> cache;
  int32_t device = -1;
  if (aclrtGetDevice(&device) != ACL_SUCCESS)
    throw std::runtime_error("BMM: cannot query device for case2 table");
  aclrtContext context = nullptr;
  if (aclrtGetCurrentContext(&context) != ACL_SUCCESS)
    throw std::runtime_error("BMM: cannot query case2 table context");
  for (const auto& e : cache)
    if (e.device == device && e.context == context) {
      GM_ADDR hit = nullptr;
      std::memcpy(&hit, &e.ptr, sizeof(hit));
      return hit;
    }
  static const std::vector<char>& tbl = [] {
    auto* v = new std::vector<char>();
    v->resize(CASE2_V14_TAB * 4);
    auto* u = reinterpret_cast<uint32_t*>(v->data());
    for (int m = 0; m < 3; ++m)
      for (int k = 0; k < 40; ++k)
        u[m * 40 + k] = static_cast<uint32_t>(4 * (3 * k + m));
    for (int n = 0; n < 5; ++n)
      for (int k = 0; k < 40; ++k)
        u[120 + n * 40 + k] = static_cast<uint32_t>(4 * (128 + 5 * k + n));
    return *v;
  }();
  uint8_t* ptr = nullptr;
  if (aclrtMalloc(reinterpret_cast<void**>(&ptr), 2048,
          ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS)
    throw std::runtime_error("BMM: case2 table allocation failed");
  aclrtMemcpy(ptr, tbl.size(), tbl.data(), tbl.size(), ACL_MEMCPY_HOST_TO_DEVICE);
  cache.push_back({device, context, ptr});
  GM_ADDR out = nullptr;
  std::memcpy(&out, &ptr, sizeof(out));
  return out;
}
inline GM_ADDR Case2BakedTabs(aclrtStream stream)
{
  static const std::vector<char>& tbl = [] {
    auto* v = new std::vector<char>();
    v->resize(88 * 4);
    auto* u = reinterpret_cast<uint32_t*>(v->data());
    for (int k = 0; k < 40; ++k) {
      u[k] = static_cast<uint32_t>(4 * (3 * k));
      u[48 + k] = static_cast<uint32_t>(4 * (5 * k));
    }
    return *v;
  }();
  auto* scratch = VectorScratchWorkspace(stream, 1024);
  aclrtMemcpy(scratch, tbl.size(), tbl.data(), tbl.size(),
        ACL_MEMCPY_HOST_TO_DEVICE);
  GM_ADDR out = nullptr;
  std::memcpy(&out, &scratch, sizeof(out));
  return out;
}
inline bool GeometryFits(optiling::TCubeTiling& t, const MemoryLimits& mem,
            int32_t m, int32_t n, int32_t k)
{
  const int64_t bm = t.get_baseM(), bn = t.get_baseN(), bk = t.get_baseK();
  if (bm <= 0 || bn <= 0 || bk <= 0 || bm % 16 || bn % 16 || bk % 16) return false;
  if (t.get_singleCoreM() < (m < 64 ? m : 64) || t.get_singleCoreN() < n ||
    t.get_singleCoreK() < k || t.get_usedCoreNum() != 1) return false;
  if (t.get_iterateOrder() != 0 && t.get_iterateOrder() != 1) return false;
  if (t.get_dbL0A() < 1 || t.get_dbL0B() < 1 || t.get_dbL0C() < 1) return false;
  const uint64_t tile = static_cast<uint64_t>(bm) * bn * sizeof(float);
  const uint64_t reduceTile = static_cast<uint64_t>(bm) *
    (bn < REDUCE_N ? bn : REDUCE_N) * sizeof(float);
  const uint64_t rows = static_cast<uint64_t>((m + bm - 1) / bm * bm) * sizeof(float);
  const uint64_t scratch = reduceTile > rows ? reduceTile : rows;
  const uint64_t local = Align32(reduceTile) + Align32(bm * sizeof(float)) +
             Align32(rows) + Align32(scratch) + 32 + ACCURATE_SUM_BYTES;
  const uint64_t internal = t.get_transLength() > 0
    ? static_cast<uint64_t>(t.get_transLength()) : 0;
  const uint64_t reserve = internal > UB_RESERVE ? internal : UB_RESERVE;
  return Fits(bm * bk * 2ULL * t.get_dbL0A(), mem.l0a) &&
     Fits(bn * bk * 2ULL * t.get_dbL0B(), mem.l0b) &&
     Fits(tile * t.get_dbL0C(), mem.l0c) &&
     Fits(bm * bk * 2ULL * t.get_depthA1() +
        bn * bk * 2ULL * t.get_depthB1(), mem.l1) &&
     Fits(local + reserve, mem.ub);
}
inline DeviceTiling BuildCubeTilingUncached(int32_t m, int32_t n, int32_t k,
                      int32_t dtype, bool tx1, bool tx2)
{
  auto* platform = platform_ascendc::PlatformAscendCManager::GetInstance();
  if (platform == nullptr) throw std::runtime_error("BMM: runtime platform unavailable");
  const MemoryLimits mem = ReadLimits(*platform);
  const auto inputType = dtype == 1 ? matmul_tiling::DataType::DT_FLOAT16
                  : matmul_tiling::DataType::DT_BF16;
  const bool v15Case8Family =
    (m == 1025 && n == 1031 && k == 1032 && tx1 && tx2);
  const uint64_t slabBudget = v15Case8Family ? (1ULL << 20) : (512ULL << 10);
  const uint64_t slabRowBytes = static_cast<uint64_t>(n) * sizeof(float);
  int64_t slabRows = v15Case8Family ? 128 :
    static_cast<int64_t>(slabBudget / (slabRowBytes == 0 ? 1 : slabRowBytes));
  if (slabRows > m) slabRows = m;
  slabRows = slabRows / 64 * 64;
  if (slabRows < 64) slabRows = m < 64 ? m : 64;
  const int32_t sliceM = static_cast<int32_t>(slabRows);
  const uint64_t slabBound = static_cast<uint64_t>(sliceM) * n * sizeof(float);
  const int32_t candidates[][2] = {{128, 128}, {64, 256}, {64, 128}, {32, 128},
                  {32, 64}, {16, 64}, {16, 16}, {-1, -1}};
  bool generated = false;
  bool geometryAccepted = false;
  const int32_t candCount = 8;
  for (int candIdx = 0; candIdx < candCount; ++candIdx) {
    const int32_t* candidate = candidates[candIdx];
    matmul_tiling::MultiCoreMatmulTiling api(*platform);
    api.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, inputType, tx1);
    api.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, inputType, tx2);
    api.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
          matmul_tiling::DataType::DT_FLOAT);
    api.SetBiasType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
            matmul_tiling::DataType::DT_FLOAT);
    api.SetBias(false);
    api.SetDim(1);
    api.SetOrgShape(m, n, k);
    api.SetShape(sliceM, n, k);
    api.SetSingleShape(sliceM, n, k);
    if (candidate[0] > 0) {
      const int32_t am = (sliceM + 15) / 16 * 16, an = (n + 15) / 16 * 16;
      api.SetFixSplit(candidate[0] < am ? candidate[0] : am,
              candidate[1] < an ? candidate[1] : an, -1);
    }
    api.SetBufferSpace(BufferLimit(mem.l1), BufferLimit(mem.l0c), BufferLimit(mem.ub));
    optiling::TCubeTiling host;
    if (api.GetTiling(host) < 0) continue;
    generated = true;
    if (!GeometryFits(host, mem, m, n, k) || host.get_singleCoreN() != n ||
      static_cast<uint64_t>(host.get_singleCoreM()) * n * sizeof(float) > slabBound)
      continue;
    geometryAccepted = true;
    DeviceTiling device{};
    if (host.GetDataSize() != sizeof(device)) continue;
    host.SaveToBuffer(&device, sizeof(device));
    if (device.baseM != host.get_baseM() || device.baseN != host.get_baseN() ||
      device.baseK != host.get_baseK()) {
      throw std::runtime_error("BMM: serialized tiling field mismatch");
    }
    return device;
  }
  const std::string stage = !generated ? "GetTiling rejected all candidates" :
    (!geometryAccepted ? "tiling exceeds geometry/resource contract" : "host/device tiling size mismatch");
  throw std::runtime_error("BMM: " + stage);
}
inline DeviceTiling BuildCubeTiling(int32_t m, int32_t n, int32_t k,
                  int32_t dtype, bool tx1, bool tx2)
{
  struct Entry {
    int32_t device, m, n, k, dtype;
    bool tx1, tx2;
    DeviceTiling tiling;
  };
  static thread_local std::vector<Entry> cache;
  int32_t device = -1;
  if (aclrtGetDevice(&device) != ACL_SUCCESS)
    throw std::runtime_error("BMM: cannot query current device for tiling");
  for (const auto& entry : cache) {
    if (entry.device == device && entry.m == m && entry.n == n && entry.k == k &&
      entry.dtype == dtype && entry.tx1 == tx1 && entry.tx2 == tx2)
      return entry.tiling;
  }
  const DeviceTiling tiling = BuildCubeTilingUncached(m, n, k, dtype, tx1, tx2);
  cache.push_back({device, m, n, k, dtype, tx1, tx2, tiling});
  return tiling;
}
constexpr int32_t CASE15_SPLIT_K = BMM_CASE15_SPLIT_K;
inline DeviceTiling BuildCase15SplitKTilingUncached(int32_t dtype)
{
  auto* platform = platform_ascendc::PlatformAscendCManager::GetInstance();
  if (platform == nullptr) throw std::runtime_error("BMM: runtime platform unavailable");
  const MemoryLimits mem = ReadLimits(*platform);
  const auto inputType = dtype == 1 ? matmul_tiling::DataType::DT_FLOAT16
                   : matmul_tiling::DataType::DT_BF16;
  matmul_tiling::MultiCoreMatmulTiling api(*platform);
  api.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, inputType, true);
  api.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, inputType, true);
  api.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
        matmul_tiling::DataType::DT_FLOAT);
  api.SetBiasType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
          matmul_tiling::DataType::DT_FLOAT);
  api.SetBias(false);
  api.SetDim(1);
  api.SetOrgShape(64, 64, 8192);
  api.SetShape(64, 64, CASE15_SPLIT_K);
  api.SetSingleShape(64, 64, CASE15_SPLIT_K);
  api.SetFixSplit(64, 64, -1);
  api.SetBufferSpace(BufferLimit(mem.l1), BufferLimit(mem.l0c), BufferLimit(mem.ub));
  optiling::TCubeTiling host;
  if (api.GetTiling(host) < 0)
    throw std::runtime_error("BMM: case15 split-K tiling failed");
  if (!GeometryFits(host, mem, 64, 64, CASE15_SPLIT_K) ||
    host.get_singleCoreM() < 64 || host.get_singleCoreN() < 64)
    throw std::runtime_error("BMM: case15 split-K tiling exceeds geometry");
  DeviceTiling device{};
  if (host.GetDataSize() != sizeof(device))
    throw std::runtime_error("BMM: case15 tiling ABI mismatch");
  host.SaveToBuffer(&device, sizeof(device));
  return device;
}
inline DeviceTiling BuildCase15SplitKTiling(int32_t dtype)
{
  struct Entry { int32_t device, dtype; DeviceTiling tiling; };
  static thread_local std::vector<Entry> cache;
  int32_t device = -1;
  if (aclrtGetDevice(&device) != ACL_SUCCESS)
    throw std::runtime_error("BMM: cannot query current device for case15 tiling");
  for (const auto& e : cache)
    if (e.device == device && e.dtype == dtype) return e.tiling;
  const DeviceTiling t = BuildCase15SplitKTilingUncached(dtype);
  cache.push_back({device, dtype, t});
  return t;
}
inline DeviceTiling BuildWideNSplitTilingUncached(int32_t orgM, int32_t orgN, int32_t orgK,
                         int32_t localM, int32_t localN,
                         int32_t dtype, bool tx1, bool tx2)
{
  auto* platform = platform_ascendc::PlatformAscendCManager::GetInstance();
  if (platform == nullptr) throw std::runtime_error("BMM: runtime platform unavailable");
  const MemoryLimits mem = ReadLimits(*platform);
  const auto inputType = dtype == 1 ? matmul_tiling::DataType::DT_FLOAT16
                   : matmul_tiling::DataType::DT_BF16;
  const int32_t bases[][2] = {{128, 256}, {128, 128}, {64, 256}, {64, 128}};
  for (const auto& base : bases) {
    matmul_tiling::MultiCoreMatmulTiling api(*platform);
    api.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, inputType, tx1);
    api.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, inputType, tx2);
    api.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
          matmul_tiling::DataType::DT_FLOAT);
    api.SetBiasType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
            matmul_tiling::DataType::DT_FLOAT);
    api.SetBias(false);
    api.SetDim(1);
    api.SetOrgShape(orgM, orgN, orgK);
    api.SetShape(localM, localN, orgK);
    api.SetSingleShape(localM, localN, orgK);
    api.SetFixSplit(base[0], base[1], -1);
    api.SetBufferSpace(BufferLimit(mem.l1), BufferLimit(mem.l0c), BufferLimit(mem.ub));
    optiling::TCubeTiling host;
    if (api.GetTiling(host) < 0) continue;
    if (!GeometryFits(host, mem, localM, localN, orgK)) continue;
    DeviceTiling device{};
    if (host.GetDataSize() != sizeof(device)) continue;
    host.SaveToBuffer(&device, sizeof(device));
    return device;
  }
  throw std::runtime_error("BMM: wide-N grouped tiling failed");
}
inline DeviceTiling BuildWideNSplitTiling(int32_t orgM, int32_t orgN, int32_t orgK,
                     int32_t localM, int32_t localN,
                     int32_t dtype, bool tx1, bool tx2)
{
  struct Entry {
    int32_t device, orgM, orgN, orgK, localM, localN, dtype;
    bool tx1, tx2;
    DeviceTiling tiling;
  };
  static thread_local std::vector<Entry> cache;
  int32_t device = -1;
  if (aclrtGetDevice(&device) != ACL_SUCCESS)
    throw std::runtime_error("BMM: cannot query current device for wide-N tiling");
  for (const auto& e : cache) {
    if (e.device == device && e.orgM == orgM && e.orgN == orgN && e.orgK == orgK &&
      e.localM == localM && e.localN == localN && e.dtype == dtype &&
      e.tx1 == tx1 && e.tx2 == tx2) return e.tiling;
  }
  const auto t = BuildWideNSplitTilingUncached(orgM, orgN, orgK, localM, localN,
                         dtype, tx1, tx2);
  cache.push_back({device, orgM, orgN, orgK, localM, localN, dtype, tx1, tx2, t});
  return t;
}
class LaneSum {
public:
  __aicore__ inline void Init(AscendC::TPipe* pipe)
  {
    pipe_ = pipe;
    pipe_->InitBuffer(work_, ACCURATE_SUM_BYTES);
  }
  __aicore__ inline void Run(const AscendC::LocalTensor<float>& dst,
               const AscendC::LocalTensor<float>& src, int32_t count)
  {
    auto acc = work_.Get<float>();
    lanes_ = count >= static_cast<int32_t>(ACCURATE_SUM_LANES)
      ? static_cast<int32_t>(ACCURATE_SUM_LANES) : 64;
    AscendC::Duplicate(acc, 0.0F, lanes_);
    AscendC::PipeBarrier<PIPE_V>();
    for (int32_t offset = 0; offset < count; offset += lanes_) {
      const int32_t valid = count - offset < lanes_ ? count - offset : lanes_;
      AscendC::Add(acc, acc, src[offset], valid);
      AscendC::PipeBarrier<PIPE_V>();
    }
    for (int32_t half = lanes_ / 2; half >= 8; half /= 2) {
      AscendC::Add(acc, acc, acc[half], half);
      AscendC::PipeBarrier<PIPE_V>();
    }
    const auto ready = pipe_->FetchEventID(AscendC::HardEvent::V_S);
    AscendC::SetFlag<AscendC::HardEvent::V_S>(ready);
    AscendC::WaitFlag<AscendC::HardEvent::V_S>(ready);
    float sum = 0.0F;
    for (int32_t lane = 0; lane < 8; ++lane) sum += acc.GetValue(lane);
    const auto scalarReady = pipe_->FetchEventID(AscendC::HardEvent::S_V);
    AscendC::SetFlag<AscendC::HardEvent::S_V>(scalarReady);
    AscendC::WaitFlag<AscendC::HardEvent::S_V>(scalarReady);
    AscendC::Duplicate(dst, sum, 8);
  }
  AscendC::TPipe* pipe_ = nullptr;
  int32_t lanes_ = 0;
  AscendC::TBuf<AscendC::TPosition::VECCALC> work_;
};
template <typename T, bool TX1, bool TX2>
class CubeMaxSum {
  using AType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, T, TX1>;
  using BType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, T, TX2>;
  using CType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float>;
  using BiasType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float>;
public:
  __aicore__ inline AscendC::TPipe* Pipe() { return &pipe_; }
  __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
                int64_t b, int64_t m, int64_t n, int64_t k,
                int64_t blocks, GM_ADDR tiles, DeviceTiling& tiling)
  {
    b_ = b; m_ = m; n_ = n; k_ = k; blocks_ = blocks;
    splits_ = (blocks_ > b_ && blocks_ % b_ == 0) ? blocks_ / b_ : 1;
    bm_ = tiling.baseM; bn_ = tiling.baseN;
    reduceN_ = bn_ < REDUCE_N ? bn_ : REDUCE_N;
    sliceM_ = tiling.singleCoreM;
    paddedM_ = (m_ + bm_ - 1) / bm_ * bm_;
    x1_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1), b * m * k);
    x2_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2), b * k * n);
    y_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y), b);
    const int64_t sliceElements = sliceM_ * n_;
    const int64_t sliceStrideElements = ((sliceElements + 127) / 128) * 128;
    auto* tileBase = reinterpret_cast<__gm__ float*>(tiles);
    cGm_.SetGlobalBuffer(tileBase + AscendC::GetBlockIdx() * sliceStrideElements,
              sliceElements);
    splitSlots_.SetGlobalBuffer(tileBase + blocks * sliceStrideElements,
                  blocks * SPLIT_SLOT_FLOATS);
    const uint32_t tileBytes = bm_ * reduceN_ * sizeof(float);
    const uint32_t rowBytes = paddedM_ * sizeof(float);
    pipe_.InitBuffer(cBuf_, tileBytes);
    pipe_.InitBuffer(tileMaxBuf_, bm_ * sizeof(float));
    pipe_.InitBuffer(rowMaxBuf_, rowBytes);
    pipe_.InitBuffer(scratchBuf_, tileBytes > rowBytes ? tileBytes : rowBytes);
    pipe_.InitBuffer(outBuf_, 32);
    pipe_.InitBuffer(flagBuf_, FLAG_BUF_BYTES);
    laneSum_.Init(&pipe_);
  }
  __aicore__ inline void Process()
  {
    if (splits_ <= 1) {
      for (int64_t batch = AscendC::GetBlockIdx(); batch < b_; batch += blocks_) {
        ComputeRange(batch, 0, m_);
        CopyOut(batch);
      }
      return;
    }
    const int64_t batch = AscendC::GetBlockIdx() / splits_;
    const int64_t split = AscendC::GetBlockIdx() % splits_;
    const int64_t chunk = RowChunk();
    const int64_t mStart = split * chunk;
    const int64_t mEnd = m_ - mStart < chunk ? m_ : mStart + chunk;
    if (mStart >= mEnd) {
      auto zero = outBuf_.Get<float>();
      AscendC::Duplicate(zero, 0.0F, 8);
    } else {
      ComputeRange(batch, mStart, mEnd);
    }
    PublishSplit(AscendC::GetBlockIdx());
    if (split == 0) ReduceSplits(batch);
  }
  __aicore__ inline int64_t RowChunk() const
  {
    const int64_t chunk = (m_ + splits_ - 1) / splits_;
    return (chunk + bm_ - 1) / bm_ * bm_;
  }
private:
  __aicore__ inline void ComputeRange(int64_t batch, int64_t mStart, int64_t mEnd)
  {
    auto rowMax = rowMaxBuf_.Get<float>();
    AscendC::Duplicate(rowMax, NEG_INF, static_cast<int32_t>(mEnd - mStart));
    AscendC::PipeBarrier<PIPE_V>();
    bool bPublished = false;
    for (int64_t slice = mStart; slice < mEnd; slice += sliceM_) {
      const int32_t validM = static_cast<int32_t>(mEnd - slice < sliceM_ ? mEnd - slice : sliceM_);
      mm_.SetTensorA(x1_[batch * m_ * k_ + (TX1 ? slice : slice * k_)], TX1);
      if (!bPublished) {
        mm_.SetTensorB(x2_[batch * k_ * n_], TX2);
        bPublished = true;
      }
      mm_.SetTail(validM, static_cast<int32_t>(n_), static_cast<int32_t>(k_));
      mm_.template IterateAll<true>(cGm_);
      mm_.End();
      for (int64_t row = 0; row < validM; row += bm_) {
        const int32_t mv = static_cast<int32_t>(validM - row < bm_ ? validM - row : bm_);
        for (int64_t n0 = 0; n0 < n_; n0 += reduceN_) {
          const int32_t nv = static_cast<int32_t>(n_ - n0 < reduceN_ ? n_ - n0 : reduceN_);
          const uint32_t paddedN = (nv + 7) / 8 * 8;
          AscendC::DataCopyExtParams copy{static_cast<uint16_t>(mv),
            static_cast<uint32_t>(nv * sizeof(float)),
            static_cast<uint32_t>((n_ - nv) * sizeof(float)),
            static_cast<uint32_t>((reduceN_ - paddedN) / 8), 0};
          AscendC::DataCopyPadExtParams<float> pad{true, 0,
            static_cast<uint8_t>(paddedN - nv), NEG_INF};
          auto c = cBuf_.Get<float>();
          if (paddedN < static_cast<uint32_t>(reduceN_)) {
            AscendC::Duplicate(c, NEG_INF, static_cast<int32_t>(bm_ * reduceN_));
          }
          const auto writable = pipe_.FetchEventID(AscendC::HardEvent::V_MTE2);
          AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(writable);
          AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(writable);
          AscendC::DataCopyPad(c, cGm_[row * n_ + n0], copy, pad);
          const auto ready = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
          AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(ready);
          AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(ready);
          ReduceTile(c, mv, slice - mStart + row);
        }
      }
    }
    auto out = outBuf_.Get<float>();
    laneSum_.Run(out, rowMax, static_cast<int32_t>(mEnd - mStart));
  }
  __aicore__ inline void ReduceTile(const AscendC::LocalTensor<float>& tile, int32_t mv,
                   int64_t mRow)
  {
    auto tileMax = tileMaxBuf_.Get<float>();
    auto rowMax = rowMaxBuf_.Get<float>();
    auto tmpBytes = scratchBuf_.Get<uint8_t>();
    uint32_t shape[2] = {static_cast<uint32_t>(mv), static_cast<uint32_t>(reduceN_)};
    AscendC::ReduceMax<float, AscendC::Pattern::Reduce::AR, true>(
      tileMax, tile, tmpBytes, shape, true);
    AscendC::PipeBarrier<PIPE_V>();
    AscendC::Max(rowMax[mRow], rowMax[mRow], tileMax, mv);
    AscendC::PipeBarrier<PIPE_V>();
  }
  __aicore__ inline void BeginStore()
  {
    const auto event = pipe_.FetchEventID(AscendC::HardEvent::V_MTE3);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(event);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(event);
  }
  __aicore__ inline void EndStore()
  {
    const auto done = pipe_.FetchEventID(AscendC::HardEvent::MTE3_V);
    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(done);
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(done);
  }
  __aicore__ inline void CopyOut(int64_t batch)
  {
    BeginStore();
    AscendC::DataCopyExtParams copy{1, sizeof(float), 0, 0, 0};
    AscendC::DataCopyPad(y_[batch], outBuf_.Get<float>(), copy);
    EndStore();
  }
  __aicore__ inline void PublishSplit(int64_t index)
  {
    const int64_t slot = index * static_cast<int64_t>(SPLIT_SLOT_FLOATS);
    BeginStore();
    AscendC::DataCopyExtParams one{1, sizeof(float), 0, 0, 0};
    AscendC::DataCopyPad(splitSlots_[slot], outBuf_.Get<float>(), one);
    auto flag = flagBuf_.Get<float>();
    AscendC::Duplicate(flag, SPLIT_READY, 8);
    AscendC::DataCopyPad(splitSlots_[slot + 1], flag, one);
    EndStore();
  }
  __aicore__ inline AscendC::DataCopyExtParams SplitGatherParams() const
  {
    return AscendC::DataCopyExtParams{
      static_cast<uint16_t>(splits_), sizeof(float),
      SPLIT_SLOT_BYTES - sizeof(float), 0, 0};
  }
  __aicore__ inline void ReduceSplits(int64_t batch)
  {
    const int64_t batchBase = batch * splits_ * static_cast<int64_t>(SPLIT_SLOT_FLOATS);
    const auto gather = SplitGatherParams();
    AscendC::DataCopyPadExtParams<float> pad{};
    auto flags = flagBuf_.Get<float>();
    for (int32_t attempt = 0; attempt < SPLIT_POLL_LIMIT; ++attempt) {
      AscendC::DataCopyPad(flags, splitSlots_[batchBase + 1], gather, pad);
      SyncCopyToScalar();
      bool ready = true;
      for (int32_t peer = 0; peer < splits_; ++peer) {
        if (flags.GetValue(peer * SPLIT_UB_SLOT_FLOATS) != SPLIT_READY) {
          ready = false;
          break;
        }
      }
      if (ready) break;
    }
    auto partials = scratchBuf_.Get<float>();
    AscendC::DataCopyPad(partials, splitSlots_[batchBase], gather, pad);
    SyncCopyToScalar();
    float total = 0.0F;
    for (int32_t peer = 0; peer < splits_; ++peer)
      total += partials.GetValue(peer * SPLIT_UB_SLOT_FLOATS);
    const auto scalarReady = pipe_.FetchEventID(AscendC::HardEvent::S_V);
    AscendC::SetFlag<AscendC::HardEvent::S_V>(scalarReady);
    AscendC::WaitFlag<AscendC::HardEvent::S_V>(scalarReady);
    AscendC::Duplicate(outBuf_.Get<float>(), total, 8);
    CopyOut(batch);
    AscendC::Duplicate(flags, 0.0F, static_cast<int32_t>(splits_ * SPLIT_UB_SLOT_FLOATS));
    BeginStore();
    AscendC::DataCopyExtParams clear{
      static_cast<uint16_t>(splits_), sizeof(float), 0,
      SPLIT_SLOT_BYTES - sizeof(float), 0};
    AscendC::DataCopyPad(splitSlots_[batchBase + 1], flags, clear);
    EndStore();
  }
  __aicore__ inline void SyncCopyToScalar()
  {
    const auto ready = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(ready);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(ready);
    const auto scalar = pipe_.FetchEventID(AscendC::HardEvent::V_S);
    AscendC::SetFlag<AscendC::HardEvent::V_S>(scalar);
    AscendC::WaitFlag<AscendC::HardEvent::V_S>(scalar);
  }
  __aicore__ inline void SyncCopyToVector()
  {
    const auto ready = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(ready);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(ready);
  }
  int64_t b_, m_, n_, k_, blocks_, splits_, bm_, bn_, reduceN_, paddedM_, sliceM_;
  AscendC::TPipe pipe_;
  AscendC::TBuf<AscendC::TPosition::VECIN> cBuf_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> tileMaxBuf_, rowMaxBuf_, scratchBuf_;
  AscendC::TBuf<AscendC::TPosition::VECOUT> outBuf_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> nonceOut_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> flagBuf_;
  LaneSum laneSum_;
public:
  AscendC::Matmul<AType, BType, CType, BiasType> mm_;
private:
  AscendC::GlobalTensor<T> x1_, x2_;
  AscendC::GlobalTensor<float> y_, cGm_, splitSlots_;
};
constexpr int32_t CASE2_M = 3;
constexpr int32_t CASE2_N = 5;
constexpr int32_t CASE2_K = 40;
template <typename T, int32_t K>
class VectorLeanDot {
public:
  __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y)
  {
    x1_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1), K);
    x2_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2), K);
    y_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y), 2048);
    pipe_.InitBuffer(oneBuf_, 4096);
  }
  __aicore__ inline void Process()
  {
    auto one8 = oneBuf_.Get<uint8_t>();
    auto a = one8.ReinterpretCast<T>();
    auto b = one8[K * sizeof(T)].ReinterpretCast<T>();
    auto a32 = one8[2 * K * sizeof(T)].ReinterpretCast<float>();
    auto b32 = one8[2 * K * sizeof(T) + K * sizeof(float)].ReinterpretCast<float>();
    auto prod = one8[2 * K * sizeof(T) + 2 * K * sizeof(float)].ReinterpretCast<float>();
    auto reduceTmp = one8[2 * K * sizeof(T) + 3 * K * sizeof(float)].ReinterpretCast<float>();
    auto out = one8[2 * K * sizeof(T) + 3 * K * sizeof(float) + SHORT_REDUCE_TMP_BYTES].ReinterpretCast<float>();
    const AscendC::DataCopyExtParams copy{1, static_cast<uint32_t>(K * sizeof(T)), 0, 0, 0};
    const AscendC::DataCopyPadExtParams<T> pad{};
    AscendC::DataCopyPad(a, x1_[0], copy, pad);
    AscendC::DataCopyPad(b, x2_[0], copy, pad);
    const auto loaded = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(loaded);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(loaded);
    if constexpr (std::is_same<T, half>::value) {
      float acc = 0.0F;
      for (int32_t k = 0; k < K; ++k)
        acc += static_cast<float>(a.GetValue(k)) *
           static_cast<float>(b.GetValue(k));
      y_.SetValue(0, acc);
    } else {
      AscendC::Cast(a32, a, AscendC::RoundMode::CAST_NONE, K);
      AscendC::Cast(b32, b, AscendC::RoundMode::CAST_NONE, K);
      AscendC::Mul(prod, a32, b32, K);
      AscendC::ReduceSum<float>(out, prod, reduceTmp, K);
      const auto toStore = pipe_.FetchEventID(AscendC::HardEvent::V_MTE3);
      AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(toStore);
      AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(toStore);
      const AscendC::DataCopyExtParams one{1, sizeof(float), 0, 0, 0};
      AscendC::DataCopyPad(y_[0], out, one);
    }
  }
private:
  __aicore__ inline void Store(const AscendC::LocalTensor<float>& out)
  {
    const auto toStore = pipe_.FetchEventID(AscendC::HardEvent::V_MTE3);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(toStore);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(toStore);
    const AscendC::DataCopyExtParams one{1, sizeof(float), 0, 0, 0};
    AscendC::DataCopyPad(y_[0], out, one);
    const auto stored = pipe_.FetchEventID(AscendC::HardEvent::MTE3_V);
    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(stored);
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(stored);
  }
  AscendC::TPipe pipe_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> oneBuf_;
  AscendC::TBuf<AscendC::TPosition::VECOUT> outBuf_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> nonceOut_;
  AscendC::GlobalTensor<T> x1_, x2_;
  AscendC::GlobalTensor<float> y_;
};
template <typename T, int32_t K>
class VectorLeanDotTuned {
public:
  __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y)
  {
    x1_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1), K);
    x2_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2), K);
    y_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y), 2048);
    pipe_.InitBuffer(rawBuf_, 2 * K * sizeof(T));
    pipe_.InitBuffer(calcBuf_, (2 * K + K + 16) * sizeof(float));
    pipe_.InitBuffer(outBuf_, 32);
  }
  __aicore__ inline void Process()
  {
    auto raw = rawBuf_.Get<T>();
    const AscendC::DataCopyExtParams copy{1, static_cast<uint32_t>(K * sizeof(T)), 0, 0, 0};
    const AscendC::DataCopyPadExtParams<T> pad{};
    AscendC::DataCopyPad(raw, x1_[0], copy, pad);
    AscendC::DataCopyPad(raw[K], x2_[0], copy, pad);
    const auto loaded = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(loaded);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(loaded);
    AscendC::LocalTensor<float> raw32 = calcBuf_.Get<float>();
    AscendC::LocalTensor<float> prod = raw32[2 * K];
    AscendC::LocalTensor<float> reduceTmp = raw32[3 * K];
    AscendC::Cast(raw32, raw, AscendC::RoundMode::CAST_NONE, 2 * K);
    AscendC::PipeBarrier<PIPE_V>();
    AscendC::Mul(prod, raw32, raw32[K], K);
    AscendC::PipeBarrier<PIPE_V>();
    AscendC::ReduceSum<float>(outBuf_.Get<float>(), prod, reduceTmp, K);
    AscendC::PipeBarrier<PIPE_V>();
    const auto toStore = pipe_.FetchEventID(AscendC::HardEvent::V_MTE3);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(toStore);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(toStore);
    const AscendC::DataCopyExtParams one{1, sizeof(float), 0, 0, 0};
    AscendC::DataCopyPad(y_[0], outBuf_.Get<float>(), one);
  }
private:
  AscendC::TPipe pipe_;
  AscendC::TBuf<AscendC::TPosition::VECIN> rawBuf_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> calcBuf_;
  AscendC::TBuf<AscendC::TPosition::VECOUT> outBuf_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> nonceOut_;
  AscendC::GlobalTensor<T> x1_, x2_;
  AscendC::GlobalTensor<float> y_;
};
template <typename T, int32_t M, int32_t N, int32_t K, int32_t NP>
class VectorCase3Rep {
  static_assert(NP >= N && NP % 8 == 0, "row pad must cover N and keep rows 32B aligned");
  static_assert((K * sizeof(float)) % 32 == 0, "K row must be 32B aligned in fp32");
  static_assert(N <= 64, "lane mask is a single 64-bit word");
  static constexpr uint32_t ROWB = K * sizeof(float) / 32;
  static constexpr uint32_t PADB = NP * sizeof(float) / 32;
  static constexpr uint32_t UB_RAW = 0;
  static constexpr uint32_t UB_A32 = 2048;
  static constexpr uint32_t UB_B32 = 3392;
  static constexpr uint32_t UB_PROD = 8192;
  static constexpr uint32_t UB_C = 32768;
  static constexpr uint32_t UB_RMAX = 34816;
  static constexpr uint32_t UB_OUT = 35840;
public:
  __aicore__ inline void Process(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, int64_t b,
                 int64_t blocks)
  {
    AscendC::GlobalTensor<T> x1g, x2g;
    AscendC::GlobalTensor<float> yg;
    x1g.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1), b * M * K);
    x2g.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2), b * N * K);
    yg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y), b);
    AscendC::LocalTensor<T> raw(AscendC::TPosition::VECIN, UB_RAW, (M + N) * K);
    AscendC::LocalTensor<float> a32(AscendC::TPosition::VECCALC, UB_A32, M * K);
    AscendC::LocalTensor<float> b32(AscendC::TPosition::VECCALC, UB_B32, NP * K);
    AscendC::LocalTensor<float> prod(AscendC::TPosition::VECCALC, UB_PROD, M * NP * K);
    AscendC::LocalTensor<float> c(AscendC::TPosition::VECCALC, UB_C, 256);
    AscendC::LocalTensor<float> rowMax(AscendC::TPosition::VECCALC, UB_RMAX, 64);
    AscendC::LocalTensor<float> out(AscendC::TPosition::VECOUT, UB_OUT, 64);
    for (int64_t batch = AscendC::GetBlockIdx(); batch < b; batch += blocks) {
      const AscendC::DataCopyExtParams copyA{
        1, static_cast<uint32_t>(M * K * sizeof(T)), 0, 0, 0};
      const AscendC::DataCopyExtParams copyB{
        1, static_cast<uint32_t>(N * K * sizeof(T)), 0, 0, 0};
      const AscendC::DataCopyPadExtParams<T> pad{};
      AscendC::DataCopyPad(raw, x1g[batch * M * K], copyA, pad);
      AscendC::DataCopyPad(raw[M * K], x2g[batch * N * K], copyB, pad);
      AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(0);
      AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(0);
      AscendC::Cast(a32, raw, AscendC::RoundMode::CAST_NONE, (M + N) * K);
      AscendC::Duplicate(b32[N * K], 0.0F, (NP - N) * K + 64);
      const AscendC::BinaryRepeatParams rp(1, 1, 1, ROWB, 0, ROWB);
      for (int32_t m = 0; m < M; ++m)
        AscendC::Mul(prod[m * NP * K], a32[m * K], b32,
              static_cast<uint64_t>(K), static_cast<uint8_t>(NP), rp);
      AscendC::WholeReduceSum<float>(c, prod, static_cast<int32_t>(K),
                     static_cast<int32_t>(M * NP), 1, 1, ROWB);
      const uint64_t nmask[2] = {(1ULL << N) - 1ULL, 0ULL};
      AscendC::WholeReduceMax<float>(rowMax, c, nmask, static_cast<int32_t>(M),
                     1, 1, PADB,
                     AscendC::ReduceOrder::ORDER_ONLY_VALUE);
      AscendC::WholeReduceSum<float>(out, rowMax, static_cast<int32_t>(M),
                     1, 1, 1, 1);
      AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(0);
      AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(0);
      const AscendC::DataCopyExtParams one{1, sizeof(float), 0, 0, 0};
      AscendC::DataCopyPad(yg[batch], out, one);
    }
  }
};
template <typename T, int32_t M, int32_t N, int32_t K, int32_t SPLITS>
class VectorCase4Quad {
  static_assert(N % SPLITS == 0, "n groups must divide N");
  static_assert(K * M % 128 == 0, "stride fold needs {K,M} M-aligned");
public:
  __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR slots,
                int64_t b)
  {
    const int32_t chunk = static_cast<int32_t>(AscendC::GetBlockIdx());
    chunk_ = chunk;
    batch_ = chunk / SPLITS;
    col_ = chunk % SPLITS;
    b_ = static_cast<int32_t>(b);
    x1_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1), b * K * M);
    x2_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2), b * N * K);
    y_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y), b);
    splitSlots_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(slots),
                  b * SPLITS * SPLIT_SLOT_FLOATS);
    pipe_.InitBuffer(aRaw_, K * M * sizeof(T));
    pipe_.InitBuffer(bRaw_, N * K * sizeof(T));
    pipe_.InitBuffer(a32_, K * M * sizeof(float));
    pipe_.InitBuffer(b32_, N * K * sizeof(float));
    pipe_.InitBuffer(bBcast_, K * M * sizeof(float));
    pipe_.InitBuffer(prod_, K * M * sizeof(float));
    pipe_.InitBuffer(t1_, K * M * sizeof(float));
    pipe_.InitBuffer(t2_, K * M * sizeof(float));
    pipe_.InitBuffer(rowMax_, M * sizeof(float));
    pipe_.InitBuffer(reduceTmp_, SHORT_REDUCE_TMP_BYTES);
    pipe_.InitBuffer(out_, 32);
    pipe_.InitBuffer(flagBuf_, SPLITS * SPLIT_UB_SLOT_FLOATS * sizeof(float));
    pipe_.InitBuffer(gatherBuf_, SPLITS * SPLIT_UB_SLOT_FLOATS * sizeof(float));
  }
  __aicore__ inline void Process()
  {
    if (chunk_ >= b_ * SPLITS) return;
    ClearReadyFlag(chunk_);
    ComputeGroup();
    PublishSplit(chunk_);
    if (col_ == 0) {
      FoldSplits(batch_);
    }
  }
  __aicore__ inline void ClearReadyFlag(int32_t chunk)
  {
    auto flag = flagBuf_.Get<float>();
    AscendC::Duplicate(flag, 0.0F, 8);
    const auto v2m3 = pipe_.FetchEventID(AscendC::HardEvent::V_MTE3);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(v2m3);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(v2m3);
    const int64_t slot = chunk * static_cast<int64_t>(SPLIT_SLOT_FLOATS);
    AscendC::DataCopyExtParams one{1, sizeof(float), 0, 0, 0};
    AscendC::DataCopyPad(splitSlots_[slot + M], flag, one);
    const auto done = pipe_.FetchEventID(AscendC::HardEvent::MTE3_V);
    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(done);
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(done);
  }
private:
  __aicore__ inline void ComputeGroup()
  {
    auto aRaw = aRaw_.Get<T>();
    auto bRaw = bRaw_.Get<T>();
    const AscendC::DataCopyExtParams copyA{
      1, static_cast<uint32_t>(K * M * sizeof(T)), 0, 0, 0};
    const AscendC::DataCopyExtParams copyB{
      1, static_cast<uint32_t>(N * K * sizeof(T)), 0, 0, 0};
    const AscendC::DataCopyPadExtParams<T> pad{};
    AscendC::DataCopyPad(aRaw, x1_[batch_ * K * M], copyA, pad);
    AscendC::DataCopyPad(bRaw, x2_[batch_ * N * K], copyB, pad);
    const auto loaded = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(loaded);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(loaded);
    auto a32 = a32_.Get<float>();
    auto b32 = b32_.Get<float>();
    AscendC::Cast(a32, aRaw, AscendC::RoundMode::CAST_NONE, K * M);
    AscendC::Cast(b32, bRaw, AscendC::RoundMode::CAST_NONE, N * K);
    AscendC::PipeBarrier<PIPE_V>();
    auto bBcast = bBcast_.Get<float>();
    auto prod = prod_.Get<float>();
    auto t1 = t1_.Get<float>();
    auto t2 = t2_.Get<float>();
    auto rowMax = rowMax_.Get<float>();
    const uint32_t bDst[2] = {static_cast<uint32_t>(K),
                 static_cast<uint32_t>(M)};
    const uint32_t bSrc[2] = {static_cast<uint32_t>(K), 1};
    AscendC::Duplicate(rowMax, NEG_INF, M);
    AscendC::PipeBarrier<PIPE_V>();
    const int32_t n0 = col_ * (N / SPLITS);
    for (int32_t n = n0; n < n0 + N / SPLITS; ++n) {
      AscendC::Broadcast<float, 2, 1>(bBcast, b32[n * K], bDst, bSrc);
      AscendC::PipeBarrier<PIPE_V>();
      AscendC::Mul(prod, a32, bBcast, K * M);
      AscendC::PipeBarrier<PIPE_V>();
      AscendC::Add(t1, prod, prod[K * M / 2], K * M / 2);
      AscendC::Add(t2, t1, t1[K * M / 4], K * M / 4);
      AscendC::Add(t1, t2, t2[K * M / 8], K * M / 8);
      AscendC::Add(t2, t1, t1[K * M / 16], K * M / 16);
      AscendC::Add(t1, t2, t2[K * M / 32], K * M / 32);
      AscendC::Add(t2, t1, t1[K * M / 64], K * M / 64);
      AscendC::Add(prod, t2, t2[K * M / 128], K * M / 128);
      AscendC::PipeBarrier<PIPE_V>();
      AscendC::Max(rowMax, rowMax, prod, M);
      AscendC::PipeBarrier<PIPE_V>();
    }
  }
  __aicore__ inline void PublishSplit(int32_t chunk)
  {
    const int64_t slot = chunk * static_cast<int64_t>(SPLIT_SLOT_FLOATS);
    const auto v2m3 = pipe_.FetchEventID(AscendC::HardEvent::V_MTE3);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(v2m3);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(v2m3);
    AscendC::DataCopyExtParams dots{1, M * sizeof(float), 0, 0, 0};
    AscendC::DataCopyPad(splitSlots_[slot], rowMax_.Get<float>(), dots);
    auto flag = flagBuf_.Get<float>();
    AscendC::Duplicate(flag, SPLIT_READY, 8);
    const auto v2m3b = pipe_.FetchEventID(AscendC::HardEvent::V_MTE3);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(v2m3b);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(v2m3b);
    AscendC::DataCopyExtParams one{1, sizeof(float), 0, 0, 0};
    AscendC::DataCopyPad(splitSlots_[slot + M], flag, one);
    const auto done = pipe_.FetchEventID(AscendC::HardEvent::MTE3_V);
    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(done);
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(done);
  }
  __aicore__ inline void FoldSplits(int32_t batch)
  {
    const int64_t batchBase =
      batch * SPLITS * static_cast<int64_t>(SPLIT_SLOT_FLOATS);
    auto flags = flagBuf_.Get<float>();
    auto partials = gatherBuf_.Get<float>();
    AscendC::DataCopyPadExtParams<float> pad{};
    const AscendC::DataCopyExtParams flagGather{
      static_cast<uint16_t>(SPLITS), sizeof(float),
      SPLIT_SLOT_BYTES - sizeof(float), 0, 0};
    bool ready = false;
    for (int32_t attempt = 0; attempt < SPLIT_POLL_LIMIT && !ready; ++attempt) {
      AscendC::DataCopyPad(flags, splitSlots_[batchBase + M], flagGather, pad);
      const auto m2v = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
      AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(m2v);
      AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(m2v);
      const auto v2s = pipe_.FetchEventID(AscendC::HardEvent::V_S);
      AscendC::SetFlag<AscendC::HardEvent::V_S>(v2s);
      AscendC::WaitFlag<AscendC::HardEvent::V_S>(v2s);
      ready = true;
      for (int32_t peer = 0; peer < SPLITS; ++peer) {
        if (flags.GetValue(peer * SPLIT_UB_SLOT_FLOATS) != SPLIT_READY) {
          ready = false;
          break;
        }
      }
    }
    if (!ready) return;
    const AscendC::DataCopyExtParams dotsGather{
      static_cast<uint16_t>(SPLITS), M * sizeof(float),
      SPLIT_SLOT_BYTES - M * sizeof(float), 0, 0};
    AscendC::DataCopyPad(partials, splitSlots_[batchBase], dotsGather, pad);
    const auto m2v = pipe_.FetchEventID(AscendC::HardEvent::MTE2_V);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(m2v);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(m2v);
    auto rowMax = rowMax_.Get<float>();
    auto reduceTmp = reduceTmp_.Get<float>();
    auto out = out_.Get<float>();
    for (int32_t peer = 1; peer < SPLITS; ++peer) {
      AscendC::Max(rowMax, rowMax, partials[peer * SPLIT_UB_SLOT_FLOATS], M);
      AscendC::PipeBarrier<PIPE_V>();
    }
    AscendC::ReduceSum<float>(out, rowMax, reduceTmp, M);
    AscendC::PipeBarrier<PIPE_V>();
    const auto toStore = pipe_.FetchEventID(AscendC::HardEvent::V_MTE3);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(toStore);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(toStore);
    const AscendC::DataCopyExtParams one{1, sizeof(float), 0, 0, 0};
    AscendC::DataCopyPad(y_[batch], out, one);
    const auto stored = pipe_.FetchEventID(AscendC::HardEvent::MTE3_V);
    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(stored);
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(stored);
  }
  int32_t chunk_, batch_, col_, b_;
  AscendC::TPipe pipe_;
  AscendC::TBuf<AscendC::TPosition::VECIN> aRaw_, bRaw_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> a32_, b32_, bBcast_, prod_, t1_, t2_,
                        rowMax_, reduceTmp_, flagBuf_, gatherBuf_;
  AscendC::TBuf<AscendC::TPosition::VECOUT> out_;
  AscendC::GlobalTensor<T> x1_, x2_;
  AscendC::GlobalTensor<float> y_;
  AscendC::GlobalTensor<float> splitSlots_;
};
constexpr int32_t CASE14_M = 64;
